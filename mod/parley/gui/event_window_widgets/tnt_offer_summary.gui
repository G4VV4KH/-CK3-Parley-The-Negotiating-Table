					visible = "[TntOn('tnt_ob_relig')]"
					layoutpolicy_horizontal = expanding
					autoresize = yes
					max_width = 458
					align = nobaseline|left
					default_format = "#weak"
					fontsize_min = 12
					using = Font_Size_Small
					text = "religious_protection_tt"
				}

				text_multi = {
					name = "tnt_offer_row_ob_council"
					visible = "[TntOn('tnt_ob_council')]"
					layoutpolicy_horizontal = expanding
					autoresize = yes
					max_width = 458
					align = nobaseline|left
					default_format = "#weak"
					fontsize_min = 12
					using = Font_Size_Small
					text = "tnt_ob_tt_council"
				}

				text_multi = {
					name = "tnt_offer_row_ob_revoke"
					visible = "[TntOn('tnt_ob_revoke')]"
					layoutpolicy_horizontal = expanding
					autoresize = yes
					max_width = 458
					align = nobaseline|left
					default_format = "#weak"
					fontsize_min = 12
					using = Font_Size_Small
					text = "tnt_ob_tt_revoke"
				}

				text_multi = {
					name = "tnt_offer_row_ob_war"
					visible = "[TntOn('tnt_ob_war')]"
					layoutpolicy_horizontal = expanding
					autoresize = yes
					max_width = 458
					align = nobaseline|left
					default_format = "#weak"
					fontsize_min = 12
					using = Font_Size_Small
