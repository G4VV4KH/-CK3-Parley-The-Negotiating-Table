		### --- he offers himself, or his child -------------------------------------
		text_multi = {
			name = "tnt_offer_row_vassal_r"
			visible = "[TntOn('tnt_vassal_r')]"
			layoutpolicy_horizontal = expanding
			autoresize = yes
			max_width = 470
			align = nobaseline|left
			fontsize_min = 12
			text = "tnt_ai_offer_row_vassal_r"
		}

		### --- he asks to be unbound (A17) -----------------------------------------
		### V13 USER ITEM 2. It reads as the opposite of the line above and belongs
		### against it, so the player sees fealty and its undoing in one place.
		### THE SIDE IS _p AND ONLY _p, and that is a property of the candidate pool
		### rather than a choice: the composer's three sources are neighbouring
		### top-liege realm owners, the proposer's own liege, and a fellow vassal
		### under one top liege - so the PLAYER'S LIEGE CAN NEVER BE A PROPOSER, and
		### tnt_indep_r (a liege offering to free the player) is unreachable, not
		### refused. It stays available in the counter-offer window.
		text_multi = {
			name = "tnt_offer_row_indep_p"
			visible = "[TntOn('tnt_indep_p')]"
			layoutpolicy_horizontal = expanding
			autoresize = yes
			max_width = 470
			align = nobaseline|left
			fontsize_min = 12
			text = "tnt_ai_offer_row_indep_p"
		}

		### --- the contract he would have written (A20) ---------------------------
		### V13 USER ITEM 2. A20 kneels ON TERMS: it writes tnt_vassal_r AND fills
		### the obligation sheet, so the letter must print both or the player agrees
		### to a fealty whose conditions he was never shown.
		###
		### THE HEAD'S GATE IS THE PAIR, not the sheet alone. tnt_ob_changed_value
		### counts how many of the nine rows differ from the contract a plain fealty
		### produces, and it had NO READER until this block - its own header in
		### common\script_values\tnt_55_hc_values.txt:1078-1088 says so in its own
		### hand ("UNREFERENCED, KEPT ON PURPOSE ... Nobody has pointed a widget at
		### it yet"). Pairing it with tnt_vassal_r is not belt-and-braces: the nine
		### variables price at exactly 0 and apply nothing without a fealty term, so
		### a sheet with no fealty leg is not a contract and must not be announced as
		### one.
		###
		### THE LINES ARE THE SHIPPED OBLIGATION KEYS - three of them vanilla's own
		### (GAME\localization\english\gui\specialinteractions_l_english.yml:70, :71,
		### :75), the rest this mod's tnt_ob_tt_* - so the letter and the apply leg's
		### own tooltip ladder speak in one voice and no new loc key is invented here.
		###
		### TAX AND LEVY ARE LEVELS, NOT FLAGS. TntOn would be true for level 0 as
		### well (level 0 is the TAX-EXEMPT contract, a bigger concession, not
		### "nothing"), so they are tested with EqualTo_CFixedPoint against the
		### literal 1 - the composer writes no other level - which is the contract
		### panel's own form (gui\tnt_panel_contract.gui:1301-1325). The other seven
		### rows are genuine 0/1 rights and TntOn is exact for them.
		vbox = {
			name = "tnt_offer_list_contract"
			layoutpolicy_horizontal = expanding
			spacing = 1
			visible = "[And( TntOn('tnt_vassal_r'), TntPos('tnt_ob_changed_value') )]"

			text_multi = {
				name = "tnt_offer_row_contract"
				layoutpolicy_horizontal = expanding
				autoresize = yes
				max_width = 470
				align = nobaseline|left
				fontsize_min = 12
				text = "tnt_ai_offer_row_contract"
			}

			### The indent is the object groups' own margin_left = 12, so a detail
			### line under a head reads the same everywhere in this letter.
			###
			### ignoreinvisible IS STATED HERE and not left to the root widget's
			### copy: it is a per-container property, not an inherited one, and this
			### is the only new container in this file whose children are all
			### conditional - nine rows of which a letter shows three or four. Every
			### sibling group type in this mod that holds conditional children states
			### it the same way (gui\tnt_panel_multiselect.gui's sheet groups,
			### gui\tnt_diplomacy_window.gui's tnt_mutual_block). Without it a
			### four-row contract would still be nine rows tall.
			vbox = {
				name = "tnt_offer_contract_lines"
				layoutpolicy_horizontal = expanding
				spacing = 1
				margin_left = 12
				ignoreinvisible = yes

				### 458 AND NOT 470 ON ALL NINE: this vbox indents them by
				### margin_left = 12, so their slot is 12 px narrower than a
				### top-level row's. These lines are the tightest in the letter -
				### the tnt_ob_tt_* sentences render at about 70 characters in
				### Russian against a 465 px slot - which is why they wrap rather
				### than trusting a translation to stay short.
				text_multi = {
					name = "tnt_offer_row_ob_tax"
					visible = "[EqualTo_CFixedPoint( TntNum('tnt_ob_tax'), '(CFixedPoint)1' )]"
					layoutpolicy_horizontal = expanding
					autoresize = yes
					max_width = 458
					align = nobaseline|left
					default_format = "#weak"
					fontsize_min = 12
					using = Font_Size_Small
					text = "low_obligations_taxes"
				}

				text_multi = {
					name = "tnt_offer_row_ob_levy"
					visible = "[EqualTo_CFixedPoint( TntNum('tnt_ob_levy'), '(CFixedPoint)1' )]"
					layoutpolicy_horizontal = expanding
					autoresize = yes
					max_width = 458
					align = nobaseline|left
					default_format = "#weak"
					fontsize_min = 12
					using = Font_Size_Small
					text = "low_obligations_levies"
				}

				text_multi = {
