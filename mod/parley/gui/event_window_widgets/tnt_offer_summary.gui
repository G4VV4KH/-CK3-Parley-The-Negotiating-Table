		vbox = {
			name = "tnt_offer_list_artifact_r"
			layoutpolicy_horizontal = expanding
			spacing = 1
			visible = "[TntPos('tnt_count_sel_artifact_r_value')]"

			text_multi = {
				name = "tnt_offer_row_artifact_r"
				layoutpolicy_horizontal = expanding
				autoresize = yes
				max_width = 470
				align = nobaseline|left
				fontsize_min = 12
				text = "tnt_ai_offer_row_artifact_r"
			}

			scrollbox = {
				name = "tnt_offer_scroll_artifact_r"
				layoutpolicy_horizontal = expanding
				autoresizescrollarea = yes
				size = { 0 0 }
				maximumsize = { -1 124 }

				blockoverride "scrollbox_margins"
				{
					margin_left = 12
					margin_right = 26
					margin_top = 0
					margin_bottom = 0
				}

				blockoverride "scrollbox_empty"
				{
					visible = no
				}

				blockoverride "scrollbox_content"
				{
					vbox = {
						name = "tnt_offer_objects_artifact_r"
						layoutpolicy_horizontal = expanding
						spacing = 1
						datamodel = "[TntList('tnt_sel_artifact_r')]"

						item = {
							hbox = {
								name = "tnt_offer_object_artifact_r"
								datacontext = "[Scope.Artifact]"
								layoutpolicy_horizontal = expanding
								size = { 0 24 }
								maximumsize = { -1 24 }
								spacing = 6
								margin = { 2 2 }

								### The real artifact icon, exactly as the picker
								### rows draw it (texture + frame + framesize 240,
								### tnt_panel_multiselect.gui tnt_multi_row_artifact),
								### only 18 px.
								widget = {
									name = "tnt_offer_object_artifact_r_icon_holder"
									size = { 20 100% }
									alwaystransparent = yes

									icon = {
