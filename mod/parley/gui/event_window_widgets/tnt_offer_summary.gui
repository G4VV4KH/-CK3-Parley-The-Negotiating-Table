######################################################################
### PARLEY: THE NEGOTIATING TABLE - THE AI'S OFFER, WEIGHED ON OUR OWN SCALES
###
### Embedded into tnt_ai_offer.0002 (events/tnt_ai_events.txt) by ONE line:
###     widget = { gui = "tnt_offer_summary" container = "custom_widgets_container" }
### 43-ai-participation.md 3.A.4 ruling A-1; 30-V2-DESIGN 6.3 phase AI-1;
### risk R-13.
###
### THE FILE NAME IS THE WIDGET NAME. GAME\events\_events.info:247-251: "GUI
### files must be placed at the event_window_widgets path (see paths.settings).
### The name of the file must match the widget name." The path is registered by
### the base game at GAME\paths_checksummed.settings:3
###     event_window_widgets = "gui/event_window_widgets"
### so this file needs NO entry in gui/scripted_widgets/ - unlike
### tnt_diplomacy_window.gui, which does. Nothing in
### GAME\gui\event_window_widgets\ is shadowed: no vanilla file is called
### tnt_offer_summary.gui.
###
### THE ROOT ELEMENT MUST BE A vbox, NOT A window.
### The decisive precedent is the whole reason Option A won:
###   GAME\gui\event_window_widgets\child_examination_success_chance.gui:1
### - a controller-less, mod-copyable event widget whose root element is a vbox,
### embedded by a one-liner at
###   GAME\events\dlc\tgp\tgp_china_decision_events.txt:92.
### 555 of the 685 embedded widgets in GAME\events have no controller at all.
### Writing `window = { }` here is failure mode 5 of 43-...md 3.A.9.
###
### WHY THIS WIDGET CAN BE THIS SHORT.
### The AI's package lives on THE PLAYER, in the same variables the negotiation
### window edits, so every macro in data_binding/tnt_macros.txt already points at
### the right character. No datacontext plumbing, no scopes, nothing new:
###   TntSV        -> GetPlayer.MakeScope.ScriptValue(V)
###   TntNum       -> GetPlayer.MakeScope.Var(V).GetValue
###   TntOn        -> that variable is above zero
###   TntBreakdown -> GuiScope.SetRoot( GetPlayer.MakeScope ).GetScriptValueBreakdown(V)
###   TntPos / TntNeg -> a named value against zero
###   TntVar       -> GetPlayer.MakeScope.Var(V)      (the hostage row's character)
###   TntList      -> GetPlayer.MakeScope.GetList(V)  (user item 2's object lists)
### and every one of the seven is ALREADY SHIPPED AND RUNNING in
### gui/tnt_types.gui and gui/tnt_panel_multiselect.gui. This widget is a fifth
### rendering of the same number the window shows, not a second implementation
### of it.
###
### DELIBERATELY NO tnt_ TYPE IS INSTANTIATED HERE, even though tnt_types.gui
### defines a perfectly good tnt_balance_scales. Two reasons: this file must not
### depend on a file another author is rebuilding for items 3.2/3.3/3.4 in the
### same build, and an event widget that fails to resolve a type renders as
### nothing at all with no error the player can see. Everything below is either
### an engine base type (vbox, hbox, icon, expand), a vanilla shared type used
### by the exemplar itself (text_single, divider_light), or - since user item 2
### put the object lists into the letter - a vanilla shared type this mod
### already ships elsewhere, re-verified on disk for this file:
###   scrollbox                    GAME\gui\shared\lists.gui:3185
###   portrait_head_tiny           GAME\gui\window_ledger.gui:6867-6869
###                                (natively 64x64, so it is NEVER instantiated
###                                 here without an explicit size - user item 4)
###   container_character_tooltip  GAME\gui\cooltip.gui:1340, used exactly this
###                                way at GAME\gui\window_army.gui:2038
###
### USER ITEM 1.2 IS OBEYED HERE TOO: the headline, the scales' frame and the
### breakdown tooltip all read tnt_ai_accept_value - the DECIDING value, with the
### threshold already folded in - so "the number is positive" and "they will
### sign" are the same statement in the letter exactly as in the window.
###
### LAYOUT LAW (R5), and this file was written to it from the first line:
### NO widget below carries `position` or `parentanchor` AS A CHILD OF AN HBOX
### OR A VBOX - the engine's own message is "Unsupported property: parentanchor
### on widgets that are a child of a hbox/vbox. Hboxes/vboxes arrange their
### children automatically.", and 0 of 13650 such children in the 373 vanilla
### .gui files carry one. Cross-axis centring is `expand = {}`; the only
### anchors in the file are on icons and one portrait INSIDE plain-widget
### holders (user item 2's object rows), which is the licence every row in
### tnt_types.gui uses, because a plain widget arranges nothing. R6: the only
### container here is vanilla's own container_character_tooltip, hosted by a
### tooltipwidget on the hostage row - tooltip content is not a flow child of
### anything, so the (flow)container rule has nothing to bite. (The retired ward
### row, V16 user item 5, was the other host of it.)
######################################################################

vbox = {
	name = "tnt_offer_summary"
	layoutpolicy_horizontal = expanding

	### Invisible children take no space. It is what lets the five money rows at
	### the bottom be declared unconditionally and cost nothing: a package sets at
	### most two of them, so this widget is about 90 px tall in practice.
	### Shipped in this mod at gui/tnt_types.gui (tnt_column, the picker panels).
	ignoreinvisible = yes

	spacing = 4

	divider_light = {
		layoutpolicy_horizontal = expanding
	}

	####################################################################
	### THE VERDICT LINE. Scales on the left, then the header, the signed
	### headline number and the accept/reject word.
	####################################################################
	hbox = {
		name = "tnt_offer_verdict_line"
		layoutpolicy_horizontal = expanding
		margin_left = 3
		spacing = 8

		### icon_strength_balance.dds is 300x60 = exactly five 60x60 frames, and
		### 3 is level. Usage pattern verbatim from
		### GAME\gui\interaction_declare_war.gui:101-107; the frame value buckets
		### tnt_ai_accept_value (tnt_50_values.txt, tnt_balance_frame_value).
		### FixedPointToInt is the CFixedPoint -> int32 bridge and is already
		### shipped on the window's own scales.
		### The datacontext + tooltip_visible + tooltipwidget-with-its-own-
		### datacontext triple is verbatim from
		### GAME\gui\activity_window_widgets\hunt_success_chance.gui:24-31, and
		### widget_value_breakdown_tooltip recurses
		### (GAME\gui\shared\value_breakdown.gui:1942-1945, `recursive = yes`) -
		### so hovering this one icon opens the four figures, then the eight
		### relationship rows, then every per-item price. That recursion is why
		### this widget needs no figure rows of its own.
		icon = {
			name = "tnt_offer_scales"
			size = { 60 60 }
			texture = "gfx/interface/icons/icon_strength_balance.dds"
			framesize = { 60 60 }
			frame = "[FixedPointToInt( TntSV('tnt_balance_frame_value') )]"
			alwaystransparent = no

			datacontext = "[TntBreakdown('tnt_ai_accept_value')]"
			tooltip_visible = "[ValueBreakdown.HasTooltip]"

			tooltipwidget = {
				widget_value_breakdown_tooltip = {
					datacontext = "[TntBreakdown('tnt_ai_accept_value')]"
				}
			}
		}

		vbox = {
			layoutpolicy_horizontal = expanding
			spacing = 2

			hbox = {
				layoutpolicy_horizontal = expanding
				spacing = 6

				### A fixed loc label, so autoresize may stay as text_single
				### inherits it (GAME\gui\preload\labels.gui:6-16). The
				### anti-spill recipe (autoresize = no) is for widgets that
				### display GAME text - a title or a character name - and there
				### is none in this widget.
				text_single = {
					name = "tnt_offer_header"
					text = "tnt_balance_header"
					align = nobaseline
					default_format = "#high"
				}

				### THE NUMBER. Same value, same format token and same meaning as
				### the window's headline. `|+=0` prints a signed integer.
				text_single = {
					name = "tnt_offer_headline"
					text = "[TntSV('tnt_ai_accept_value')|+=0]"
					align = nobaseline
					default_format = "#high"
				}

				expand = {}
			}

			hbox = {
				layoutpolicy_horizontal = expanding
				spacing = 6

				### The only acceptance test in this mod is
				### tnt_ai_accept_value > 0, and exactly 0 declines
				### (GAME\gui\interaction_templates.gui:3089,
				### GAME\localization\english\interactions_l_english.yml:23).
				### TntNeg is the exact negation of TntPos, so precisely one
				### of these two is ever visible.
				text_single = {
					name = "tnt_offer_verdict_yes"
					visible = "[TntPos('tnt_ai_accept_value')]"
					text = "tnt_balance_accept"
					align = nobaseline
				}

				text_single = {
					name = "tnt_offer_verdict_no"
					visible = "[TntNeg('tnt_ai_accept_value')]"
					text = "tnt_balance_reject"
					align = nobaseline
				}

				expand = {}
			}
		}
	}

	####################################################################
	### THE MONEY, IN FULL, WITH REAL NUMBERS.
	###
	### The letter's prose (tnt_ai_offer_desc_a1 .. a16) names the terms of the
	### archetype it was written for, but WHICH SIDE PAYS is decided after the
	### archetype is chosen, by tnt_ai_offer_settle_effect - so no fixed piece of
	### prose can name it. These five rows can, and they are the reason the player
	### is never asked to accept an unstated sum.
	###
	### One row per numeric term an archetype can write. Each is a plain variable
	### read - two map lookups - and NEVER a GetScriptedGui call: Law R11 forbids
	### that in a per-row visible, and this is exactly the shape that rule exists
	### for. Under `ignoreinvisible = yes` above, the four or five rows that do not
	### apply take no space at all.
	###
	### The number itself is printed by the LOC STRING, not here: a loc value may
	### contain a datafunction, which is proven all over vanilla, e.g.
	###   GAME\localization\english\activities\coronation_activity_l_english.yml:697
	###     "#V [GetPlayer.MakeScope.Var('install_claimants_oath_counter').GetValue|0]/3#! ..."
	### That keeps every word AND every currency icon in the .yml where the
	### localisation author can edit them, and keeps this file free of wording.
	### The keys are listed for that author in this build's notes file.
	###
	### F5 - EVERY PROSE ROW IN THIS BLOCK WRAPS; IT DOES NOT ELIDE.
	### Measured on temp/screen3.png, the courtier head rendered as
	###   "Partner zabiraet ... iz vashego dvora - on nazvan n ..."
	### - cut mid-word at about 71 characters. The cause is the type, not the
	### string: text_single carries `elide = right` AND `autoresize = yes` from its
	### own definition (GAME\gui\preload\labels.gui:6-16), and every row here then
	### switched autoresize back OFF, which pins the box to one line and hands the
	### overflow to the elider. The row whose whole job is to warn that the deal
	### has soured (tnt_offer_row_word_kept, 76 rendered characters in Russian and
	### 84 in English) and the row that explains a deliberate gift
	### (tnt_offer_row_gift, 110 and 113) were both losing their tails this way.
	### That breaks this block's own stated invariant - the player must never
	### accept a term he was not shown - so the ROWS are fixed here rather than the
	### sentences, and no future translation can re-open the hole.
	###
	### THE SHAPE IS text_multi + autoresize = yes + max_width, vanilla's own idiom
	### for a paragraph inside an expanding column: 213 of the 222 text_multi call
	### sites under GAME\gui pair exactly those three. Exemplars re-read on disk:
	###   GAME\gui\frontend_bookmarks.gui:2009   expanding + autoresize + max_width
	###   GAME\gui\frontend_ingame_menu.gui:136  the same three in a flow box
	###   GAME\gui\window_dynasty_legacy.gui:124-135  text_multi children of an
	###     expanding vbox, carrying fontsize_min - this block's shape exactly
	### `align = nobaseline|left` survives the type change untouched: text_multi
	### takes nobaseline at GAME\gui\cooltip.gui:2663 and
	### GAME\gui\multiplayer_types.gui:1699. `multiline = yes` is deliberately NOT
	### restated - text_multi's own type already sets it
	### (GAME\gui\preload\labels.gui:19-30), and a restated default is a lie
	### waiting to drift.
	###
	### max_width IS LOAD-BEARING, NOT DECORATION, and this is the one line of the
	### change that could have gone wrong. `autoresize = no` gives a row a DESIRED
	### width of 0, which is the only reason this widget has never fought the event
	### window for space. Turning autoresize on would make each row desire its full
	### UNWRAPPED text - roughly 760 px for the gift line - inside a host that is
	### 510 px wide: character_event.gui:624-627 sizes the option grid
	### `addcolumn = 500` in an hbox with `margin_left = 10`, and
	### character_event.gui:470-489 hangs custom_widgets_container in that same flow
	### vbox with `margin = { 15 0 }`. 510 - 15 - 15 - this vbox's own
	### margin_left = 3 leaves 477 px of text. The screenshot confirms the
	### arithmetic: the rows start at x=452 and the 500 px option buttons span
	### 444..944. 470 is that 477 with seven pixels of slack, so the wrap width can
	### never exceed the space the row is actually handed. The nine contract lines
	### carry 458 instead, because they sit under `margin_left = 12`.
	###
	### WHAT DELIBERATELY DOES NOT WRAP - and the rule is a real distinction, not a
	### shortcut. The object NAME rows inside the datamodel items below (a title, an
	### artifact, a courtier, a marriage pair) stay single-line: their height is
	### pinned by PDX's fixed-size datamodel rule
	### (GAME\gui\window_epidemics.gui:449-450) and the scrollbox cap is arithmetic
	### on it (124 = five 24 px rows plus four 1 px spacings), so a wrapped name
	### would silently break the list. A NAME is an identifier the player can hover
	### for the full form; a TERM is a statement he is being asked to sign. Only the
	### statement has to arrive whole.
	### The hostage line is prose but stays single-line for a second
	### reason: it is the text half of a 30 px person row (`size = { 0 30 }`,
	### `maximumsize = { -1 30 }`) whose portrait holder is sized `100%`, so letting
	### the text grow means re-sizing a holder that would then chase a parent which
	### sizes to content. Its length is bounded in the .yml instead - the note on
	### that row says what budget the translator has. (The retired ward row, V16
	### user item 5, was the other line under this rule.)
	####################################################################
	vbox = {
		name = "tnt_offer_terms"
		layoutpolicy_horizontal = expanding
		margin_left = 3
		spacing = 1

		### EVERY TERM AN ARCHETYPE OR THE BALANCER CAN WRITE HAS A ROW HERE, and
		### that completeness is the point of this block, not a nicety. The letter
		### used to carry only five rows - two of them a since-retired term - so a package
		### containing an ALLIANCE, a non-aggression pact, a favor or the freedom of
		### prisoners was accepted by a player who had never been shown it. The prose
		### above names the archetype's headline term, but an archetype writes more
		### than one variable and the balancer adds currencies afterwards, so prose
		### can never be the full statement of the deal.
		###
		### WHEN A NEW ARCHETYPE IS ADDED, ADD ITS ROW HERE. The rule is mechanical:
		### one row per `set_variable` (or selection-list write) an AI path can put
		### into the offer. The current writers are tnt_37_ai_offer.txt (the
		### archetypes, including the ruling-supersession wave: titles, claims,
		### artifacts, fealty, and A16's marriage pair via tnt_wed_list - the ward
		### was in that wave too until V16 user item 5 retired it, row and all)
		### and tnt_39_autobalance.txt's sweeten/pay
		### ladders - four currencies each side. Only the obligation sheet has no
		### AI writer; when one appears, this block grows with it.
		###
		### V13 USER ITEM 2 CLOSED THAT LAST GAP AND THREE OTHERS. Four archetypes
		### were added so that no surviving term is unreachable by the AI, and this
		### block grew the four rows they need:
		###   A17 unbind   -> tnt_indep_p        (a line, beside the fealty line)
		###   A18 surety   -> tnt_hostage_r      (a person row; it was the ward row's
		###                                       shape, and since V16 retired the
		###                                       ward it OWNS that shape's note)
		###   A19 talent   -> tnt_sel_courtier_p (an object group over people)
		###   A20 fealty-on-terms -> tnt_vassal_r PLUS the nine tnt_ob_* rows of the
		###       contract sheet, which is why the contract block prints a head plus
		###       one small line per obligation.
		### The obligations are NOT independently offerable and that is a property of
		### the machinery, not a choice: tnt_ob_sign_value returns 0 unless a fealty
		### term is on the table, so a sheet with no fealty term prices exactly zero
		### and applies nothing. One archetype carries both, which is also vanilla's
		### shape - offer_vassalization_interaction ships its obligations as five
		### presets on ONE interaction.
		###
		### THE RULE CUTS BOTH WAYS, WHICH IS WHY THE PRISONER ROW BELOW IS
		### COMMENTED OUT (user item 7): archetype A5, the ransom letter, was its
		### only writer, and a row whose writer is gone reads as a MISSING WRITER
		### rather than as a retired term. When a term retires, retire its row.
		### A5 and goal code 3 are retired and must never be reused, the same
		### standing rule that keeps arch 4 and arch 7 dead.
		### V13 USER ITEM 1 APPLIED THE SAME RULE THREE MORE TIMES: the alliance row,
		### the truce row and the claim group are commented out below with their
		### writers A1, A2, A6 and A11. Burnt archetype indices are now 1, 2, 4, 5,
		### 6, 7, 11 and 12; live are 3, 8, 9, 10, 13, 14, 15, 16 and the four new
		### ones, 17 to 20.
		###
		### ORDER IS MEANING: what binds both of us, then what he hands over, then
		### what he wants from me, then the leverage he is applying. Under
		### `ignoreinvisible = yes` the rows that do not apply cost no space at all,
		### so a two-term letter is still two lines tall.

		### --- mutual: neither side "gives" these, they are sworn together --------
		### THE MUTUAL SECTION NOW CARRIES THE MARRIAGE PAIR GROUP ALONE, and it is
		### drawn further down (tnt_offer_list_marriage) because a couple is people
		### and needs the person shape. The two lines that stood HERE - the alliance
		### and the non-aggression truce - are retired by V13 user item 1 and
		### commented out immediately below. Nothing else is mutual today.
		####################################################################
		### RETIRED - THE ALLIANCE AND TRUCE LINES OF THE AI LETTER.
		### V13 USER ITEM 1.
		###
		### Both pacts were built, shipped and played, then CONSIDERED AND WITHDRAWN
		### FOR AN INDEFINITE PERIOD on the user's ruling. THIS IS A DESIGN REFUSAL,
		### NOT A BUG FIX: vanilla gates both behind the SAME Diplomacy lifestyle
		### perk, defensive_negotiations_perk - the alliance at
		### GAME\common\character_interactions\00_alliance.txt:1184, the purchased
		### truce through fp2_purchase_truce_interaction_soft_requirements_trigger
		### (GAME\common\scripted_triggers\03_fp2_scripted_triggers.txt:725-735),
		### whose OR opens with `always = no`. Buying either here short-circuits an
		### investment the player never made.
		###
		### THESE ROWS MUST GO RATHER THAN STAY, by this block's own stated
		### invariant above: ONE ROW PER set_variable AN AI PATH CAN PUT INTO THE
		### OFFER. Archetypes A1 (plain pact), A2 (alliance) and A6 (proud pact paid
		### in prestige) were the only writers of tnt_alliance_p / tnt_truce_p, and
		### all three retire with the terms - so a live row here would read as a
		### MISSING WRITER, the exact defect that invariant exists to catch, instead
		### of as a retired term.
		###
		### Nothing is deleted; do not re-enable one half. ARCHETYPE INDICES 1, 2 AND
		### 6 ARE RETIRED and must never be reused, beside 4, 5, 7, 11 and 12. The
		### loc keys tnt_ai_offer_row_alliance and tnt_ai_offer_row_truce STAY
		### DEFINED on purpose - the key set is pinned at 553 and an undefined key
		### prints raw.
		### Full tombstones: TOMBSTONE A and TOMBSTONE B in
		### gui\tnt_diplomacy_window.gui, and common\scripted_effects\tnt_32_apply.txt.
		####################################################################
#		text_single = {
#			name = "tnt_offer_row_alliance"
#			visible = "[TntOn('tnt_alliance_p')]"
#			layoutpolicy_horizontal = expanding
#			autoresize = no
#			align = nobaseline|left
#			fontsize_min = 12
#			text = "tnt_ai_offer_row_alliance"
#		}
#
#		text_single = {
#			name = "tnt_offer_row_truce"
#			visible = "[TntOn('tnt_truce_p')]"
#			layoutpolicy_horizontal = expanding
#			autoresize = no
#			align = nobaseline|left
#			fontsize_min = 12
#			text = "tnt_ai_offer_row_truce"
#		}

		### --- what HE gives (_r) -------------------------------------------------
		text_multi = {
			name = "tnt_offer_row_gold_r"
			visible = "[TntOn('tnt_gold_r')]"
			layoutpolicy_horizontal = expanding
			autoresize = yes
			max_width = 470
			align = nobaseline|left
			fontsize_min = 12
			text = "tnt_ai_offer_row_gold_r"
		}

		text_multi = {
			name = "tnt_offer_row_prestige_r"
			visible = "[TntOn('tnt_prestige_r')]"
			layoutpolicy_horizontal = expanding
			autoresize = yes
			max_width = 470
			align = nobaseline|left
			fontsize_min = 12
			text = "tnt_ai_offer_row_prestige_r"
		}

		text_multi = {
			name = "tnt_offer_row_piety_r"
			visible = "[TntOn('tnt_piety_r')]"
			layoutpolicy_horizontal = expanding
			autoresize = yes
			max_width = 470
			align = nobaseline|left
			fontsize_min = 12
			text = "tnt_ai_offer_row_piety_r"
		}

		text_multi = {
			name = "tnt_offer_row_influence_r"
			visible = "[TntOn('tnt_influence_r')]"
			layoutpolicy_horizontal = expanding
			autoresize = yes
			max_width = 470
			align = nobaseline|left
			fontsize_min = 12
			text = "tnt_ai_offer_row_influence_r"
		}

		### --- what he ASKS of me (_p) --------------------------------------------
		text_multi = {
			name = "tnt_offer_row_gold_p"
			visible = "[TntOn('tnt_gold_p')]"
			layoutpolicy_horizontal = expanding
			autoresize = yes
			max_width = 470
			align = nobaseline|left
			fontsize_min = 12
			text = "tnt_ai_offer_row_gold_p"
		}

		text_multi = {
			name = "tnt_offer_row_prestige_p"
			visible = "[TntOn('tnt_prestige_p')]"
			layoutpolicy_horizontal = expanding
			autoresize = yes
			max_width = 470
			align = nobaseline|left
			fontsize_min = 12
			text = "tnt_ai_offer_row_prestige_p"
		}

		text_multi = {
			name = "tnt_offer_row_piety_p"
			visible = "[TntOn('tnt_piety_p')]"
			layoutpolicy_horizontal = expanding
			autoresize = yes
			max_width = 470
			align = nobaseline|left
			fontsize_min = 12
			text = "tnt_ai_offer_row_piety_p"
		}

		text_multi = {
			name = "tnt_offer_row_influence_p"
			visible = "[TntOn('tnt_influence_p')]"
			layoutpolicy_horizontal = expanding
			autoresize = yes
			max_width = 470
			align = nobaseline|left
			fontsize_min = 12
			text = "tnt_ai_offer_row_influence_p"
		}

		text_multi = {
			name = "tnt_offer_row_hook_p"
			visible = "[TntOn('tnt_hook_p')]"
			layoutpolicy_horizontal = expanding
			autoresize = yes
			max_width = 470
			align = nobaseline|left
			fontsize_min = 12
			text = "tnt_ai_offer_row_hook_p"
		}

		####################################################################
		### RETIRED - THE PRISONER ROW OF THE AI LETTER.  USER ITEM 7.
		###
		### The prisoner terms were built, shipped and played, then CONSIDERED AND
		### WITHDRAWN FOR AN INDEFINITE PERIOD on the user's ruling; archetype A5, the
		### ransom letter that was this row's only AI writer, is retired with them.
		### A revival must lean on the VANILLA PRISONER SYSTEM (ransom_cost_value, the
		### ransom interactions and the release on_actions) rather than on this mod's
		### own bookkeeping.
		###
		### THIS ROW MUST GO RATHER THAN STAY: the block's stated invariant above is
		### ONE ROW PER set_variable AN AI PATH CAN PUT INTO THE OFFER. With no writer
		### left, a live row here would read as a missing writer - the exact defect
		### that invariant exists to catch - instead of as a retired term.
		### Nothing is deleted; do not re-enable one half.
		### Full tombstone: common\scripted_effects\tnt_32_apply.txt.
		####################################################################
#		text_single = {
#			name = "tnt_offer_row_prisoners_p"
#			visible = "[TntOn('tnt_prisoners_p')]"
#			layoutpolicy_horizontal = expanding
#			autoresize = no
#			align = nobaseline|left
#			fontsize_min = 12
#			text = "tnt_ai_offer_row_prisoners_p"
#		}

		### --- land, claims, artifacts (the ruling-supersession wave) -------------
		### USER ITEM 2 - THE LETTER NAMES WHAT CHANGES HANDS. Each term is the
		### shipped head line (the loc key, which prints the count) plus one small
		### row PER OBJECT, so "claims on land: 2" stopped being the whole
		### statement. Each group is gated on the same TntPos-on-a-count the deal
		### sheet's own group heads use (tnt_panel_multiselect.gui), so an unset
		### list renders nothing and its datamodel is never walked for a term that
		### is not in the offer.
		###
		### THE DATAMODEL is the same selection list the window edits - TntList is
		### GetPlayer.MakeScope.GetList (data_binding/tnt_macros.txt), and the
		### Scope.Title / Scope.Artifact unwrap plus the restated fixed item size
		### are exactly the deal sheet groups' shape (tnt_sheet_sel_title_p and
		### friends; PDX's fixed-size rule, GAME\gui\window_epidemics.gui:449-450).
		###
		### THE NAME IS THE LINKED FORM - Title.GetName / Artifact.GetName, the
		### tooltipped twins of the NoTooltip calls this mod uses wherever a name
		### must not fight a button. Here a row hosts no control, so the full form
		### is correct and the engine hangs the object's own hover tooltip on the
		### name. Call sites of the full form in ordinary text widgets:
		###   [Title.GetName]     GAME\gui\window_epidemics.gui:553 (a hoverable
		###                       text_single with no alwaystransparent, as here)
		###   [Title.GetName|U]   GAME\gui\window_migration.gui:1656
		###   [Artifact.GetName]  GAME\gui\interaction_confirmation.gui:110
		### The name texts therefore do NOT carry alwaystransparent = yes: a
		### transparent widget cannot receive the hover that opens that tooltip
		### (this mod's own doctrine, tnt_types.gui's V5 headline note).
		###
		### FIVE ROWS ARE VISIBLE, THE REST SCROLL, like the pickers: the vanilla
		### ledger pattern (autoresizescrollarea + size 0 + cap,
		### GAME\gui\window_ledger.gui:9405-9408), capped at 124 = five 24 px rows
		### plus four 1 px spacings, so a short list stays short and a nine-county
		### cession cannot flood the letter. scrollbox_empty is pinned invisible:
		### the group only exists while its count is positive, so the list can
		### never be empty while shown, and the vanilla default must not flash.
		###
		### The per-object icons are the deal sheet groups' own three textures, so
		### the letter and the sheet speak one iconography.
		vbox = {
			name = "tnt_offer_list_title_p"
			layoutpolicy_horizontal = expanding
			spacing = 1
			visible = "[TntPos('tnt_count_sel_title_p_value')]"

			text_multi = {
				name = "tnt_offer_row_title_p"
				layoutpolicy_horizontal = expanding
				autoresize = yes
				max_width = 470
				align = nobaseline|left
				fontsize_min = 12
				text = "tnt_ai_offer_row_title_p"
			}

			scrollbox = {
				name = "tnt_offer_scroll_title_p"
				layoutpolicy_horizontal = expanding
				autoresizescrollarea = yes
				size = { 0 0 }
				maximumsize = { -1 124 }

				blockoverride "scrollbox_margins"
				{
					margin_left = 12
					margin_right = 26
					margin_top = 0
					margin_bottom = 0
				}

				blockoverride "scrollbox_empty"
				{
					visible = no
				}

				blockoverride "scrollbox_content"
				{
					vbox = {
						name = "tnt_offer_objects_title_p"
						layoutpolicy_horizontal = expanding
						spacing = 1
						datamodel = "[TntList('tnt_sel_title_p')]"

						item = {
							hbox = {
								name = "tnt_offer_object_title_p"
								datacontext = "[Scope.Title]"
								layoutpolicy_horizontal = expanding
								size = { 0 24 }
								maximumsize = { -1 24 }
								spacing = 6
								margin = { 2 2 }

								widget = {
									name = "tnt_offer_object_title_p_icon_holder"
									size = { 20 100% }
									alwaystransparent = yes

									icon = {
										name = "tnt_offer_object_title_p_icon"
										size = { 18 18 }
										parentanchor = center
										texture = "gfx/interface/icons/character_interactions/icon_transfer_county.dds"
										alwaystransparent = yes
									}
								}

								text_single = {
									name = "tnt_offer_object_title_p_name"
									layoutpolicy_horizontal = expanding
									autoresize = no
									align = nobaseline|left
									default_format = "#high"
									fontsize_min = 12
									using = Font_Size_Small
									text = "[Title.GetName|U]"
								}
							}
						}
					}
				}
			}
		}

		### --- the man he would take out of your court (A19) ----------------------
		### V13 USER ITEM 2. A19 "talent" buys a courtier from the player, so this
		### is a _p group and it sits beside the other _p group, the land he asks
		### for. PEOPLE INSIDE AN OBJECT GROUP, so it is the title group's list
		### shape above with the WARD ROW's person shape per item: portrait plus
		### container_character_tooltip on the row's own datacontext, which is what
		### the marriage pair row does for this same reason (Scope.Char is the
		### promote a character datamodel yields, GAME\gui\window_situation_list.gui:
		### 1079; the mod's shipped character-row name binding is
		### gui\tnt_panel_multiselect.gui's tnt_multi_row_text,
		### `text = "[Character.GetUINameNoTooltip]"`). The NoTooltip form is
		### deliberate here and not the linked Title.GetName form used for objects:
		### the row already opens the character's own tooltip through
		### container_character_tooltip, and a tooltip inside a tooltip is the one
		### place the link must not fire.
		### The `visible` is the same TntPos-on-a-count every other group uses, so
		### an unset list renders nothing and its datamodel is never walked.
		vbox = {
			name = "tnt_offer_list_courtier_p"
			layoutpolicy_horizontal = expanding
			spacing = 1
			visible = "[TntPos('tnt_count_sel_courtier_p_value')]"

			### THE ROW IN temp/screen3.png. 88 rendered characters in Russian, 80 in
			### English, cut at 71 as "... - on nazvan n ...". It is now the whole
			### sentence on as many lines as it needs.
			text_multi = {
				name = "tnt_offer_row_courtier_p"
				layoutpolicy_horizontal = expanding
				autoresize = yes
				max_width = 470
				align = nobaseline|left
				fontsize_min = 12
				text = "tnt_ai_offer_row_courtier_p"
			}

			scrollbox = {
				name = "tnt_offer_scroll_courtier_p"
				layoutpolicy_horizontal = expanding
				autoresizescrollarea = yes
				size = { 0 0 }
				maximumsize = { -1 124 }

				blockoverride "scrollbox_margins"
				{
					margin_left = 12
					margin_right = 26
					margin_top = 0
					margin_bottom = 0
				}

				blockoverride "scrollbox_empty"
				{
					visible = no
				}

				blockoverride "scrollbox_content"
				{
					vbox = {
						name = "tnt_offer_objects_courtier_p"
						layoutpolicy_horizontal = expanding
						spacing = 1
						datamodel = "[TntList('tnt_sel_courtier_p')]"

						item = {
							### 30 px and not the object groups' 24: a person row
							### carries a 26 px head, the same figure the hostage row
							### and the marriage pair row already use. The fixed size
							### is PDX's own datamodel rule
							### (GAME\gui\window_epidemics.gui:449-450).
							hbox = {
								name = "tnt_offer_object_courtier_p"
								datacontext = "[Scope.Char]"
								layoutpolicy_horizontal = expanding
								size = { 0 30 }
								maximumsize = { -1 30 }
								spacing = 6
								margin = { 2 2 }
								alwaystransparent = no

								tooltipwidget = {
									container_character_tooltip = {}
								}

								widget = {
									name = "tnt_offer_object_courtier_p_portrait_holder"
									size = { 28 100% }
									alwaystransparent = yes

									portrait_head_tiny = {
										name = "tnt_offer_object_courtier_p_portrait"
										size = { 26 26 }
										parentanchor = center
										alwaystransparent = yes
									}
								}

								text_single = {
									name = "tnt_offer_object_courtier_p_name"
									layoutpolicy_horizontal = expanding
									autoresize = no
									align = nobaseline|left
									default_format = "#high"
									fontsize_min = 12
									using = Font_Size_Small
									alwaystransparent = yes
									text = "[Character.GetUINameNoTooltip]"
								}
							}
						}
					}
				}
			}
		}

