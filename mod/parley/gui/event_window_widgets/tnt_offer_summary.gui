				}
			}
		}

		####################################################################
		### RETIRED V16, USER ITEM 5 - THE WARD ROW OF THE AI LETTER.
		###
		### Archetype A15 (offer a ward) is commented out of the composer's
		### random_list (common\scripted_effects\tnt_37_ai_offer.txt), so nothing
		### writes tnt_ward_r any more and this row could only ever have been
		### invisible. Leaving it live would have left a row bound to a variable no
		### archetype writes - the reader-with-no-writer shape this mod has already
		### paid 804 error-log lines for on these exact two variables
		### (common\scripted_triggers\tnt_42_people_gates.txt, P18's header).
		###
		### THE USER'S REASON: too abusable on points, and the hostage term covers
		### the same immersive ground. The hostage row directly BELOW is now the only
		### person row in the letter, and THE SHAPE ARGUMENT THAT USED TO LIVE HERE
		### HAS BEEN MOVED INTO IT - portrait size mandatory,
		### container_character_tooltip via the hbox datacontext, text transparent,
		### and the 30 px / 443 px prose budget. Read it there.
		###
		### The loc key tnt_ai_offer_row_ward_r stays DEFINED in both .yml files as a
		### deliberate orphan; the mod's key count is pinned at 570 and a retirement
		### never changes it (same rule the retired goal and archetype prose keys
		### follow, events\tnt_ai_events.txt:648-650).
		####################################################################
#		### USER ITEM 2: the ward is a PERSON, so the row wears the mod's own
#		### person-row shape - a small head beside the line, and the whole row
#		### opens container_character_tooltip on hover (the shipped shape,
#		### gui\tnt_panel_multiselect.gui tnt_multi_row_char; the vanilla type is
#		### GAME\gui\cooltip.gui:1340, used exactly this way at
#		### GAME\gui\window_army.gui:2038). The datacontext on the hbox feeds BOTH
#		### the portrait and the tooltip; the visible gate is the same Char.IsValid
#		### the row always had, so neither ever evaluates against an unset
#		### variable. The text keeps the shipped loc key and goes transparent so
#		### the hover lands on the row wherever the cursor is. The explicit size
#		### on the portrait is mandatory - the type is natively 64x64
#		### (GAME\gui\window_ledger.gui:6867-6869) and would flood the letter
#		### (user item 4's lesson, fixed in tnt_multi_row_char the same day).
#		hbox = {
#			name = "tnt_offer_row_ward_r"
#			visible = "[TntVar('tnt_ward_r').Char.IsValid]"
#			datacontext = "[TntVar('tnt_ward_r').Char]"
#			layoutpolicy_horizontal = expanding
#			size = { 0 30 }
#			maximumsize = { -1 30 }
#			spacing = 6
#			alwaystransparent = no
#
#			tooltipwidget = {
#				container_character_tooltip = {}
#			}
#
#			widget = {
#				name = "tnt_offer_ward_portrait_holder"
#				size = { 28 100% }
#				alwaystransparent = yes
#
#				portrait_head_tiny = {
#					name = "tnt_offer_ward_portrait"
#					size = { 26 26 }
#					parentanchor = center
#					alwaystransparent = yes
#				}
#			}
#
#			### THE ONE PROSE ROW IN THIS BLOCK THAT STAYS SINGLE-LINE, and the
#			### hostage twin below with it. Not an oversight: it is the text half of
#			### a 30 px person row, and the row's own portrait holder is sized
#			### `{ 28 100% }`, so letting the text grow would leave that 100% chasing
#			### a parent that had started sizing to its content. The height is the
#			### constraint, not the width.
#			###
#			### SO THIS ROW'S LENGTH IS BOUNDED IN THE .yml INSTEAD, and it needs a
#			### TIGHTER budget than any other row because it carries a live
#			### character name: 477 px of terms minus the 28 px portrait holder and
#			### 6 px of spacing leaves about 443 px, roughly 66 Russian characters
#			### at Font_Size_Small. A CK3 name with a house or a nickname runs to 25,
#			### so the fixed prose has to stay at or under about 40 characters.
#			### Today Russian is 57 and English 52 (hostage: 47 and 43), which is
#			### why F5's own count - which treated each datafunction as one glyph -
#			### read these two rows as safe when they are not.
#			### It therefore KEEPS text_single. A text_multi pinned to one line's
#			### height would wrap and then CLIP, hiding the tail with no ellipsis to
#			### admit it - strictly worse than eliding, which at least prints "...".
#			text_single = {
#				name = "tnt_offer_row_ward_r_text"
#				layoutpolicy_horizontal = expanding
#				autoresize = no
#				align = nobaseline|left
#				fontsize_min = 12
#				alwaystransparent = yes
#				text = "tnt_ai_offer_row_ward_r"
#			}
#		}

		### V13 USER ITEM 2: THE HOSTAGE HE SENDS AS SURETY (A18).
		###
		### *** THIS IS NOW THE ONLY PERSON ROW IN THE LETTER. *** It was built as
		### the ward row with three names changed, and the ward row above it is
		### RETIRED (V16, user item 5), so THE WHOLE SHAPE ARGUMENT WAS MOVED HERE
		### rather than left in a commented-out block. Do not shorten it back to a
		### cross-reference.
		###
		### THE PERSON-ROW SHAPE, AND WHY EVERY PART OF IT IS MANDATORY. A hostage is
		### a PERSON, so the row wears the mod's own person-row shape - a small head
		### beside the line, and the whole row opens container_character_tooltip on
		### hover (the shipped shape, gui\tnt_panel_multiselect.gui
		### tnt_multi_row_char; the vanilla type is GAME\gui\cooltip.gui:1340, used
		### exactly this way at GAME\gui\window_army.gui:2038).
		###   * THE DATACONTEXT SITS ON THE hbox and feeds BOTH the portrait and the
		###     tooltip - one binding, not two.
		###   * THE VISIBLE AND THE DATACONTEXT ARE THE SAME Char.IsValid PAIR, so
		###     neither ever evaluates against an unset variable (R13: an
		###     object-valued variable is read through a validity test).
		###   * THE EXPLICIT SIZE ON THE PORTRAIT IS MANDATORY - portrait_head_tiny is
		###     natively 64x64 (GAME\gui\window_ledger.gui:6867-6869) and without
		###     `size = { 26 26 }` it floods the letter (user item 4's lesson, fixed
		###     in tnt_multi_row_char the same day).
		###   * THE TEXT IS alwaystransparent so the hover lands on the row wherever
		###     the cursor is.
		###
		### THE PROSE BUDGET, which is this row's real constraint and lives in the
		### .yml, not here. The row STAYS SINGLE-LINE: it is the text half of a 30 px
		### person row whose portrait holder is sized `{ 28 100% }`, so letting the
		### text grow would leave that 100% chasing a parent that had started sizing
		### to its content. The height is the constraint, not the width. The length is
		### therefore bounded in the .yml instead, and it needs a TIGHTER budget than
		### any other row because it carries a live character name: 477 px of terms
		### minus the 28 px portrait holder and 6 px of spacing leaves about 443 px,
		### roughly 66 Russian characters at Font_Size_Small. A CK3 name with a house
		### or a nickname runs to 25, so the fixed prose has to stay at or under about
		### 40 characters. Measured for tnt_ai_offer_row_hostage_r: Russian 47,
		### English 43. F5's own count read this row as safe because it treated each
		### datafunction as one glyph; it is not safe, it is merely closer than the
		### retired ward row was (Russian 57, English 52).
		### It therefore KEEPS text_single. A text_multi pinned to one line's height
		### would wrap and then CLIP, hiding the tail with no ellipsis to admit it -
		### strictly worse than eliding, which at least prints "...".
		###
		### ONLY THE _r SIDE EXISTS, and that is a standing refusal rather than an
		### omission: tnt_hostage_p would have a letter silently nominate which of
		### the PLAYER's children is surrendered. A18 nominates the AI's own child -
		### which was A15's precedent too, the ward row above, RETIRED V16.
		hbox = {
			name = "tnt_offer_row_hostage_r"
			visible = "[TntVar('tnt_hostage_r').Char.IsValid]"
			datacontext = "[TntVar('tnt_hostage_r').Char]"
			layoutpolicy_horizontal = expanding
			size = { 0 30 }
			maximumsize = { -1 30 }
			spacing = 6
			alwaystransparent = no

			tooltipwidget = {
				container_character_tooltip = {}
			}

			widget = {
				name = "tnt_offer_hostage_portrait_holder"
				size = { 28 100% }
				alwaystransparent = yes

				portrait_head_tiny = {
					name = "tnt_offer_hostage_portrait"
					size = { 26 26 }
					parentanchor = center
					alwaystransparent = yes
				}
			}

			### Single-line for the two reasons set out in this row's own header
			### above - a 30 px person row it must not outgrow, and a name that only
			### a .yml budget can bound. That note carries the arithmetic.
			text_single = {
				name = "tnt_offer_row_hostage_r_text"
				layoutpolicy_horizontal = expanding
				autoresize = no
				align = nobaseline|left
				fontsize_min = 12
				alwaystransparent = yes
				text = "tnt_ai_offer_row_hostage_r"
			}
		}

		### --- the proposed marriage (A16) ------------------------------------------
		### A COUPLE IS PEOPLE, so the group wears both shipped person shapes at
		### once: the head line is a plain term row (vassal row above), and each
		### pair renders as ONE row with the member's small head beside BOTH
		### names - the deal sheet's own rendering of this same list
		### (gui\tnt_panels.gui tnt_sheet_marriage_pairs, datamodel
		### TntList('tnt_wed_list'), item datacontext "[Scope.Char]" per
		### GAME\gui\window_situation_list.gui:1079). The names use the shipped
		### key tnt_wed_pair_row - the LINKED GetShortUIName forms, so each name
		### carries its own hover tooltip (the Title.GetName licence above), and
		### the text is therefore NOT alwaystransparent; hover elsewhere on the
		### row (the portrait, the gaps) opens the member's
		### container_character_tooltip through the row datacontext, person-row
		### style (the shape's note is on the hostage row above; the retired ward
		### row was where it used to live).
		### The partner-validity visible is the marriage panel's own idiom
		### (gui\tnt_panel_marriage.gui:567) - a member whose partner died while
		### the letter sat renders nothing rather than half a couple.
		### The fixed item size is PDX's own datamodel rule
		### (GAME\gui\window_epidemics.gui:449-450). A16 writes exactly one
		### pair, so the block is one head line and one row in practice; the
		### datamodel costs nothing extra and stays honest if a future path ever
		### composes more.
		vbox = {
			name = "tnt_offer_list_marriage"
			layoutpolicy_horizontal = expanding
			spacing = 1
			visible = "[TntOn('tnt_marriage_p')]"

			text_multi = {
				name = "tnt_offer_row_marriage"
				layoutpolicy_horizontal = expanding
				autoresize = yes
				max_width = 470
				align = nobaseline|left
				fontsize_min = 12
				text = "tnt_ai_offer_row_marriage"
			}

			vbox = {
				name = "tnt_offer_marriage_pairs"
				layoutpolicy_horizontal = expanding
				spacing = 1
				datamodel = "[TntList('tnt_wed_list')]"

				item = {
					hbox = {
						name = "tnt_offer_marriage_pair"
						datacontext = "[Scope.Char]"
						### The validity gate reads through the datamodel's own
						### ambient Scope, not through Character, so it cannot
						### depend on this same widget's datacontext having been
						### applied first - Scope.Char is the very promote the
						### datacontext line uses, and Character.MakeScope.Var
						### ('tnt_wed_partner').Char is the panel's shipped
						### partner read (gui\tnt_panel_marriage.gui:503, :573).
						visible = "[Scope.Char.MakeScope.Var('tnt_wed_partner').Char.IsValid]"
						layoutpolicy_horizontal = expanding
						size = { 0 30 }
						maximumsize = { -1 30 }
						spacing = 6
						margin_left = 12
						alwaystransparent = no

						tooltipwidget = {
							container_character_tooltip = {}
						}

						widget = {
							name = "tnt_offer_marriage_portrait_holder"
							size = { 28 100% }
							alwaystransparent = yes

							portrait_head_tiny = {
								name = "tnt_offer_marriage_portrait"
								size = { 26 26 }
								parentanchor = center
								alwaystransparent = yes
							}
						}

						text_single = {
							name = "tnt_offer_marriage_pair_names"
							layoutpolicy_horizontal = expanding
							autoresize = no
							align = nobaseline|left
							default_format = "#high"
							fontsize_min = 12
							using = Font_Size_Small
							text = "tnt_wed_pair_row"
						}

						### THE LINE OF DESCENT (V10, user item 1): the player must
						### see whether the proposed match is patri- or matrilineal
						### before he accepts. tnt_wed_row_line is the marriage
						### panel's own shipped key - a Select_CString over the
						### pair's tnt_wed_matri, read off the SAME Character this
						### row's datacontext already carries - so the letter and
						### the editor can never disagree about a pair's line.
						text_single = {
							name = "tnt_offer_marriage_pair_line"
							autoresize = no
							### V12, USER ITEM 1 - THE LINE WAS NEVER 0 CHARACTERS,
							### IT WAS 0 PIXELS. text_single is a textbox that carries
							### autoresize = yes and NO size of its own
							### (GAME\gui\preload\labels.gui:6-16), so switching
							### autoresize off leaves the width to come from a layout
							### policy or from min_width - max_width is only a ceiling,
							### never a width, and the hbox handed this child 0.
							### Every OTHER autoresize = no label in this file expands
							### (:919 is its own sibling in this very hbox); this one is
							### a FIXED right-hand column beside an expanding one, which
							### is vanilla's own two-child idiom at
							### GAME\gui\window_royal_court.gui:1137-1155 (expanding
							### label + min_width = 30 label in one hbox) and this mod's
							### shipped tnt_sheet_name (gui\tnt_panels.gui:453-462,
							### min_width == max_width == 118), which renders THIS SAME
							### loc key in the deal sheet (gui\tnt_panels.gui:849).
							### min_width is kept equal to max_width so a long
							### translation can neither shrink nor widen the column:
							### the longest branch, Russian "Patrilineynyy", is ~95 px
							### at Font_Size_Small.
							min_width = 130
							max_width = 130
							align = nobaseline|right
							default_format = "#weak"
							fontsize_min = 12
							using = Font_Size_Small
							alwaystransparent = yes
							text = "tnt_wed_row_line"
						}
					}
				}
			}
		}

		### --- the leverage he is applying ----------------------------------------
		text_multi = {
			name = "tnt_offer_row_usehook_r"
			visible = "[TntOn('tnt_usehook_r')]"
			layoutpolicy_horizontal = expanding
			autoresize = yes
			max_width = 470
			align = nobaseline|left
			fontsize_min = 12
			text = "tnt_ai_offer_row_usehook_r"
		}

		### --- he no longer likes the deal, but he offered it ----------------------
		### The Accept option tolerates up to -15 of drift on the ground that the AI
		### gave its word (events/tnt_ai_events.txt). Without this line the player
		### would read "He will refuse" next to a live Accept button and conclude the
		### window was lying to him.
		### THE ROW THAT MUST ARRIVE WHOLE. It is the only warning the player gets
		### that the AI's own arithmetic has turned against a letter it still
		### intends to honour, and it was 76 rendered characters in Russian and 84
		### in English - i.e. elided on both languages, losing exactly the clause
		### that says the word will be kept. It wraps.
		text_multi = {
			name = "tnt_offer_row_word_kept"
			visible = "[TntNeg('tnt_ai_accept_value')]"
			layoutpolicy_horizontal = expanding
			autoresize = yes
			max_width = 470
			align = nobaseline|left
			fontsize_min = 12
			default_format = "#weak"
			text = "tnt_ai_offer_row_word_kept"
		}

		### THE DELIBERATE GIFT (user items 5+9): the settle marks a letter whose
		### headline still exceeds the generosity cap with tnt_ai_gift, and this
		### line is what keeps that from reading as a pricing bug - the partner is
		### offering more than he asks BECAUSE he thinks well of the player, and
		### the letter says so in words.
		### THE LONGEST ROW IN THE WIDGET BY A WIDE MARGIN - 110 rendered characters
		### in Russian, 113 in English, against a box that elided at 71. It was
		### losing its entire second sentence, which is the sentence that says the
		### letter is a gift; without it the row read as the pricing bug it exists
		### to explain away. Two lines, and it says both halves.
		text_multi = {
			name = "tnt_offer_row_gift"
			visible = "[TntOn('tnt_ai_gift')]"
			layoutpolicy_horizontal = expanding
			autoresize = yes
			max_width = 470
			align = nobaseline|left
			fontsize_min = 12
			default_format = "#weak"
			text = "tnt_ai_gift_line"
		}
	}

	divider_light = {
		layoutpolicy_horizontal = expanding
	}
}
