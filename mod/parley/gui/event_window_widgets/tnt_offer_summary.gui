				### The one row that favours the LIEGE, which is why it is here at
				### all: a menaced subject writes it as the sweetener that buys the
				### deal. It prints in the same grey as the rest; the balance is
				### where the player sees that it is worth something to him.
				text_multi = {
					name = "tnt_offer_row_ob_succ"
					visible = "[TntOn('tnt_ob_succ')]"
					layoutpolicy_horizontal = expanding
					autoresize = yes
					max_width = 458
