				}

				text_multi = {
					name = "tnt_offer_row_ob_coin"
					visible = "[TntOn('tnt_ob_coin')]"
					layoutpolicy_horizontal = expanding
					autoresize = yes
					max_width = 458
					align = nobaseline|left
