				}

				text_multi = {
					name = "tnt_offer_row_ob_fort"
					visible = "[TntOn('tnt_ob_fort')]"
					layoutpolicy_horizontal = expanding
					autoresize = yes
					max_width = 458
					align = nobaseline|left
					default_format = "#weak"
					fontsize_min = 12
