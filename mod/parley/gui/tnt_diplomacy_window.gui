											blockoverride "tnt_interest_detail" { visible = "[TntPos('tnt_interest_courtier_r_selected_value')]" raw_text = "[Localize('tnt_item_courtier')]: [TntSV('tnt_count_sel_courtier_r_value')|0]" }
											blockoverride "tnt_interest_empty_state" { visible = "[Not( TntPos('tnt_interest_courtier_r_selected_value') )]" text = "tnt_interest_preview_context" }
											blockoverride "tnt_interest_preview_breakdown" { visible = "[Not( TntPos('tnt_interest_courtier_r_selected_value') )]" datacontext = "[TntBreakdown('tnt_interest_courtier_r_preview_percent_value')]" }
											blockoverride "tnt_interest_breakdown" { visible = "[TntPos('tnt_interest_courtier_r_selected_value')]" datacontext = "[TntBreakdown('tnt_interest_courtier_r_percent_value')]" }
											blockoverride "tnt_interest_points" { visible = "[TntPos('tnt_interest_courtier_r_selected_value')]" }
											blockoverride "tnt_interest_points_effective" { raw_text = "[Localize('tnt_interest_effective_percent')]: [TntSV('tnt_interest_courtier_r_display_percent_value')|2]%" }
											blockoverride "tnt_interest_points_base" { raw_text = "[Localize('tnt_interest_base_points')]: [TntSV('tnt_interest_courtier_r_base_value')|3]" }
											blockoverride "tnt_interest_points_adjusted" { raw_text = "[Localize('tnt_interest_adjusted_points')]: [TntSV('tnt_interest_courtier_r_adjusted_value')|3]" }
										}
									}
								}
							}
						}
						layoutpolicy_horizontal = expanding
						visible = "[TntRow('tnt_show_courtier_r')]"

						blockoverride "tnt_row_icon"    { texture = "gfx/interface/icons/character_interactions/courtier_interaction.dds" }
						blockoverride "tnt_row_name"    { text = "tnt_item_courtier" }
						blockoverride "tnt_row_tooltip" { tooltip = "tnt_item_courtier_desc" }
						blockoverride "tnt_picker_label"
						{
							visible = "[TntAny('tnt_sel_courtier_r')]"
							text = "tnt_sel_count_courtier_r"
						}

						blockoverride "tnt_picker_content"
						{
							tnt_chosen_count = {
								name = "tnt_chosen_courtier_r"

								blockoverride "tnt_chosen_visible"     { visible = "[TntAny('tnt_sel_courtier_r')]" }
								blockoverride "tnt_chosen_click"       { onclick = "[TntExec('tnt_multi_courtier_r_open')]" }
								blockoverride "tnt_chosen_tooltip"     { tooltip = "tnt_btn_change" }
								blockoverride "tnt_chosen_count_label" { text = "[GetDataModelSize( TntList('tnt_sel_courtier_r') )]" }
							}
						}

						blockoverride "tnt_picker_open_state"   { visible = "[TntNone('tnt_sel_courtier_r')]" }
						blockoverride "tnt_picker_clear_state"  { visible = "[TntAny('tnt_sel_courtier_r')]" }
						blockoverride "tnt_picker_open_sgui"    { onclick = "[TntExec('tnt_multi_courtier_r_open')]" }
						blockoverride "tnt_picker_open_enabled" { enabled = "[TntValid('tnt_multi_courtier_r_open')]" }
						blockoverride "tnt_picker_open_tooltip" { tooltip = "[TntTip('tnt_multi_courtier_r_open')]" }
						blockoverride "tnt_picker_clear_sgui"   { onclick = "[TntExec('tnt_sel_courtier_r_clear')]" }
					}

					### 19 - TRANSFER A VASSAL (MULTI-SELECT, panel 19 / side 1)  V26
					###      The mirror: the PARTNER hands over one of his own direct
					###      vassals. Same game-rule conjunct as the _p twin, and for
					###      the same reason - the term is irreversible on either
					###      side, so both rows read tnt_advanced or neither does.
					tnt_item_row_picker = {
						name = "tnt_row_subject_r"
						blockoverride "tnt_row_interest" {
							tnt_interest_badge = {
								blockoverride "tnt_interest_state" { visible = "[TntPos('tnt_interests_enabled_value')]" }
								blockoverride "tnt_interest_value" { fontcolor = "[TntInterestColor('tnt_interest_subject_r_badge_percent_value')]" raw_text = "[TntSV('tnt_interest_subject_r_badge_percent_value')|0]%" }
								blockoverride "tnt_interest_tooltip" {
									tooltipwidget = {
										tnt_interest_tooltip = {
											blockoverride "tnt_interest_heading" { text = "tnt_interest_surrender" }
											blockoverride "tnt_interest_detail" { visible = "[TntPos('tnt_interest_subject_r_selected_value')]" raw_text = "[Localize('tnt_item_subject')]: [TntSV('tnt_count_sel_subject_r_value')|0]" }
											blockoverride "tnt_interest_empty_state" { visible = "[Not( TntPos('tnt_interest_subject_r_selected_value') )]" text = "tnt_interest_preview_context" }
											blockoverride "tnt_interest_preview_breakdown" { visible = "[Not( TntPos('tnt_interest_subject_r_selected_value') )]" datacontext = "[TntBreakdown('tnt_interest_subject_r_preview_percent_value')]" }
											blockoverride "tnt_interest_breakdown" { visible = "[TntPos('tnt_interest_subject_r_selected_value')]" datacontext = "[TntBreakdown('tnt_interest_subject_r_percent_value')]" }
											blockoverride "tnt_interest_points" { visible = "[TntPos('tnt_interest_subject_r_selected_value')]" }
											blockoverride "tnt_interest_points_effective" { raw_text = "[Localize('tnt_interest_effective_percent')]: [TntSV('tnt_interest_subject_r_display_percent_value')|2]%" }
											blockoverride "tnt_interest_points_base" { raw_text = "[Localize('tnt_interest_base_points')]: [TntSV('tnt_interest_subject_r_base_value')|3]" }
											blockoverride "tnt_interest_points_adjusted" { raw_text = "[Localize('tnt_interest_adjusted_points')]: [TntSV('tnt_interest_subject_r_adjusted_value')|3]" }
										}
									}
								}
							}
						}
						layoutpolicy_horizontal = expanding
						visible = "[And( TntRow('tnt_show_subject_r'), TntOn('tnt_advanced') )]"

						blockoverride "tnt_row_icon"    { texture = "gfx/interface/icons/character_interactions/icon_vassal.dds" }
						blockoverride "tnt_row_name"    { text = "tnt_item_subject" }
						blockoverride "tnt_row_tooltip" { tooltip = "tnt_item_subject_desc" }
						blockoverride "tnt_picker_label"
						{
							visible = "[TntAny('tnt_sel_subject_r')]"
							text = "tnt_sel_count_subject_r"
						}

						blockoverride "tnt_picker_content"
						{
							tnt_chosen_count = {
								name = "tnt_chosen_subject_r"

								blockoverride "tnt_chosen_visible"     { visible = "[TntAny('tnt_sel_subject_r')]" }
								blockoverride "tnt_chosen_click"       { onclick = "[TntExec('tnt_multi_subject_r_open')]" }
								blockoverride "tnt_chosen_tooltip"     { tooltip = "tnt_btn_change" }
								blockoverride "tnt_chosen_count_label" { text = "[GetDataModelSize( TntList('tnt_sel_subject_r') )]" }
							}
						}

						blockoverride "tnt_picker_open_state"   { visible = "[TntNone('tnt_sel_subject_r')]" }
						blockoverride "tnt_picker_clear_state"  { visible = "[TntAny('tnt_sel_subject_r')]" }
