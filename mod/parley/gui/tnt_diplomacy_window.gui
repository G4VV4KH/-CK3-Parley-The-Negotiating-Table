											blockoverride "tnt_interest_detail" { visible = "[TntPos('tnt_interest_hostage_r_selected_value')]" raw_text = "[Localize('tnt_item_hostage')]: [TntVar('tnt_hostage_r').Char.GetUINameNoTooltip]" }
											blockoverride "tnt_interest_empty_state" { visible = "[Not( TntPos('tnt_interest_hostage_r_selected_value') )]" text = "tnt_interest_preview_context" }
											blockoverride "tnt_interest_preview_breakdown" { visible = "[Not( TntPos('tnt_interest_hostage_r_selected_value') )]" datacontext = "[TntBreakdown('tnt_interest_hostage_r_preview_percent_value')]" }
