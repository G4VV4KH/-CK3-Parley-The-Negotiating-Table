								blockoverride "tnt_chosen_visible"     { visible = "[TntAny('tnt_sel_title_r')]" }
								blockoverride "tnt_chosen_click"       { onclick = "[TntExec('tnt_multi_title_r_open')]" }
								blockoverride "tnt_chosen_tooltip"     { tooltip = "tnt_btn_change" }
								blockoverride "tnt_chosen_count_label" { text = "[TntSV('tnt_count_sel_title_r_value')|0]" }
							}
						}

						blockoverride "tnt_picker_open_state"    { visible = "[TntNone('tnt_sel_title_r')]" }
						blockoverride "tnt_picker_clear_state"   { visible = "[TntAny('tnt_sel_title_r')]" }
						blockoverride "tnt_picker_open_sgui"     { onclick = "[TntExec('tnt_multi_title_r_open')]" }
						blockoverride "tnt_picker_open_enabled"  { enabled = "[TntValid('tnt_multi_title_r_open')]" }
						blockoverride "tnt_picker_open_tooltip"  { tooltip = "[TntTip('tnt_multi_title_r_open')]" }
						blockoverride "tnt_picker_clear_sgui"    { onclick = "[TntExec('tnt_sel_title_r_clear')]" }
					}

