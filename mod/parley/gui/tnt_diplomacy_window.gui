					### 13 - PRESTIGE (item 2.4). NEW.
					### There is no transfer effect for prestige, so the apply leg
					### is two independent add_prestige calls; that is the effects
					### author's problem, not this file's.
					###
					### USER ITEM 3, "the prestige and piety icons are BLACK while
					### gold is fine". The old path - flat_icons\prestige.dds, cited
					### here from GAME\gui\window_ledger.gui:9534 - EXISTS and was
					### never wrong as a path. It is simply a black alpha MASK: every
					### opaque pixel in it is RGB 0,0,0, meant to be tinted by the
					### consumer. The ledger is its only vanilla consumer and draws it
					### over a light plate. Gold looked right because
					### character_interactions\icon_gold.dds is a full-colour icon.
					### The level-texture datafunction returns the coloured,
					### faith-correct icon instead:
					### GAME\gui\hud.gui:6521-6525 (prestige_icon) and :6586-6590
					### (piety_icon), both `texture = "[GetPlayer.Get*LevelTexture]"`.
					### GetPlayer, not Character: it needs no datacontext, so the same
					### one line is correct in both columns and in the deal sheet
					### (gui\tnt_panels.gui), which has no Character in scope. If the
					### partner's OWN faith glyph is ever wanted in the right-hand
					### column, [Character.GetPietyLevelTexture] is proven at
					### GAME\gui\window_character.gui:5363-5367 and tnt_column does set
					### a datacontext - but only in THIS file, never in the sheet.
					tnt_item_row_currency = {
						name = "tnt_row_prestige_p"
						blockoverride "tnt_row_interest" {
							tnt_interest_badge = {
								blockoverride "tnt_interest_state" { visible = "[TntPos('tnt_interests_enabled_value')]" }
								blockoverride "tnt_interest_value" { fontcolor = "[TntInterestColor('tnt_interest_prestige_p_badge_percent_value')]" raw_text = "[TntSV('tnt_interest_prestige_p_badge_percent_value')|0]%" }
								blockoverride "tnt_interest_tooltip" {
									tooltipwidget = {
										tnt_interest_tooltip = {
											blockoverride "tnt_interest_heading" { text = "tnt_interest_receive" }
											blockoverride "tnt_interest_detail" { raw_text = "[Localize('tnt_item_prestige')]: [TntNum('tnt_prestige_p')|2]" }
											blockoverride "tnt_interest_empty_state" { visible = "[Not( TntOn('tnt_prestige_p') )]" text = "tnt_interest_preview_currency" }
											blockoverride "tnt_interest_preview_breakdown" { visible = "[Not( TntOn('tnt_prestige_p') )]" datacontext = "[TntBreakdown('tnt_interest_prestige_p_preview_percent_value')]" }
											blockoverride "tnt_interest_breakdown" { visible = "[TntOn('tnt_prestige_p')]" datacontext = "[TntBreakdown('tnt_interest_prestige_p_percent_value')]" }
											blockoverride "tnt_interest_points" { visible = "[TntOn('tnt_prestige_p')]" }
											blockoverride "tnt_interest_points_effective" { raw_text = "[Localize('tnt_interest_effective_percent')]: [TntSV('tnt_interest_prestige_p_display_percent_value')|2]%" }
											blockoverride "tnt_interest_points_base" { raw_text = "[Localize('tnt_interest_base_points')]: [TntSV('tnt_interest_prestige_p_base_value')|3]" }
											blockoverride "tnt_interest_points_adjusted" { raw_text = "[Localize('tnt_interest_adjusted_points')]: [TntSV('tnt_interest_prestige_p_adjusted_value')|3]" }
											blockoverride "tnt_interest_capacity_state" { visible = yes }
											blockoverride "tnt_interest_capacity_target" { raw_text = "[Localize('tnt_interest_capacity_target')]: [TntSV('tnt_interest_prestige_capacity_value')|2]" }
											blockoverride "tnt_interest_capacity_stock" { raw_text = "[Localize('tnt_interest_current_stock')]: [TntSV('tnt_interest_prestige_stock_value')|2]" }
											blockoverride "tnt_interest_capacity_breakdown" { datacontext = "[TntBreakdown('tnt_interest_prestige_capacity_value')]" }
