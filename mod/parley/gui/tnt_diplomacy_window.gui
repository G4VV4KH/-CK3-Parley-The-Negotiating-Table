						visible = "[TntRow('tnt_show_hostage_r')]"

						blockoverride "tnt_row_icon"    { texture = "gfx/interface/icons/character_interactions/icon_hostage.dds" }
						blockoverride "tnt_row_name"    { text = "tnt_item_hostage" }
						blockoverride "tnt_row_tooltip" { tooltip = "tnt_item_hostage_desc" }
						blockoverride "tnt_picker_label"
						{
							visible = "[TntVar('tnt_hostage_r').Char.IsValid]"
							text = "[TntVar('tnt_hostage_r').Char.GetUINameNoTooltip]"
						}

						blockoverride "tnt_picker_content"
						{
							tnt_chosen_char = {
								name = "tnt_chosen_hostage_r"

								blockoverride "tnt_chosen_visible" { visible = "[TntVar('tnt_hostage_r').Char.IsValid]" }
