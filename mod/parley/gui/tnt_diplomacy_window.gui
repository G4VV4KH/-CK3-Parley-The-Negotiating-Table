#						blockoverride "tnt_picker_clear_state" { visible = "[TntAny('tnt_sel_claim_p')]" }
#						blockoverride "tnt_picker_open_sgui"   { onclick = "[TntExec('tnt_multi_claim_p_open')]" }
#						blockoverride "tnt_picker_clear_sgui"  { onclick = "[TntExec('tnt_sel_claim_p_clear')]" }
