											blockoverride "tnt_interest_points_effective" { raw_text = "[Localize('tnt_interest_effective_percent')]: [TntSV('tnt_interest_vassal_r_display_percent_value')|2]%" }
											blockoverride "tnt_interest_points_base" { raw_text = "[Localize('tnt_interest_base_points')]: [TntSV('tnt_interest_vassal_r_base_value')|3]" }
											blockoverride "tnt_interest_points_adjusted" { raw_text = "[Localize('tnt_interest_adjusted_points')]: [TntSV('tnt_interest_vassal_r_adjusted_value')|3]" }
										}
									}
								}
							}
						}
						layoutpolicy_horizontal = expanding
						visible = "[And( TntRow('tnt_show_vassal_r'), TntOn('tnt_advanced') )]"

						blockoverride "tnt_row_icon"    { texture = "gfx/interface/icons/character_interactions/icon_vassal.dds" }
						blockoverride "tnt_row_name"    { text = "tnt_item_vassal" }
						blockoverride "tnt_row_tooltip" { tooltip = "tnt_item_vassal_desc" }
						blockoverride "tnt_toggle_extra"
						{
							widget = {
								name = "tnt_contract_edit_holder_r"
								size = { 32 100% }

								button_round = {
									name = "tnt_contract_edit_r"
									size = { 28 28 }
									parentanchor = center
									tooltip = "tnt_btn_edit_contract"
									using = tooltip_es
									onclick = "[TntExec('tnt_pick_contract_open')]"

									icon = {
										name = "tnt_contract_edit_icon_r"
										size = { 20 20 }
										parentanchor = center
										texture = "gfx/interface/icons/character_interactions/icon_vassal.dds"
										alwaystransparent = yes
									}
								}
							}
						}
						blockoverride "tnt_toggle_sgui"    { onclick = "[TntExec('tnt_vassal_r_toggle')]" }
						blockoverride "tnt_toggle_var"     { checked = "[TntOn('tnt_vassal_r')]" }
						blockoverride "tnt_toggle_enabled" { enabled = "[TntValid('tnt_vassal_r_toggle')]" }
						blockoverride "tnt_toggle_tooltip" { tooltip = "[TntTip('tnt_vassal_r_toggle')]" }
					}

					####################################################
					### ITEM 19 - THE FOUR PEOPLE TERMS, PARTNER SIDE.
					### Same order, same shapes and the same panels as the _p twins;
					### only the variables, the lists and the scripted guis change side.
					### The full reasoning for each row is on its twin in the left
					### column - the two columns are read side by side, so the argument
					### is not repeated four times here.
					####################################################

					### 12b - GRANT INDEPENDENCE.
					###      _r MEANS THE PARTNER RELEASES THE PLAYER, i.e. the player
					###      stops being his vassal. That is the contract's fixed reading
					###      and the inverse of the _p row, not a second copy of it.
					tnt_item_row_toggle = {
						name = "tnt_row_indep_r"
						blockoverride "tnt_row_interest" {
							tnt_interest_badge = {
								blockoverride "tnt_interest_state" { visible = "[TntPos('tnt_interests_enabled_value')]" }
								blockoverride "tnt_interest_value" { fontcolor = "[TntInterestColor('tnt_interest_indep_r_badge_percent_value')]" raw_text = "[TntSV('tnt_interest_indep_r_badge_percent_value')|0]%" }
								blockoverride "tnt_interest_tooltip" {
									tooltipwidget = {
										tnt_interest_tooltip = {
											blockoverride "tnt_interest_heading" { text = "tnt_interest_surrender" }
											blockoverride "tnt_interest_detail" { text = "tnt_item_indep" }
											blockoverride "tnt_interest_empty_state" { visible = "[Not( TntPos('tnt_interest_indep_r_selected_value') )]" text = "tnt_interest_preview_context" }
											blockoverride "tnt_interest_preview_breakdown" { visible = "[Not( TntPos('tnt_interest_indep_r_selected_value') )]" datacontext = "[TntBreakdown('tnt_interest_indep_r_preview_percent_value')]" }
											blockoverride "tnt_interest_breakdown" { visible = "[TntPos('tnt_interest_indep_r_selected_value')]" datacontext = "[TntBreakdown('tnt_interest_indep_r_percent_value')]" }
											blockoverride "tnt_interest_points" { visible = "[TntPos('tnt_interest_indep_r_selected_value')]" }
											blockoverride "tnt_interest_points_effective" { raw_text = "[Localize('tnt_interest_effective_percent')]: [TntSV('tnt_interest_indep_r_display_percent_value')|2]%" }
											blockoverride "tnt_interest_points_base" { raw_text = "[Localize('tnt_interest_base_points')]: [TntSV('tnt_interest_indep_r_base_value')|3]" }
											blockoverride "tnt_interest_points_adjusted" { raw_text = "[Localize('tnt_interest_adjusted_points')]: [TntSV('tnt_interest_indep_r_adjusted_value')|3]" }
										}
									}
								}
							}
						}
						layoutpolicy_horizontal = expanding
						### V19: the mirror of the _p row above - same missing conjunct, same
						### reason, same shape. See the box at tnt_row_indep_p.
						visible = "[And( TntRow('tnt_show_indep_r'), TntOn('tnt_advanced') )]"

						blockoverride "tnt_row_icon"    { texture = "gfx/interface/icons/character_interactions/independence.dds" }
						blockoverride "tnt_row_name"    { text = "tnt_item_indep" }
						blockoverride "tnt_row_tooltip" { tooltip = "tnt_item_indep_desc" }
						blockoverride "tnt_toggle_sgui"    { onclick = "[TntExec('tnt_indep_r_toggle')]" }
						blockoverride "tnt_toggle_var"     { checked = "[TntOn('tnt_indep_r')]" }
						### Cached is_valid, like the _p twin: reads var:tnt_indep_ok_r
						### (E33), no per-frame vassal walk. See the _p row's box.
						blockoverride "tnt_toggle_enabled" { enabled = "[TntValid('tnt_indep_r_toggle')]" }
						blockoverride "tnt_toggle_tooltip" { tooltip = "[TntTip('tnt_indep_r_toggle')]" }
					}

					### 16 - HOSTAGES (the partner's hostage, panel 16 / side 1)
					tnt_item_row_picker = {
						name = "tnt_row_hostage_r"
						blockoverride "tnt_row_interest" {
							tnt_interest_badge = {
								blockoverride "tnt_interest_state" { visible = "[TntPos('tnt_interests_enabled_value')]" }
								blockoverride "tnt_interest_value" { fontcolor = "[TntInterestColor('tnt_interest_hostage_r_badge_percent_value')]" raw_text = "[TntSV('tnt_interest_hostage_r_badge_percent_value')|0]%" }
								blockoverride "tnt_interest_tooltip" {
									tooltipwidget = {
