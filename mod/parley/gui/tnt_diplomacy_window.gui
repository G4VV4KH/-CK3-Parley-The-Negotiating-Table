					### 3 / 4 - THE TWO PACT ROWS ARE GONE FROM THIS COLUMN TOO
					###     (V3 ADDITION 4). This is the side the user actually
					###     complained about: ticking the alliance HERE priced a
					###     second alliance and subtracted points. An alliance and a
					###     non-aggression pact are single facts about the PAIR - the
					###     same reason tnt_ally_inrealm never had a side suffix - so
					###     they are now single mutual rows in the centre column and
					###     tnt_alliance_r / tnt_truce_r have NO reader in the GUI
					###     any more (see the structured output's unused list).

					### 5 - MARRIAGE PACT (item 2.1). Same editor, same opener - see
					###     the _p twin. V3 ITERATION 4: this side's grey line
						###     counts the SAME one list of couples, and for the same
						###     reason as the _p twin - tnt_spouse_r is a staging cursor now.
					tnt_item_row_toggle = {
						name = "tnt_row_marriage_r"
						layoutpolicy_horizontal = expanding
						### SUPERSEDED BY tnt_mutual_marriage IN THE CENTRE COLUMN - see the
						### note on the left-hand twin. Switched off, not yet deleted.
						visible = no

						blockoverride "tnt_row_icon"    { texture = "gfx/interface/icons/character_interactions/icon_marriage.dds" }
						blockoverride "tnt_row_name"    { text = "tnt_item_marriage" }
						blockoverride "tnt_row_tooltip" { tooltip = "tnt_item_marriage_desc" }
						blockoverride "tnt_row_sub"
						{
							visible = "[TntAny('tnt_wed_list')]"
							text = "tnt_wed_count"
							default_format = "#high"
						}
						blockoverride "tnt_toggle_extra"
						{
							widget = {
								name = "tnt_marriage_edit_holder_r"
								size = { 32 100% }

								button_round = {
									name = "tnt_marriage_edit_r"
									size = { 28 28 }
									parentanchor = center
									tooltip = "tnt_btn_edit_marriage"
									using = tooltip_es
									onclick = "[TntExec('tnt_pick_marriage_open')]"

									icon = {
										name = "tnt_marriage_edit_icon_r"
										size = { 20 20 }
										parentanchor = center
										texture = "gfx/interface/icons/character_interactions/icon_marriage.dds"
										alwaystransparent = yes
									}
								}
							}
						}
						blockoverride "tnt_toggle_sgui"    { onclick = "[TntExec('tnt_marriage_r_toggle')]" }
						blockoverride "tnt_toggle_var"     { checked = "[TntOn('tnt_marriage_r')]" }
						blockoverride "tnt_toggle_enabled" { enabled = "[TntValid('tnt_marriage_r_toggle')]" }
						blockoverride "tnt_toggle_tooltip" { tooltip = "[TntTip('tnt_marriage_r_toggle')]" }
					}

					### 6 - CEDE TITLES (item 2.2, MULTI-SELECT - see the _p twin)
					tnt_item_row_picker = {
						name = "tnt_row_title_r"
						blockoverride "tnt_row_interest" {
							tnt_interest_badge = {
								blockoverride "tnt_interest_state" { visible = "[TntPos('tnt_interests_enabled_value')]" }
								blockoverride "tnt_interest_value" { fontcolor = "[TntInterestColor('tnt_interest_title_r_badge_percent_value')]" raw_text = "[TntSV('tnt_interest_title_r_badge_percent_value')|0]%" }
								blockoverride "tnt_interest_tooltip" {
									tooltipwidget = {
										tnt_interest_tooltip = {
											blockoverride "tnt_interest_heading" { text = "tnt_interest_surrender" }
											blockoverride "tnt_interest_detail" { visible = "[TntPos('tnt_interest_title_r_selected_value')]" raw_text = "[Localize('tnt_item_title')]: [TntSV('tnt_count_sel_title_r_value')|0]" }
											blockoverride "tnt_interest_empty_state" { visible = "[Not( TntPos('tnt_interest_title_r_selected_value') )]" text = "tnt_interest_preview_context" }
											blockoverride "tnt_interest_preview_breakdown" { visible = "[Not( TntPos('tnt_interest_title_r_selected_value') )]" datacontext = "[TntBreakdown('tnt_interest_title_r_preview_percent_value')]" }
											blockoverride "tnt_interest_breakdown" { visible = "[TntPos('tnt_interest_title_r_selected_value')]" datacontext = "[TntBreakdown('tnt_interest_title_r_percent_value')]" }
											blockoverride "tnt_interest_points" { visible = "[TntPos('tnt_interest_title_r_selected_value')]" }
											blockoverride "tnt_interest_points_effective" { raw_text = "[Localize('tnt_interest_effective_percent')]: [TntSV('tnt_interest_title_r_display_percent_value')|2]%" }
											blockoverride "tnt_interest_points_base" { raw_text = "[Localize('tnt_interest_base_points')]: [TntSV('tnt_interest_title_r_base_value')|3]" }
											blockoverride "tnt_interest_points_adjusted" { raw_text = "[Localize('tnt_interest_adjusted_points')]: [TntSV('tnt_interest_title_r_adjusted_value')|3]" }
										}
									}
								}
