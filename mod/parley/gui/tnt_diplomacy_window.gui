					####################################################################
					### RETIRED - THE PRISONER TERMS ("Osvobozhdenie plennikov" and
					### "Osvobodit vybrannykh").  USER ITEM 7.
					###
					### The mechanic was BUILT, SHIPPED AND PLAYED: an all-or-nothing release toggle
					### on both columns, a read-only dungeon panel per side at overlay index 8, a
					### per-captive selection list on the player's side at index 13 with a rank
					### ladder for a price, an apply leg that re-tested its filter at signing time,
					### and an AI archetype that wrote a ransom letter when the player held the AI's
					### own kin. It was CONSIDERED AND WITHDRAWN FOR AN INDEFINITE PERIOD on the
					### user's ruling.
					###
					### WHY IT IS NOT SIMPLY DELETED, AND WHAT A REVIVAL MUST DO DIFFERENTLY:
					### DOING PRISONERS PROPERLY MEANS LEANING ON THE VANILLA PRISONER SYSTEM RATHER
					### THAN ON THIS MOD'S OWN BOOKKEEPING. Vanilla already owns imprisonment end to
					### end - the prison type, ransom_cost_value and the ransom interactions, the
					### imprisonment reasons, the release and execution on_actions, and the opinion
					### and hook consequences each of them carries. This mod duplicated only the
					### parts it could see: a private relevance filter, a private rank ladder, a
					### private release loop and a private candidate list, none of which knew what
					### vanilla charges for the same man or what vanilla does to the jailer
					### afterwards. That divergence is why the term never read as diplomacy and never
					### felt worth its price. A revival should PRICE AND EXECUTE THROUGH VANILLA'S
					### OWN RANSOM PATH and let this window merely place that interaction on the
					### table.
					###
					### NOTHING IS DELETED. The code stays readable behind these comments so the
					### decision is legible and the mechanic can be revived without re-deriving it.
					### DO NOT RE-ENABLE ONE HALF: a .gui row and its scripted_gui go together.
					###
					### Overlay indices 8 and 13 are RETIRED, not free - and index 13 side 1, once
					### reserved for a partner-side captive panel, is released with them.
					### Full tombstone: common\scripted_effects\tnt_32_apply.txt.
					####################################################################
#					### 8 - RELEASE PRISONERS.
#					###     D3: v1 hung a container off this row's tooltip block
#					###     and the composition was illegal. The list is now a
#					###     normal panel at overlay index 8, opened by the small
#					###     round button in the row's extra control slot, and the
#					###     hover tooltip that remains is the FIXED
#					###     flowcontainer-based tnt_prisoner_list_tooltip.
#					###     The column's datacontext (the jailer) feeds both.
#					tnt_item_row_toggle = {
#						name = "tnt_row_prisoners_p"
#						layoutpolicy_horizontal = expanding
#						visible = "[TntRow('tnt_show_prisoners_p')]"
#
#						blockoverride "tnt_row_icon"    { texture = "gfx/interface/icons/character_interactions/prison.dds" }
#						blockoverride "tnt_row_name"    { text = "tnt_item_prisoners" }
#						blockoverride "tnt_row_tooltip"
#						{
#							tooltipwidget = {
#								tnt_prisoner_list_tooltip = {
#									blockoverride "tnt_prisoner_tooltip_header"
#									{
#										text = "tnt_item_prisoners_desc"
#									}
#								}
#							}
#						}
#						blockoverride "tnt_toggle_extra"
#						{
#							widget = {
#								name = "tnt_prisoners_view_holder_p"
#								size = { 32 100% }
#
#								button_round = {
#									name = "tnt_prisoners_view_p"
#									size = { 28 28 }
#									parentanchor = center
#									tooltip = "tnt_btn_view"
#									using = tooltip_es
#									onclick = "[TntExec('tnt_pick_prisoners_p_open')]"
#
#									icon = {
#										name = "tnt_prisoners_view_icon_p"
#										size = { 20 20 }
#										parentanchor = center
#										texture = "gfx/interface/icons/character_interactions/prison.dds"
#										alwaystransparent = yes
#									}
#								}
#							}
#						}
#						blockoverride "tnt_toggle_sgui" { onclick = "[TntExec('tnt_prisoners_p_toggle')]" }
#						blockoverride "tnt_toggle_var"  { checked = "[TntOn('tnt_prisoners_p')]" }
#					}

					####################################################################
					### RETIRED WITH THE PRISONER TERMS - USER ITEM 7. Built, shipped and played;
					### considered and WITHDRAWN FOR AN INDEFINITE PERIOD on the user's ruling. A
					### revival must lean on the VANILLA PRISONER SYSTEM (ransom_cost_value, the
					### ransom interactions, the release on_actions and the opinion/hook consequences
					### they carry) instead of this mod's private bookkeeping. Nothing is deleted;
					### do not re-enable one half. Full tombstone: the prisoners row earlier in this
					### file, and common\scripted_effects\tnt_32_apply.txt.
					####################################################################
#					### V4 ITEM A1: RELEASE CHOSEN CAPTIVES, beside the all-or-nothing row above.
#					###
#					### TWO ROWS AND NOT ONE, deliberately. The flag row opens the whole dungeon
#					### in one click and is what the AI writes into an offer; this row hands the
#					### player a list. They cannot double-count: tnt_val_prisoners_p_value stands
#					### down whenever this selection is non-empty (tnt_50_values.txt).
#					###
#					### The shape is tnt_item_row_picker, identical to titles, claims and
#					### artifacts - open when nothing is chosen, a count badge that reopens the
#					### panel when something is, and a clear control. Nothing about captives
#					### needed a new widget.
#					tnt_item_row_picker = {
#						name = "tnt_row_prisoner_multi_p"
#						layoutpolicy_horizontal = expanding
#						visible = "[TntRow('tnt_show_prisoners_p')]"
#
#						blockoverride "tnt_row_icon"    { texture = "gfx/interface/icons/character_interactions/prison.dds" }
#						blockoverride "tnt_row_name"    { text = "tnt_item_prisoner_multi" }
#						blockoverride "tnt_row_tooltip" { tooltip = "tnt_item_prisoner_multi_desc" }
#						blockoverride "tnt_picker_label"
#						{
#							visible = "[TntAny('tnt_sel_prisoner_p')]"
#							text = "tnt_multi_count_prisoner_p"
#						}
#
#						blockoverride "tnt_picker_content"
#						{
#							tnt_chosen_count = {
#								name = "tnt_chosen_prisoner_p"
#
#								blockoverride "tnt_chosen_visible"     { visible = "[TntAny('tnt_sel_prisoner_p')]" }
#								blockoverride "tnt_chosen_click"       { onclick = "[TntExec('tnt_multi_prisoner_p_open')]" }
#								blockoverride "tnt_chosen_tooltip"     { tooltip = "tnt_btn_change" }
#								blockoverride "tnt_chosen_count_label" { text = "[TntSV('tnt_count_sel_prisoner_p_value')|0]" }
#							}
#						}
#
#						blockoverride "tnt_picker_open_state"  { visible = "[TntNone('tnt_sel_prisoner_p')]" }
#						blockoverride "tnt_picker_clear_state" { visible = "[TntAny('tnt_sel_prisoner_p')]" }
#						blockoverride "tnt_picker_open_sgui"   { onclick = "[TntExec('tnt_multi_prisoner_p_open')]" }
#						blockoverride "tnt_picker_clear_sgui"  { onclick = "[TntExec('tnt_sel_prisoner_p_clear')]" }
#					}

					### 9 - HOOK, BY TIER (item 2.3, BUILD 2).
					###
					###     tnt_hook_p stopped being a 0/1 flag and became a TIER
					###     INDEX 0..3 - 0 none, 1 favour, 2 strong, 3 eternal
					###     (30-V2-DESIGN 3.2, and W-12 there lists every reader
					###     that had to move with it). A checkbox cannot express
					###     four states, so the row type changed from
					###     tnt_item_row_toggle to tnt_item_row_hook and the control
					###     slot hosts tnt_control_hook_tier.
					###
					###     THE TWO SCRIPTED GUIS. onclick keeps the SHIPPED name
					###     tnt_hook_p_toggle, whose body the sgui author turns from
					###     a 0/1 flip into a tier step; onrightclick is the new
					###     tnt_hook_p_toggle_back. Reusing the existing name for the
					###     forward direction is deliberate insurance: if the
					###     reverse-cycle gui is late, only right-click is dead and
					###     the row still works. "cycle on click, reverse on
					###     right-click" is the design's own wording (30-V2-DESIGN
					###     3.2 table).
					###
					###     BOTH SIDES OVERRIDE THE BUTTONS BLOCK, INCLUDING THIS ONE,
					###     even though tnt_control_hook_tier's own defaults already
					###     ARE the _p side. That is belt and braces, not a
					###     necessity: those defaults (tnt_panel_contract.gui:176-179)
					###     name tnt_hook_p_toggle and tnt_hook_p_toggle_back, the
					###     same pair written here, and they are correct.
					###     CORRECTED IN BUILD 3 - this note used to claim the
					###     defaults named tnt_hook_p_tier_next / _prev and that
					###     "NEITHER EXISTS". The claim was about a stale COMMENT in
					###     that file, not about its code; the code was always right.
					###     The two names are tnt_hook_p_toggle
					###     (tnt_20_scripted_guis.txt, forward) and
					###     tnt_hook_p_toggle_back (tnt_22c_hooks_contracts.txt:123,
					###     reverse).
					###     `enabled` IS written, on the forward gui. As of build 3
					###     tnt_hook_p_toggle carries an is_valid whose one row is
					###     `tnt_hook_free_p_value > 0`, so this line is now what
					###     greys the control - and its tooltip is what tells the
					###     player why - when the receiver already holds a hook over
					###     the giver. tnt_hook_p_toggle_back deliberately has no
					###     is_valid: taking a term OFF the table must never be
					###     refused.
					###
					###     `tooltip` is NOT taken from TntTip, and that is the one
					###     compromise in this row. The type declares
					###     tnt_hook_tier_tooltip AFTER tnt_hook_tier_buttons, so a
					###     dynamic tooltip written in the buttons block would be
					###     overwritten by the static key anyway; and a BuildTooltip
					###     that is empty whenever nothing is wrong would leave a
					###     novel cycling control with no explanation of its two mouse
					###     buttons at all. The static tnt_stepper_hook_tt therefore
					###     stays, and the loc author is asked to name the single
					###     reason a raise can fail inside it.
					###
					###     `parentanchor` + `position` on tnt_control_hook_tier are
					###     LEGAL here: the block they land in is declared inside the
					###     plain `widget "tnt_hook_slot"` of tnt_item_row_hook, and
					###     a plain widget arranges nothing. Identical mechanism to
					###     the eight tnt_stepper_full instantiations, and the
					###     layout scanner buckets it the same way
					###     (60-BUILD2-REPORT section 2 R-5).
					tnt_item_row_hook = {
						name = "tnt_row_hook_p"
						blockoverride "tnt_row_interest" {
							tnt_interest_badge = {
								blockoverride "tnt_interest_state" { visible = "[TntPos('tnt_interests_enabled_value')]" }
								blockoverride "tnt_interest_value" { fontcolor = "[TntInterestColor('tnt_interest_hook_p_badge_percent_value')]" raw_text = "[TntSV('tnt_interest_hook_p_badge_percent_value')|0]%" }
								blockoverride "tnt_interest_tooltip" {
									tooltipwidget = {
										tnt_interest_tooltip = {
											blockoverride "tnt_interest_heading" { text = "tnt_interest_receive" }
											blockoverride "tnt_interest_detail" { text = "tnt_item_hook" }
											blockoverride "tnt_interest_empty_state" { visible = "[Not( TntPos('tnt_interest_hook_p_selected_value') )]" text = "tnt_interest_preview_context" }
											blockoverride "tnt_interest_preview_breakdown" { visible = "[Not( TntPos('tnt_interest_hook_p_selected_value') )]" datacontext = "[TntBreakdown('tnt_interest_hook_p_preview_percent_value')]" }
											blockoverride "tnt_interest_breakdown" { visible = "[TntPos('tnt_interest_hook_p_selected_value')]" datacontext = "[TntBreakdown('tnt_interest_hook_p_percent_value')]" }
											blockoverride "tnt_interest_points" { visible = "[TntPos('tnt_interest_hook_p_selected_value')]" }
											blockoverride "tnt_interest_points_effective" { raw_text = "[Localize('tnt_interest_effective_percent')]: [TntSV('tnt_interest_hook_p_display_percent_value')|2]%" }
											blockoverride "tnt_interest_points_base" { raw_text = "[Localize('tnt_interest_base_points')]: [TntSV('tnt_interest_hook_p_base_value')|3]" }
											blockoverride "tnt_interest_points_adjusted" { raw_text = "[Localize('tnt_interest_adjusted_points')]: [TntSV('tnt_interest_hook_p_adjusted_value')|3]" }
										}
									}
								}
							}
						}
						layoutpolicy_horizontal = expanding
						visible = "[TntRow('tnt_show_hook_p')]"

						blockoverride "tnt_row_icon"    { texture = "gfx/interface/icons/character_interactions/hook_icon.dds" }
						blockoverride "tnt_row_name"    { text = "tnt_item_hook" }
						blockoverride "tnt_row_tooltip" { tooltip = "tnt_item_hook_desc" }

						blockoverride "tnt_hook_control_block"
						{
							tnt_control_hook_tier = {
								name = "tnt_hook_tier_p"
								parentanchor = vcenter|right
								position = { -8 0 }

								### `down` sits pressed for tiers 1..3 and up for 0,
								### so the row shows "there is a hook on the table"
								### without the player reading the label.
								blockoverride "tnt_hook_tier_buttons"
								{
									onclick      = "[TntExec('tnt_hook_p_toggle')]"
									onrightclick = "[TntExec('tnt_hook_p_toggle_back')]"
									enabled      = "[TntValid('tnt_hook_p_toggle')]"
									down         = "[TntOn('tnt_hook_p')]"
								}

								blockoverride "tnt_hook_tier_label"
								{
									text = "[TntHookTier('tnt_hook_p')]"
								}
							}
						}
					}

					### 10 - ARTIFACTS (item 2.2, MULTI-SELECT).
					###      ITEM 3.3, the row the user named first, DID lose its
					###      button_artifact filled state, and this is the one place
					###      build 2 trades a build-1 feature away. The reason is
					###      arithmetic: button_artifact renders ONE artifact's icon
					###      in ONE rarity frame from a single Artifact datacontext,
					###      and a term that can hold three artifacts has no single
					###      Artifact to hand it. The count badge replaces it, and
					###      every artifact's real icon and rarity is still on screen
					###      in the panel at index 10 and named in the deal sheet.
					###      tnt_chosen_artifact stays DEFINED in tnt_panels.gui: if
					###      the user prefers single-select artifacts, reverting this
					###      one row needs no new code.
					tnt_item_row_picker = {
						name = "tnt_row_artifact_p"
						blockoverride "tnt_row_interest" {
							tnt_interest_badge = {
								blockoverride "tnt_interest_state" { visible = "[TntPos('tnt_interests_enabled_value')]" }
								blockoverride "tnt_interest_value" { fontcolor = "[TntInterestColor('tnt_interest_artifact_p_badge_percent_value')]" raw_text = "[TntSV('tnt_interest_artifact_p_badge_percent_value')|0]%" }
								blockoverride "tnt_interest_tooltip" {
									tooltipwidget = {
										tnt_interest_tooltip = {
											blockoverride "tnt_interest_heading" { text = "tnt_interest_receive" }
											blockoverride "tnt_interest_detail" { visible = "[TntPos('tnt_interest_artifact_p_selected_value')]" raw_text = "[Localize('tnt_item_artifact')]: [TntSV('tnt_count_sel_artifact_p_value')|0]" }
											blockoverride "tnt_interest_empty_state" { visible = "[Not( TntPos('tnt_interest_artifact_p_selected_value') )]" text = "tnt_interest_preview_context" }
											blockoverride "tnt_interest_preview_breakdown" { visible = "[Not( TntPos('tnt_interest_artifact_p_selected_value') )]" datacontext = "[TntBreakdown('tnt_interest_artifact_p_preview_percent_value')]" }
											blockoverride "tnt_interest_breakdown" { visible = "[TntPos('tnt_interest_artifact_p_selected_value')]" datacontext = "[TntBreakdown('tnt_interest_artifact_p_percent_value')]" }
											blockoverride "tnt_interest_points" { visible = "[TntPos('tnt_interest_artifact_p_selected_value')]" }
											blockoverride "tnt_interest_points_effective" { raw_text = "[Localize('tnt_interest_effective_percent')]: [TntSV('tnt_interest_artifact_p_display_percent_value')|2]%" }
											blockoverride "tnt_interest_points_base" { raw_text = "[Localize('tnt_interest_base_points')]: [TntSV('tnt_interest_artifact_p_base_value')|3]" }
											blockoverride "tnt_interest_points_adjusted" { raw_text = "[Localize('tnt_interest_adjusted_points')]: [TntSV('tnt_interest_artifact_p_adjusted_value')|3]" }
										}
									}
								}
							}
						}
						layoutpolicy_horizontal = expanding
						visible = "[TntRow('tnt_show_artifact_p')]"

						blockoverride "tnt_row_icon"    { texture = "gfx/interface/icons/character_interactions/artifact.dds" }
						blockoverride "tnt_row_name"    { text = "tnt_item_artifact" }
						blockoverride "tnt_row_tooltip" { tooltip = "tnt_item_artifact_desc" }
						blockoverride "tnt_picker_label"
						{
							visible = "[TntAny('tnt_sel_artifact_p')]"
							text = "tnt_multi_count_artifact_p"
						}

						blockoverride "tnt_picker_content"
						{
							tnt_chosen_count = {
								name = "tnt_chosen_artifact_p"

								blockoverride "tnt_chosen_visible"     { visible = "[TntAny('tnt_sel_artifact_p')]" }
								blockoverride "tnt_chosen_click"       { onclick = "[TntExec('tnt_multi_artifact_p_open')]" }
								blockoverride "tnt_chosen_tooltip"     { tooltip = "tnt_btn_change" }
								blockoverride "tnt_chosen_count_label" { text = "[TntSV('tnt_count_sel_artifact_p_value')|0]" }
							}
						}

						blockoverride "tnt_picker_open_state"  { visible = "[TntNone('tnt_sel_artifact_p')]" }
						blockoverride "tnt_picker_clear_state" { visible = "[TntAny('tnt_sel_artifact_p')]" }
						blockoverride "tnt_picker_open_sgui"   { onclick = "[TntExec('tnt_multi_artifact_p_open')]" }
						blockoverride "tnt_picker_clear_sgui"  { onclick = "[TntExec('tnt_sel_artifact_p_clear')]" }
					}

					####################################################################
					### RETIRED - THE THIRD-PARTY NON-AGGRESSION PROMISE
					### ("Obeshchanie ne napadat").  USER ITEM 1.
					###
					### The mechanic was BUILT, SHIPPED AND PLAYED: a one-sided ten-year truce sworn
					### to a third ruler, a per-side candidate list built from realm neighbours and
					### the holders of claimed titles, a picker in BOTH columns, a price, an apply
					### leg, and a yearly GC for the permanent record it left behind. It was
					### CONSIDERED AND WITHDRAWN FOR AN INDEFINITE PERIOD on the user's ruling: for
					### pleasant play it is surplus - a term about somebody who is not at the table,
					### for which the other side owes nothing in return.
					###
					### NOTHING IS DELETED. The code stays readable behind these comments so the
					### decision is legible and the mechanic can be revived without re-deriving it.
					### DO NOT RE-ENABLE ONE HALF: a .gui row and its scripted_gui go together, and a
					### gate-write line and its gate trigger are a single atomic pair.
					###
					### STILL LIVE ON PURPOSE: the old-save sweeps and the loc key tnt_truce_nonwar,
					### which names truces still running in pre-retirement saves. *** NOT
					### tnt_nonwar_promises: its sweeper tnt_gc_promises_effect is RETIRED (V12), so
					### that name is inert residue in old saves rather than something swept. 08-24 ***
					### Overlay index 11 is RETIRED, not free: never renumbered, never reused.
					### Full tombstone: common\scripted_effects\tnt_32_apply.txt.
					####################################################################
#					### 11 - PROMISE NOT TO ATTACK (picker over a shared candidate list)
#					###      ITEM 3.3, the second row the user named: the filled
#					###      state is the third party's own portrait.
#					###      STILL SINGLE-SELECT, on purpose: 30-V2-DESIGN 3.1 lists
#					###      exactly six variables to delete and tnt_nonwar_p/_r are
#					###      not among them, so this row keeps its portrait control.
#					tnt_item_row_picker = {
#						name = "tnt_row_nonwar_p"
#						layoutpolicy_horizontal = expanding
#						visible = "[TntRow('tnt_show_nonwar_p')]"
#
#						blockoverride "tnt_row_icon"    { texture = "gfx/interface/icons/character_interactions/icon_retreat.dds" }
#						blockoverride "tnt_row_name"    { text = "tnt_item_nonwar" }
#						blockoverride "tnt_row_tooltip" { tooltip = "tnt_item_nonwar_desc" }
#						blockoverride "tnt_picker_label"
#						{
#							visible = "[TntVar('tnt_nonwar_p').Char.IsValid]"
#							text = "[TntVar('tnt_nonwar_p').Char.GetUINameNoTooltip]"
#						}
#
#						blockoverride "tnt_picker_content"
#						{
#							tnt_chosen_char = {
#								name = "tnt_chosen_nonwar_p"
#
#								blockoverride "tnt_chosen_visible" { visible = "[TntVar('tnt_nonwar_p').Char.IsValid]" }
#								blockoverride "tnt_chosen_context" { datacontext = "[TntVar('tnt_nonwar_p').Char]" }
#								blockoverride "tnt_chosen_click"   { onclick = "[TntExec('tnt_pick_nonwar_p_open')]" }
#								blockoverride "tnt_chosen_tooltip" { tooltip = "tnt_btn_change" }
#							}
#						}
#
#						blockoverride "tnt_picker_open_state"  { visible = "[Not( TntVar('tnt_nonwar_p').Char.IsValid )]" }
#						blockoverride "tnt_picker_clear_state" { visible = "[TntVar('tnt_nonwar_p').Char.IsValid]" }
#						blockoverride "tnt_picker_open_sgui"   { onclick = "[TntExec('tnt_pick_nonwar_p_open')]" }
#						blockoverride "tnt_picker_clear_sgui"  { onclick = "[TntExec('tnt_nonwar_p_clear')]" }
#					}

					### 12 - SWEAR FEALTY (item 2.5, game-rule gated). On this side it
					###      means "I become your vassal", and the round button in the
					###      extra slot opens the nine-row obligation sheet at overlay
					###      index 12 (tnt_panel_contract).
					###
					###      ONE PANEL, TWO ROWS, ONE OPENER. The nine tnt_ob_*
					###      variables carry NO side suffix, because T11 already
					###      forbids both sides swearing fealty in one deal
					###      (30-V2-DESIGN 1 row 2.5), so there is only ever one
					###      contract to edit and nothing per-side to open.
					tnt_item_row_toggle = {
						name = "tnt_row_vassal_p"
						blockoverride "tnt_row_interest" {
							tnt_interest_badge = {
								blockoverride "tnt_interest_state" { visible = "[TntPos('tnt_interests_enabled_value')]" }
								blockoverride "tnt_interest_value" { fontcolor = "[TntInterestColor('tnt_interest_vassal_p_badge_percent_value')]" raw_text = "[TntSV('tnt_interest_vassal_p_badge_percent_value')|0]%" }
								blockoverride "tnt_interest_tooltip" {
									tooltipwidget = {
										tnt_interest_tooltip = {
											blockoverride "tnt_interest_heading" { text = "tnt_interest_receive" }
											blockoverride "tnt_interest_detail" { text = "tnt_item_vassal" }
											blockoverride "tnt_interest_empty_state" { visible = "[Not( TntPos('tnt_interest_vassal_p_selected_value') )]" text = "tnt_interest_preview_context" }
											blockoverride "tnt_interest_preview_breakdown" { visible = "[Not( TntPos('tnt_interest_vassal_p_selected_value') )]" datacontext = "[TntBreakdown('tnt_interest_vassal_p_preview_percent_value')]" }
											blockoverride "tnt_interest_breakdown" { visible = "[TntPos('tnt_interest_vassal_p_selected_value')]" datacontext = "[TntBreakdown('tnt_interest_vassal_p_percent_value')]" }
											blockoverride "tnt_interest_points" { visible = "[TntPos('tnt_interest_vassal_p_selected_value')]" }
											blockoverride "tnt_interest_points_effective" { raw_text = "[Localize('tnt_interest_effective_percent')]: [TntSV('tnt_interest_vassal_p_display_percent_value')|2]%" }
											blockoverride "tnt_interest_points_base" { raw_text = "[Localize('tnt_interest_base_points')]: [TntSV('tnt_interest_vassal_p_base_value')|3]" }
											blockoverride "tnt_interest_points_adjusted" { raw_text = "[Localize('tnt_interest_adjusted_points')]: [TntSV('tnt_interest_vassal_p_adjusted_value')|3]" }
										}
									}
								}
							}
						}
						layoutpolicy_horizontal = expanding
						visible = "[And( TntRow('tnt_show_vassal_p'), TntOn('tnt_advanced') )]"

						blockoverride "tnt_row_icon"    { texture = "gfx/interface/icons/character_interactions/icon_vassal.dds" }
						blockoverride "tnt_row_name"    { text = "tnt_item_vassal" }
						blockoverride "tnt_row_tooltip" { tooltip = "tnt_item_vassal_desc" }
						blockoverride "tnt_toggle_extra"
						{
							widget = {
								name = "tnt_contract_edit_holder_p"
								size = { 32 100% }

								button_round = {
									name = "tnt_contract_edit_p"
									size = { 28 28 }
									parentanchor = center
									tooltip = "tnt_btn_edit_contract"
									using = tooltip_es
									onclick = "[TntExec('tnt_pick_contract_open')]"

									icon = {
										name = "tnt_contract_edit_icon_p"
										size = { 20 20 }
										parentanchor = center
										texture = "gfx/interface/icons/character_interactions/icon_vassal.dds"
										alwaystransparent = yes
									}
								}
							}
						}
						blockoverride "tnt_toggle_sgui"    { onclick = "[TntExec('tnt_vassal_p_toggle')]" }
						blockoverride "tnt_toggle_var"     { checked = "[TntOn('tnt_vassal_p')]" }
						blockoverride "tnt_toggle_enabled" { enabled = "[TntValid('tnt_vassal_p_toggle')]" }
						blockoverride "tnt_toggle_tooltip" { tooltip = "[TntTip('tnt_vassal_p_toggle')]" }
					}

					####################################################
					### ITEM 19 - THE FOUR PEOPLE TERMS.
					###
					### They sit here, at the bottom of the column and directly under
					### fealty, because that is where the eye leaves off: the rows above
					### hand over things, these four hand over PEOPLE, and independence
					### is the exact inverse of the fealty row it follows. The deal
					### sheet in gui/tnt_panels.gui repeats this order, so a term can
					### still be tracked from the column it was set in down to the
					### sheet.
					###
					### TWO OF THEM OPEN A PANEL IN gui/tnt_panel_people.gui at the
					### overlay indices the contract froze - 16 hostage and 18
					### courtier - and independence opens nothing at all, because a
					### bool pair needs only a checkbox and a gate. Index 17 was the
					### ward, RETIRED V16 user item 5; it is dormant, not free.
					###
					### EVERY `enabled` + `tooltip` PAIR BELOW IS THE VANILLA TRIPLE
					### (enabled = IsValid / onclick = Execute / tooltip = BuildTooltip
					### on ONE widget, GAME\gui\window_faith.gui:900-902). If a scripted
					### gui named here turns out to carry no is_valid, both halves
					### degrade to exactly what writing nothing would have given -
					### always enabled, empty tooltip - which is why the pair is written
					### even where the gating author's is_valid is not yet on disk.
					####################################################

					### 12b - GRANT INDEPENDENCE. NO overlay index, by the contract.
					###
					###      _p MEANS THE PLAYER RELEASES HIS OWN VASSAL, and that
					###      direction is fixed by the contract (section 1.B) because it
					###      is the direction tnt_val_indep_p_value prices. It may not be
					###      inverted here: this column is what the PLAYER gives, and
					###      what he gives is a vassal's freedom.
					###
					###      It cannot appear in the same treaty as the fealty row above
					###      - tnt_no_indep_and_vassal_trigger forbids the pair - and the
					###      checkbox's own tooltip is where that refusal is explained,
					###      which is why the enabled+tooltip pair is not optional on
					###      this row.
					###
					###      Icon verified on disk and in use: vanilla's own
					###      grant_independence_interaction carries `icon = independence`
					###      (GAME\common\character_interactions\00_character_interactions.txt:2136),
					###      i.e. gfx/interface/icons/character_interactions/independence.dds.
					tnt_item_row_toggle = {
						name = "tnt_row_indep_p"
						blockoverride "tnt_row_interest" {
							tnt_interest_badge = {
								blockoverride "tnt_interest_state" { visible = "[TntPos('tnt_interests_enabled_value')]" }
								blockoverride "tnt_interest_value" { fontcolor = "[TntInterestColor('tnt_interest_indep_p_badge_percent_value')]" raw_text = "[TntSV('tnt_interest_indep_p_badge_percent_value')|0]%" }
								blockoverride "tnt_interest_tooltip" {
									tooltipwidget = {
										tnt_interest_tooltip = {
											blockoverride "tnt_interest_heading" { text = "tnt_interest_receive" }
											blockoverride "tnt_interest_detail" { text = "tnt_item_indep" }
											blockoverride "tnt_interest_empty_state" { visible = "[Not( TntPos('tnt_interest_indep_p_selected_value') )]" text = "tnt_interest_preview_context" }
											blockoverride "tnt_interest_preview_breakdown" { visible = "[Not( TntPos('tnt_interest_indep_p_selected_value') )]" datacontext = "[TntBreakdown('tnt_interest_indep_p_preview_percent_value')]" }
											blockoverride "tnt_interest_breakdown" { visible = "[TntPos('tnt_interest_indep_p_selected_value')]" datacontext = "[TntBreakdown('tnt_interest_indep_p_percent_value')]" }
											blockoverride "tnt_interest_points" { visible = "[TntPos('tnt_interest_indep_p_selected_value')]" }
											blockoverride "tnt_interest_points_effective" { raw_text = "[Localize('tnt_interest_effective_percent')]: [TntSV('tnt_interest_indep_p_display_percent_value')|2]%" }
											blockoverride "tnt_interest_points_base" { raw_text = "[Localize('tnt_interest_base_points')]: [TntSV('tnt_interest_indep_p_base_value')|3]" }
											blockoverride "tnt_interest_points_adjusted" { raw_text = "[Localize('tnt_interest_adjusted_points')]: [TntSV('tnt_interest_indep_p_adjusted_value')|3]" }
										}
									}
								}
							}
						}
						layoutpolicy_horizontal = expanding
						### V19: THE tnt_advanced CONJUNCT WAS MISSING HERE AND ON THE _r ROW.
						### tnt_rule_conformance.ps1 reported both as its only two FAILs for
						### several rounds - "the rule blocks the term without hiding it". With
						### tnt_advanced_terms off the row stayed on screen while the term was
						### refused, which is a control that does nothing, and the .gui cannot
						### ask has_game_rule itself: the raw-variable conjunct IS how every
						### other gated row does it (title_p :842, vassal_p :1311, marriage_p
						### :2020, title_r :2290, vassal_r :2546 - five call sites, one shape).
						visible = "[And( TntRow('tnt_show_indep_p'), TntOn('tnt_advanced') )]"

						blockoverride "tnt_row_icon"    { texture = "gfx/interface/icons/character_interactions/independence.dds" }
						blockoverride "tnt_row_name"    { text = "tnt_item_indep" }
						blockoverride "tnt_row_tooltip" { tooltip = "tnt_item_indep_desc" }
						blockoverride "tnt_toggle_sgui"    { onclick = "[TntExec('tnt_indep_p_toggle')]" }
						blockoverride "tnt_toggle_var"     { checked = "[TntOn('tnt_indep_p')]" }
						### THE enabled BINDING IS UNCHANGED BUT NO LONGER HOT: the
						### is_valid behind TntValid used to run an any_vassal_or_below
						### walk per layout pass and produced ALL 85,778 script errors
						### of the fresh playtest log; it now reads var:tnt_indep_ok_p,
						### the answer E33 caches once per open/refresh
						### (tnt_30_effects.txt), so this line costs a map lookup.
						blockoverride "tnt_toggle_enabled" { enabled = "[TntValid('tnt_indep_p_toggle')]" }
						blockoverride "tnt_toggle_tooltip" { tooltip = "[TntTip('tnt_indep_p_toggle')]" }
					}

					### 16 - HOSTAGES (single character, panel at overlay index 16)
					###
					###      SINGLE-SELECT, so the filled state is the hostage's own head
					###      (tnt_chosen_char) and not a count badge - the same shape and
					###      the same reasoning as the promise-not-to-attack row above,
					###      which is this window's other one-character term.
					###
					###      Icon: vanilla's hostage family uses `icon = icon_hostage`
					###      (GAME\common\character_interactions\05_bp2_interactions.txt:15)
					###      and the file is drawn as a plain texture at
					###      GAME\gui\window_war_overview.gui:3127.
					tnt_item_row_picker = {
						name = "tnt_row_hostage_p"
						blockoverride "tnt_row_interest" {
							tnt_interest_badge = {
								blockoverride "tnt_interest_state" { visible = "[TntPos('tnt_interests_enabled_value')]" }
								blockoverride "tnt_interest_value" { fontcolor = "[TntInterestColor('tnt_interest_hostage_p_badge_percent_value')]" raw_text = "[TntSV('tnt_interest_hostage_p_badge_percent_value')|0]%" }
								blockoverride "tnt_interest_tooltip" {
									tooltipwidget = {
										tnt_interest_tooltip = {
											blockoverride "tnt_interest_heading" { text = "tnt_interest_receive" }
											blockoverride "tnt_interest_detail" { visible = "[TntPos('tnt_interest_hostage_p_selected_value')]" raw_text = "[Localize('tnt_item_hostage')]: [TntVar('tnt_hostage_p').Char.GetUINameNoTooltip]" }
											blockoverride "tnt_interest_empty_state" { visible = "[Not( TntPos('tnt_interest_hostage_p_selected_value') )]" text = "tnt_interest_preview_context" }
											blockoverride "tnt_interest_preview_breakdown" { visible = "[Not( TntPos('tnt_interest_hostage_p_selected_value') )]" datacontext = "[TntBreakdown('tnt_interest_hostage_p_preview_percent_value')]" }
											blockoverride "tnt_interest_breakdown" { visible = "[TntPos('tnt_interest_hostage_p_selected_value')]" datacontext = "[TntBreakdown('tnt_interest_hostage_p_percent_value')]" }
											blockoverride "tnt_interest_points" { visible = "[TntPos('tnt_interest_hostage_p_selected_value')]" }
											blockoverride "tnt_interest_points_effective" { raw_text = "[Localize('tnt_interest_effective_percent')]: [TntSV('tnt_interest_hostage_p_display_percent_value')|2]%" }
											blockoverride "tnt_interest_points_base" { raw_text = "[Localize('tnt_interest_base_points')]: [TntSV('tnt_interest_hostage_p_base_value')|3]" }
											blockoverride "tnt_interest_points_adjusted" { raw_text = "[Localize('tnt_interest_adjusted_points')]: [TntSV('tnt_interest_hostage_p_adjusted_value')|3]" }
										}
									}
								}
							}
						}
						layoutpolicy_horizontal = expanding
						visible = "[TntRow('tnt_show_hostage_p')]"

						blockoverride "tnt_row_icon"    { texture = "gfx/interface/icons/character_interactions/icon_hostage.dds" }
						blockoverride "tnt_row_name"    { text = "tnt_item_hostage" }
						blockoverride "tnt_row_tooltip" { tooltip = "tnt_item_hostage_desc" }
						blockoverride "tnt_picker_label"
						{
							visible = "[TntVar('tnt_hostage_p').Char.IsValid]"
							text = "[TntVar('tnt_hostage_p').Char.GetUINameNoTooltip]"
						}

						blockoverride "tnt_picker_content"
						{
							tnt_chosen_char = {
								name = "tnt_chosen_hostage_p"

								blockoverride "tnt_chosen_visible" { visible = "[TntVar('tnt_hostage_p').Char.IsValid]" }
								blockoverride "tnt_chosen_context" { datacontext = "[TntVar('tnt_hostage_p').Char]" }
								blockoverride "tnt_chosen_click"   { onclick = "[TntExec('tnt_pick_hostage_p_open')]" }
								blockoverride "tnt_chosen_tooltip" { tooltip = "tnt_btn_change" }
							}
						}

						blockoverride "tnt_picker_open_state"   { visible = "[Not( TntVar('tnt_hostage_p').Char.IsValid )]" }
						blockoverride "tnt_picker_clear_state"  { visible = "[TntVar('tnt_hostage_p').Char.IsValid]" }
						blockoverride "tnt_picker_open_sgui"    { onclick = "[TntExec('tnt_pick_hostage_p_open')]" }
						blockoverride "tnt_picker_open_enabled" { enabled = "[TntValid('tnt_pick_hostage_p_open')]" }
						blockoverride "tnt_picker_open_tooltip" { tooltip = "[TntTip('tnt_pick_hostage_p_open')]" }
						blockoverride "tnt_picker_clear_sgui"   { onclick = "[TntExec('tnt_pick_hostage_p_clear')]" }
					}

					####################################################################
					### 17 - WARD / FOSTERAGE.  *** RETIRED V16, USER ITEM 5 ***
					###
					### The row below is commented out, and so is its _r twin in the right
					### column (search tnt_row_ward_r). REASON, in the user's words: the
					### term was too abusable on points, and the hostage row directly
					### above already covers the same immersive ground. The audit agreed
					### and found the abuse STRUCTURAL, not a single number - the full
					### WARD TOMBSTONE with the worked pricing case is in
					### common/scripted_effects/tnt_32_apply.txt.
					###
					### EVERYTHING THIS ROW TOUCHED WENT WITH IT: the gate variable
					### tnt_show_ward_p (write retired at
					### common/scripted_effects/tnt_30_effects.txt:618), the picker panel
					### at overlay index 17 (gui/tnt_panel_people.gui section 2, plus its
					### instantiation further down this file), the two scripted guis
					### tnt_pick_ward_p_open / _clear
					### (common/scripted_guis/tnt_24_people.txt), and the price
					### tnt_val_ward_p_value (common/script_values/tnt_58_person_values.txt
					### section 3).
					###
					### OVERLAY INDEX 17 IS DORMANT, NOT FREE - never reassign it. The
					### retired prisoner picker's index 8 was left dormant the same way
					### (common/scripted_guis/tnt_21_pickers.txt:304).
					###
					### The shared type tnt_item_row_picker STAYS LIVE - the hostage and
					### courtier rows in both columns still derive from it.
					####################################################################
