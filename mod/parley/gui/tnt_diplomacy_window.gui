					### 18 - COURTIER TRANSFER (MULTI-SELECT, panel at overlay index 18)
					###
					###      Same shape as titles, claims, artifacts and captives: a
					###      count badge that reopens the panel, and a clear control.
					###
					###      THE BADGE COUNTS THE LIST IN THE GUI, and it is the only row
					###      in this window that does. Every other multi-select row reads
					###      author:multiselect's tnt_count_sel_<item>_<side>_value, but
					###      the contract registers no count value for courtiers, and
					###      binding a badge to a script value that does not exist logs on
					###      EVERY evaluation. GetDataModelSize over a script variable
					###      list is already shipped and running in this mod
					###      (gui/tnt_panels.gui, tnt_sheet_wed_taper's `visible`), and
					###      vanilla both compares it (GAME\gui\frontend_bookmarks.gui:1679)
					###      and prints it (GAME\gui\debug\window_watch_character_pool.gui:21).
					###      The moment a tnt_count_sel_courtier_<side>_value lands, this
					###      one expression per row is where it goes.
					###
					###      THE OPENER IS tnt_multi_courtier_p_open, NOT
					###      tnt_pick_courtier_p_open, and the difference is not cosmetic:
					###      only the tnt_multi_* opener runs the prune after the fill, so
					###      the already-chosen courtiers leave the available column. The
					###      name is not in the contract's register - see the build report.
					###
					###      Icon: vanilla's offer_courtier_interaction carries
					###      `icon = courtier_interaction`
					###      (GAME\common\character_interactions\00_tributary_interactions.txt:3005).
					tnt_item_row_picker = {
						name = "tnt_row_courtier_p"
						blockoverride "tnt_row_interest" {
							tnt_interest_badge = {
								blockoverride "tnt_interest_state" { visible = "[TntPos('tnt_interests_enabled_value')]" }
								blockoverride "tnt_interest_value" { fontcolor = "[TntInterestColor('tnt_interest_courtier_p_badge_percent_value')]" raw_text = "[TntSV('tnt_interest_courtier_p_badge_percent_value')|0]%" }
								blockoverride "tnt_interest_tooltip" {
									tooltipwidget = {
										tnt_interest_tooltip = {
											blockoverride "tnt_interest_heading" { text = "tnt_interest_receive" }
											blockoverride "tnt_interest_detail" { visible = "[TntPos('tnt_interest_courtier_p_selected_value')]" raw_text = "[Localize('tnt_item_courtier')]: [TntSV('tnt_count_sel_courtier_p_value')|0]" }
											blockoverride "tnt_interest_empty_state" { visible = "[Not( TntPos('tnt_interest_courtier_p_selected_value') )]" text = "tnt_interest_preview_context" }
											blockoverride "tnt_interest_preview_breakdown" { visible = "[Not( TntPos('tnt_interest_courtier_p_selected_value') )]" datacontext = "[TntBreakdown('tnt_interest_courtier_p_preview_percent_value')]" }
											blockoverride "tnt_interest_breakdown" { visible = "[TntPos('tnt_interest_courtier_p_selected_value')]" datacontext = "[TntBreakdown('tnt_interest_courtier_p_percent_value')]" }
											blockoverride "tnt_interest_points" { visible = "[TntPos('tnt_interest_courtier_p_selected_value')]" }
											blockoverride "tnt_interest_points_effective" { raw_text = "[Localize('tnt_interest_effective_percent')]: [TntSV('tnt_interest_courtier_p_display_percent_value')|2]%" }
											blockoverride "tnt_interest_points_base" { raw_text = "[Localize('tnt_interest_base_points')]: [TntSV('tnt_interest_courtier_p_base_value')|3]" }
											blockoverride "tnt_interest_points_adjusted" { raw_text = "[Localize('tnt_interest_adjusted_points')]: [TntSV('tnt_interest_courtier_p_adjusted_value')|3]" }
										}
									}
								}
							}
						}
						layoutpolicy_horizontal = expanding
						visible = "[TntRow('tnt_show_courtier_p')]"

						blockoverride "tnt_row_icon"    { texture = "gfx/interface/icons/character_interactions/courtier_interaction.dds" }
						blockoverride "tnt_row_name"    { text = "tnt_item_courtier" }
						blockoverride "tnt_row_tooltip" { tooltip = "tnt_item_courtier_desc" }
						blockoverride "tnt_picker_label"
						{
							visible = "[TntAny('tnt_sel_courtier_p')]"
							text = "tnt_sel_count_courtier_p"
						}

						blockoverride "tnt_picker_content"
						{
							tnt_chosen_count = {
								name = "tnt_chosen_courtier_p"

								blockoverride "tnt_chosen_visible"     { visible = "[TntAny('tnt_sel_courtier_p')]" }
								blockoverride "tnt_chosen_click"       { onclick = "[TntExec('tnt_multi_courtier_p_open')]" }
								blockoverride "tnt_chosen_tooltip"     { tooltip = "tnt_btn_change" }
								blockoverride "tnt_chosen_count_label" { text = "[GetDataModelSize( TntList('tnt_sel_courtier_p') )]" }
							}
						}

						blockoverride "tnt_picker_open_state"   { visible = "[TntNone('tnt_sel_courtier_p')]" }
						blockoverride "tnt_picker_clear_state"  { visible = "[TntAny('tnt_sel_courtier_p')]" }
						blockoverride "tnt_picker_open_sgui"    { onclick = "[TntExec('tnt_multi_courtier_p_open')]" }
						blockoverride "tnt_picker_open_enabled" { enabled = "[TntValid('tnt_multi_courtier_p_open')]" }
						blockoverride "tnt_picker_open_tooltip" { tooltip = "[TntTip('tnt_multi_courtier_p_open')]" }
						blockoverride "tnt_picker_clear_sgui"   { onclick = "[TntExec('tnt_sel_courtier_p_clear')]" }
					}

					### 19 - TRANSFER A VASSAL (MULTI-SELECT, panel 19 / side 0)  V26
					###
					###      _p MEANS THE PLAYER HANDS ONE OF HIS OWN DIRECT VASSALS
					###      to the partner, with everything under that vassal. It is
					###      the same two-list shape as the courtier row above and it
					###      is NOT the fealty row: fealty is the PARTNER kneeling,
					###      this is a third man changing liege. The two may not
					###      appear in one treaty at all - P25
					###      tnt_no_subject_and_vassal_trigger, delegated from P18 on
					###      the send path and surfaced on the opener's own tooltip.
					###
					###      *** THE SECOND CONJUNCT IS THE GAME RULE AND IT IS NOT
					###      *** OPTIONAL. *** A transferred vassal is IRREVERSIBLE -
					###      no interaction takes him back across a realm boundary -
					###      so the term joins the tnt_advanced_terms family, which
					###      now numbers five. `TntRow` alone gates NOTHING (nothing
					###      writes tnt_hide_unavailable), so without
					###      `TntOn('tnt_advanced')` the rule would block the term
					###      while leaving a live-looking control on screen: the
					###      defect this project shipped four times, closed by
					###      _docs\tools\tnt_rule_conformance.ps1, whose $RULES table
					###      carries the `subject` stem.
					###
					###      THE BADGE COUNTS THE LIST IN THE GUI, exactly like the
					###      courtier row's, for the same reason and with the same
					###      escape hatch: tnt_count_sel_subject_p_value DOES exist
					###      (tnt_58_person_values.txt), and this one expression is
					###      where it goes if a script-value badge is ever preferred.
					###      GetDataModelSize is kept for symmetry with the courtier
					###      pair and costs one list read.
					###
					###      Icon: vanilla's own grant_vassal_interaction carries
					###      `icon = icon_vassal`
					###      (GAME\common\character_interactions\00_vassal_interactions.txt:7),
					###      i.e. gfx/interface/icons/character_interactions/icon_vassal.dds.
					tnt_item_row_picker = {
						name = "tnt_row_subject_p"
						blockoverride "tnt_row_interest" {
							tnt_interest_badge = {
								blockoverride "tnt_interest_state" { visible = "[TntPos('tnt_interests_enabled_value')]" }
								blockoverride "tnt_interest_value" { fontcolor = "[TntInterestColor('tnt_interest_subject_p_badge_percent_value')]" raw_text = "[TntSV('tnt_interest_subject_p_badge_percent_value')|0]%" }
								blockoverride "tnt_interest_tooltip" {
									tooltipwidget = {
										tnt_interest_tooltip = {
											blockoverride "tnt_interest_heading" { text = "tnt_interest_receive" }
											blockoverride "tnt_interest_detail" { visible = "[TntPos('tnt_interest_subject_p_selected_value')]" raw_text = "[Localize('tnt_item_subject')]: [TntSV('tnt_count_sel_subject_p_value')|0]" }
											blockoverride "tnt_interest_empty_state" { visible = "[Not( TntPos('tnt_interest_subject_p_selected_value') )]" text = "tnt_interest_preview_context" }
											blockoverride "tnt_interest_preview_breakdown" { visible = "[Not( TntPos('tnt_interest_subject_p_selected_value') )]" datacontext = "[TntBreakdown('tnt_interest_subject_p_preview_percent_value')]" }
											blockoverride "tnt_interest_breakdown" { visible = "[TntPos('tnt_interest_subject_p_selected_value')]" datacontext = "[TntBreakdown('tnt_interest_subject_p_percent_value')]" }
											blockoverride "tnt_interest_points" { visible = "[TntPos('tnt_interest_subject_p_selected_value')]" }
											blockoverride "tnt_interest_points_effective" { raw_text = "[Localize('tnt_interest_effective_percent')]: [TntSV('tnt_interest_subject_p_display_percent_value')|2]%" }
											blockoverride "tnt_interest_points_base" { raw_text = "[Localize('tnt_interest_base_points')]: [TntSV('tnt_interest_subject_p_base_value')|3]" }
											blockoverride "tnt_interest_points_adjusted" { raw_text = "[Localize('tnt_interest_adjusted_points')]: [TntSV('tnt_interest_subject_p_adjusted_value')|3]" }
										}
									}
								}
							}
						}
						layoutpolicy_horizontal = expanding
						visible = "[And( TntRow('tnt_show_subject_p'), TntOn('tnt_advanced') )]"

						blockoverride "tnt_row_icon"    { texture = "gfx/interface/icons/character_interactions/icon_vassal.dds" }
						blockoverride "tnt_row_name"    { text = "tnt_item_subject" }
						blockoverride "tnt_row_tooltip" { tooltip = "tnt_item_subject_desc" }
						blockoverride "tnt_picker_label"
						{
							visible = "[TntAny('tnt_sel_subject_p')]"
							text = "tnt_sel_count_subject_p"
						}

						blockoverride "tnt_picker_content"
						{
							tnt_chosen_count = {
								name = "tnt_chosen_subject_p"

								blockoverride "tnt_chosen_visible"     { visible = "[TntAny('tnt_sel_subject_p')]" }
								blockoverride "tnt_chosen_click"       { onclick = "[TntExec('tnt_multi_subject_p_open')]" }
								blockoverride "tnt_chosen_tooltip"     { tooltip = "tnt_btn_change" }
								blockoverride "tnt_chosen_count_label" { text = "[GetDataModelSize( TntList('tnt_sel_subject_p') )]" }
							}
						}

						blockoverride "tnt_picker_open_state"   { visible = "[TntNone('tnt_sel_subject_p')]" }
						blockoverride "tnt_picker_clear_state"  { visible = "[TntAny('tnt_sel_subject_p')]" }
						blockoverride "tnt_picker_open_sgui"    { onclick = "[TntExec('tnt_multi_subject_p_open')]" }
						blockoverride "tnt_picker_open_enabled" { enabled = "[TntValid('tnt_multi_subject_p_open')]" }
						blockoverride "tnt_picker_open_tooltip" { tooltip = "[TntTip('tnt_multi_subject_p_open')]" }
						blockoverride "tnt_picker_clear_sgui"   { onclick = "[TntExec('tnt_sel_subject_p_clear')]" }
					}

					### 13 - THE THREAT (V4 expansion 1)
					###
					###      IT IS IN THIS COLUMN AND IT IS NOT A GIFT. Every other row
					###      here is something the player hands over; this one is what
					###      he is instead. It lives here because this column is where
					###      the player states what HE does, it has no _r twin because
					###      a mutual threat is two people not negotiating, and it is
					###      priced OUTSIDE tnt_gain_total_value so that fix 5's opinion
					###      multiplier cannot cancel it - the balance panel prints it
					###      as its own fifth figure for exactly that reason
					###      (tnt_57_threat_values.txt has the full argument).
					###
					###      THE ROW HIDES ITSELF unless all three of the user's
					###      conditions hold - a bigger army, prestige level above 0,
					###      and a partner who fears us at all - which is
					###      tnt_show_threat_p_trigger. If it is visible and still
					###      refuses, the checkbox's own tooltip names which of the
					###      three is missing. V17: those rows are now written out
					###      INLINE in tnt_threat_p_toggle.is_valid
					###      (common\scripted_guis\tnt_20_scripted_guis.txt). The
					###      wrapper T21 tnt_threat_available_trigger they used to
					###      live in is tombstoned - called BARE from an is_valid on
					###      the [TntTip()] path it rendered «<name> has no
					###      localization» instead of the reasons (house law 10b).
					###
					###      icon_dread.dds is the right picture and it exists:
					###      GAME\gfx\interface\icons\icon_dread.dds. It is NOT under
					###      character_interactions - that folder has no threat icon at
					###      all, only declare_war_interaction and the demand_* family,
					###      each of which would promise a different action.
					### 14 - SPEND A HOOK WE ALREADY HOLD (V4 item 2)
					###
					###      THE OPPOSITE OF ROW 9. That row GRANTS the partner a hook on
					###      us and is priced as a concession; this one SPENDS the hook we
					###      hold on him and is priced as pressure - so it sits beside the
					###      threat, outside the gift total, where the opinion multiplier
					###      cannot cancel it. Leverage is the instrument for the ruler who
					###      will never like you.
					###
					###      THE ROW IS ALWAYS VISIBLE and its checkbox carries the reason
					###      when it is dead: tnt_usehook_p_toggle's is_valid says "you hold
					###      no hook on him". The strength - a favour called in versus
					###      blackmail-grade leverage - is read by the value and named in the
					###      grey sub-line, so the player sees WHICH kind he is spending.
					tnt_item_row_toggle = {
						name = "tnt_row_usehook_p"
						layoutpolicy_horizontal = expanding

						### hook_STRONG.dds, and the name is checked: there is no
						### icon_hook.dds in the game at all. The folder ships hook_icon.dds
						### (which row 9 uses) and hook_strong.dds, so spending leverage gets
						### the heavier picture and granting it keeps the plain one - two rows
						### about hooks that must not look identical.
						blockoverride "tnt_row_icon"    { texture = "gfx/interface/icons/character_interactions/hook_strong.dds" }
						blockoverride "tnt_row_name"    { text = "tnt_item_usehook" }
						blockoverride "tnt_row_tooltip" { tooltip = "tnt_item_usehook_desc" }
						blockoverride "tnt_row_sub"
						{
							visible = yes
							text = "tnt_usehook_sub"
							default_format = "#weak"
						}
						blockoverride "tnt_toggle_sgui"    { onclick = "[TntExec('tnt_usehook_p_toggle')]" }
						blockoverride "tnt_toggle_var"     { checked = "[TntOn('tnt_usehook_p')]" }
						blockoverride "tnt_toggle_enabled" { enabled = "[TntValid('tnt_usehook_p_toggle')]" }
						blockoverride "tnt_toggle_tooltip" { tooltip = "[TntTip('tnt_usehook_p_toggle')]" }
					}

					### V4 ITEM A2, READ-ONLY: THE PARTNER CALLS IN A DEBT.
					###
					### It is in the LEFT column even though the leverage is his, because this
					### column is what the PLAYER pays and a called-in debt is a cost to him.
					### It is a tnt_item_row_toggle whose checkbox is permanently disabled: the
					### player cannot switch this on or off - the AI's composer writes
					### tnt_usehook_r when it holds a hook on him (tnt_37_ai_offer.txt, A9).
					###
					### THE ROW EXISTS SO THE EXTRA DEMAND IS NEVER UNEXPLAINED. The value is
					### negative (see tnt_59_usehook_values.txt), so the AI asks for more than a
					### fair price; without a named row the player would only see a treaty that
					### costs more than it should for no visible reason.
					tnt_item_row_toggle = {
						name = "tnt_row_usehook_r"
						layoutpolicy_horizontal = expanding
						visible = "[TntOn('tnt_usehook_r')]"

						blockoverride "tnt_row_icon"    { texture = "gfx/interface/icons/character_interactions/hook_strong.dds" }
						blockoverride "tnt_row_name"    { text = "tnt_item_usehook_r" }
						blockoverride "tnt_row_tooltip" { tooltip = "tnt_item_usehook_r_desc" }
						### V13 USER ITEM 1 - AN EMPTY CLICK, WRITTEN OUT LOUD.
						### This row is READ-ONLY (`enabled = no` below) and must execute
						### NOTHING. It was the ONE tnt_item_row_toggle instantiation in
						### this file that omitted `tnt_toggle_sgui` - and an omitted
						### block is not "no click", it INHERITS the type default, which
						### until this round was `TntExec('tnt_alliance_p_toggle')`
						### (gui\tnt_types.gui). The alliance is retired this round, so
						### the inherited target is a commented-out scripted_gui: a live,
						### visible row calling dead script. The empty body is the
						### type's own sanctioned form for a row with no click, and it
						### keeps this row correct no matter what the default says next.
						blockoverride "tnt_toggle_sgui" {}
						blockoverride "tnt_toggle_var"     { checked = yes }
						blockoverride "tnt_toggle_enabled" { enabled = no }
						blockoverride "tnt_toggle_tooltip" { tooltip = "tnt_item_usehook_r_desc" }
					}

					tnt_item_row_toggle = {
						name = "tnt_row_threat_p"
						layoutpolicy_horizontal = expanding
						visible = "[TntRow('tnt_show_threat_p')]"

						blockoverride "tnt_row_icon"    { texture = "gfx/interface/icons/icon_dread.dds" }
						blockoverride "tnt_row_name"    { text = "tnt_item_threat" }
						blockoverride "tnt_row_tooltip" { tooltip = "tnt_item_threat_desc" }
						blockoverride "tnt_row_sub"
						{
							visible = yes
							text = "[GetPlayer.Custom('TntThreatRowSubtitle')]"
							default_format = "#high"
						}
						blockoverride "tnt_toggle_sgui"    { onclick = "[TntExec('tnt_threat_p_toggle')]" }
						blockoverride "tnt_toggle_var"     { checked = "[TntOn('tnt_threat_p')]" }
						# A selected threat can always be removed, even after its power drops.
						blockoverride "tnt_toggle_enabled" { enabled = "[Or(TntOn('tnt_threat_p'), TntValid('tnt_threat_p_toggle'))]" }
						# Dynamic countdown is appended outside BuildTooltip's bare reasons.
						blockoverride "tnt_toggle_tooltip" { tooltip = "[TntTip('tnt_threat_p_toggle')][GetPlayer.Custom('TntThreatCooldownStatus')]" }
					}
				}
			}

			################################################################
			### CENTRE - THE SCALES, THE DECOMPOSITION AND THE DEAL SHEET
			################################################################
			### THE CENTRE "BOTH OF YOU" SECTION - WHAT IS LEFT OF IT, AND WHY.
			###
			### V13 USER ITEM 1 RETIRED BOTH PACTS. This section was built for the
			### alliance and the non-aggression truce; both are commented out in
			### place below, behind their own tombstones, and THE BLOCK SURVIVES FOR
			### THE MARRIAGE LINE ALONE. That line belongs here for the same reason
			### the pacts did - one marriage is ONE thing both houses enter, not
			### something each side hands over separately - so the section, its
			### header key tnt_mutual_header and its background all stay live and
			### none of the three may be deleted with the pacts.
			###
			### THE RETIREMENT IS A DESIGN REFUSAL, NOT A BUG FIX. Nothing here was
			### broken. The user's ruling: a deal at this table let a player obtain
			### things vanilla DELIBERATELY GATES BEHIND INVESTING A LIFESTYLE FOCUS.
			### Both pacts are gated behind the SAME Diplomacy perk - the alliance at
			### GAME\common\character_interactions\00_alliance.txt:1184, the purchased
			### truce at GAME\common\scripted_triggers\
			### 03_fp2_scripted_triggers.txt:725-735, whose OR opens with
			### `always = no` and whose only general unlock is `has_perk =
			### defensive_negotiations_perk` (:732). Full tombstones: on the two
			### commented-out lines below, and common\scripted_effects\tnt_32_apply.txt.
			###
			### HISTORICAL, AND KEPT BECAUSE THE SHAPE IS STILL IN USE. V3 addition 4
			### filled ONE new block on this panel, tnt_balance_mutual, declared at
			### the TOP of type tnt_balance_panel (tnt_types.gui) - a blockoverride
			### lands where the block is DECLARED, which is why this section appears
			### above the scales rather than below the card. It used tnt_toggle_line
			### and not tnt_item_row_toggle on an arithmetic that still governs the
			### surviving line: the column rows are 56 px, these are 34 px, and at
			### 56 px two rows plus a divider cost ~170 px of a centre column that
			### has ~296 px of slack after the 208 px contextual card, at which point
			### the deal sheet's minimumsize of 150 makes the panel demand more
			### height than the window has. tnt_toggle_line's icon block,
			### tnt_toggle_line_icon, was added for the pacts and is now used by the
			### marriage line's sibling type tnt_action_line the same way.
			###
			### THE VARIABLE CONVENTION, ALSO HISTORICAL: the canonical variable for
			### a MUTUAL term was the _p one, so tnt_alliance_r / tnt_truce_r and
			### their tnt_show_*_r gates already had no reader in any .gui of this
			### mod before this round. Both halves retire together regardless - a
			### gate write and its gate trigger are one atomic pair.
			###
			### TWO LOC KEYS STAY DEFINED THOUGH NOTHING REFERENCES THEM ANY MORE,
			### and that is deliberate: the key set is pinned at 553 and an undefined
			### key prints raw. tnt_label_years lost its last reader when the deal
			### sheet's tnt_sheet_truce_p row retired (gui\tnt_panels.gui);
			### tnt_mutual_header did NOT - the marriage line still sits under it.
			tnt_balance_panel = {
				name = "tnt_balance"

				blockoverride "tnt_balance_mutual"
				{
					### A plain vbox, so the section reads as one thing and costs the
					### panel a single spacing gap instead of three. R4/R5: a vbox as a
					### direct child of a vbox is legal (only a (flow)container refuses
					### hbox/vbox children - defect D3), and neither this vbox nor any
					### of its three children carries a position or an anchor.
					vbox = {
						name = "tnt_mutual_block"
						layoutpolicy_horizontal = expanding
						spacing = 2
						margin = { 6 4 }
						ignoreinvisible = yes

						background = {
							using = Background_Area_Dark
						}

						### R-SPILL: autoresize = no, and the inherited elide is left
						### alone. It prints our own loc rather than game text, but a
						### long translation must not widen the centre column either.
						text_single = {
							name = "tnt_mutual_title"
							layoutpolicy_horizontal = expanding
							autoresize = no
							text = "tnt_mutual_header"
							align = nobaseline|left
							default_format = "#high"
							alwaystransparent = yes
							fontsize_min = 12
							using = Font_Type_Flavor
							using = Font_Size_Medium
						}

						####################################################################
						### TOMBSTONE A - RETIRED: THE ALLIANCE ("Voennyy soyuz").
						### V13 USER ITEM 1.
						###
						### The mechanic was BUILT, SHIPPED AND PLAYED: this mutual line
						### on the centre panel, a checkbox with a gated tooltip, a
						### deal-sheet row with its own X (gui\tnt_panels.gui), a
						### forty-times-power-ratio price with two ally-glut ladders and a
						### three-part personality bias, a re-validating apply leg running
						### vanilla's own create_alliance, an AI archetype that wrote
						### alliance letters (A2) and a silent AI-to-AI leg that sold
						### alliances between neighbours. It was CONSIDERED AND WITHDRAWN
						### FOR AN INDEFINITE PERIOD.
						###
						### THIS IS A DESIGN REFUSAL, NOT A BUG FIX. Nothing here was
						### broken. The user's ruling, in his own terms: a deal at this
						### table let a player obtain things that VANILLA DELIBERATELY
						### GATES BEHIND INVESTING A LIFESTYLE FOCUS. Alliance management
						### is one of them - vanilla's negotiate_alliance_interaction
						### admits you through kinship or through a perk you had to spend
						### a Diplomacy lifestyle on
						### (GAME\common\character_interactions\00_alliance.txt:1182-1196,
						### whose FIRST row is `scope:actor = { has_perk =
						### defensive_negotiations_perk }` at :1184, also :1512 and :2405;
						### the perk is Diplomacy / Foreign Affairs,
						### GAME\common\lifestyle_perks\
						### 00_diplomacy_1_foreign_affairs_tree_perks.txt:262). Buying an
						### alliance across this table short-circuits that investment: a
						### ruler who never opened the Diplomacy tree gets the same reach
						### as one who spent a life on it, and "which focus do I take"
						### stops mattering. THE MOD REFUSES THE TERM ON PURPOSE.
						###
						### THE MOD ALREADY KNEW: T18's header in
						### common\scripted_triggers\tnt_41_gates.txt says the perk block
						### was "DELIBERATELY NOT COPIED ... our window's price of
						### admission is the balance scale". That trade was the mistake;
						### this is its correction. A PRICE IS NOT A GATE.
						###
						### NOTHING IS DELETED. DO NOT RE-ENABLE ONE HALF: a .gui line and
						### its scripted_gui go together, and a gate-write line and its
						### gate trigger are a single atomic pair. What a revival must do
						### differently: gate the line on the player's own INVESTMENT
						### rather than on his purse.
						###
						### THE TYPE DEFAULT WENT WITH IT. gui\tnt_types.gui's
						### tnt_item_row_toggle used to default its click and its checked
						### state to this very term; both are repointed at the threat
						### toggle, and tnt_row_usehook_r - the one row that inherited
						### them - now carries an empty `tnt_toggle_sgui`.
						###
						### ROW INDEX 3 IS RETIRED, not free: never renumbered, never
						### reused. ARCHETYPE INDEX 2 IS RETIRED, beside 4, 5, 7 and 12.
						### Full tombstone: common\scripted_effects\tnt_32_apply.txt.
						####################################################################
#						### 3 - MILITARY ALLIANCE, or MUTUAL DEFENCE PACT inside one
#						###     realm. The two Select_CString swaps come over
#						###     unchanged from the row this replaces, and they are now
#						###     in the one place they belong: tnt_ally_inrealm never
#						###     had a side suffix, because being inside one realm is a
#						###     property of the PAIR, exactly like the pact itself.
#						###     Select_CString( <bool>, Localize(a), Localize(b) ) is
#						###     verbatim vanilla (GAME\gui\game_rules.gui:110) and the
#						###     bool is a plain variable read, never a scripted gui (R9).
#						###
#						###     T14 still greys the box: gating runs ONCE at window
#						###     open, while TntValid re-asks every frame, so an
#						###     alliance formed or a war declared while the window is
#						###     open still disables a control that gating could not
#						###     hide. `enabled` and the tooltip that explains it sit on
#						###     the SAME widget - the checkbox - which is what
#						###     GAME\gui\window_faith.gui:900-902 requires and what
#						###     tnt_toggle_line_box_tooltip exists for.
#						tnt_toggle_line = {
#							name = "tnt_mutual_alliance"
#
#							blockoverride "tnt_toggle_line_visible" { visible = "[TntRow('tnt_show_alliance_p')]" }
#
#							blockoverride "tnt_toggle_line_icon"
#							{
#								widget = {
#									name = "tnt_mutual_icon_holder_alliance"
#									size = { 26 100% }
#									alwaystransparent = yes
#
#									icon = {
#										name = "tnt_mutual_icon_alliance"
#										size = { 24 24 }
#										parentanchor = center
#										texture = "gfx/interface/icons/character_interactions/alliance.dds"
#										alwaystransparent = yes
#									}
#								}
#							}
#
#							### One uniform alliance, and it is offered IN-REALM TOO as of V4
#							### fix 1: the realm test in T18 is gone, so this row now appears
#							### for a liege and for his own vassal - which is what vanilla does
#							### when the two of them marry (an accepted marriage runs
#							### create_alliance with no realm condition). What in-realm cannot
#							### do is answer a call to arms; tnt_item_alliance_desc says so
#							### rather than the row hiding itself. Plain keys, no Select_CString.
#							blockoverride "tnt_toggle_line_label"       { text = "tnt_item_alliance" }
#							blockoverride "tnt_toggle_line_tooltip"     { tooltip = "tnt_item_alliance_desc" }
#							blockoverride "tnt_toggle_line_sgui"        { onclick = "[TntExec('tnt_alliance_p_toggle')]" }
#							blockoverride "tnt_toggle_line_var"         { checked = "[TntOn('tnt_alliance_p')]" }
#							blockoverride "tnt_toggle_line_enabled"     { enabled = "[TntValid('tnt_alliance_p_toggle')]" }
#							blockoverride "tnt_toggle_line_box_tooltip" { tooltip = "[TntTip('tnt_alliance_p_toggle')]" }
#						}

						####################################################################
						### TOMBSTONE B - RETIRED: THE NON-AGGRESSION PACT BETWEEN THE TWO
						### PARTIES ("Pakt o nenapadenii"), THE MUTUAL TEN-YEAR TRUCE.
						### V13 USER ITEM 1. NOT to be confused with the third-party
						### promise retired earlier (user item 1 of an earlier round) -
						### that one was about somebody who was not at the table.
						###
						### The mechanic was BUILT, SHIPPED AND PLAYED: this line beside
						### the alliance, a signed price clamped -20..50, an apply leg
						### running add_truce_both_ways for ten years under our own loc
						### name, TWO AI archetypes (A1 the plain pact, A6 the proud pact
						### paid in prestige), a silent AI-to-AI leg that was the single
						### commonest thing in the world's diplomacy at weight 30, and a
						### war-reachability gate written only last round to keep the term
						### honest. CONSIDERED AND WITHDRAWN FOR AN INDEFINITE PERIOD.
						###
						### THIS IS A DESIGN REFUSAL, NOT A BUG FIX. Same ruling as the
						### alliance, and vanilla puts the purchased truce behind THE SAME
						### Diplomacy investment: purchase_truce_interaction
						### (GAME\common\character_interactions\03_fp2_interactions.txt:2016)
						### delegates its is_shown to
						### fp2_purchase_truce_interaction_soft_requirements_trigger
						### (GAME\common\scripted_triggers\
						### 03_fp2_scripted_triggers.txt:725-735), whose OR OPENS WITH
						### `always = no` and whose only general unlock is `has_perk =
						### defensive_negotiations_perk` (:732) - the Diplomacy / Foreign
						### Affairs perk. Selling peace at this table for coin alone lets
						### a ruler who never invested a focus buy what vanilla makes a
						### lifestyle decision. THE MOD REFUSES THE TERM ON PURPOSE.
						###
						### NOTHING IS DELETED. DO NOT RE-ENABLE ONE HALF.
						###
						### A6's PRESTIGE ROW: PRESTIGE IS NOT RETIRED. A6 wrote
						### tnt_prestige_r as its payment leg; the currency itself stays
						### priced, applied and reachable through the settle ladder's
						### prestige rung and the player's own stepper. What retires is
						### the only ARCHETYPE that wrote it directly.
						###
						### THE INDEPENDENCE GRANT'S OWN TRUCE IS UNTOUCHED: the
						### TRUCE_GRANT_INDEPENDENCE add_truce_both_ways in
						### common\scripted_effects\tnt_3a_people.txt is VANILLA's rule
						### about releasing a vassal, not this term.
						###
						### ROW INDEX 4 IS RETIRED, not free. ARCHETYPE INDICES 1 AND 6
						### ARE RETIRED and must never be reused.
						### Full tombstone: common\scripted_effects\tnt_32_apply.txt.
						####################################################################
#						### 4 - NON-AGGRESSION PACT (T16's enabled+tooltip pair, kept)
#						tnt_toggle_line = {
#							name = "tnt_mutual_truce"
#
#							blockoverride "tnt_toggle_line_visible" { visible = "[TntRow('tnt_show_truce_p')]" }
#
#							blockoverride "tnt_toggle_line_icon"
#							{
#								widget = {
#									name = "tnt_mutual_icon_holder_truce"
#									size = { 26 100% }
#									alwaystransparent = yes
#
#									icon = {
#										name = "tnt_mutual_icon_truce"
#										size = { 24 24 }
#										parentanchor = center
#										texture = "gfx/interface/icons/character_interactions/negotiate_settlement_interaction.dds"
#										alwaystransparent = yes
#									}
#								}
#							}
#
#							blockoverride "tnt_toggle_line_label"       { text = "tnt_item_truce" }
#							blockoverride "tnt_toggle_line_tooltip"     { tooltip = "tnt_item_truce_desc" }
#							blockoverride "tnt_toggle_line_sgui"        { onclick = "[TntExec('tnt_truce_p_toggle')]" }
#							blockoverride "tnt_toggle_line_var"         { checked = "[TntOn('tnt_truce_p')]" }
#							blockoverride "tnt_toggle_line_enabled"     { enabled = "[TntValid('tnt_truce_p_toggle')]" }
#							blockoverride "tnt_toggle_line_box_tooltip" { tooltip = "[TntTip('tnt_truce_p_toggle')]" }
#						}

						### MARRIAGE, AS A MUTUAL TERM, IN THE CENTRE (V3).
						###
						### It belongs beside the alliance and the pact for the same
						### reason they are here: one marriage is ONE thing both houses
						### enter, not something each side hands over separately. It used
						### to be two rows, one per column, both opening the same editor -
						### the old code said so itself: "BOTH marriage rows call the SAME
						### opener ... there is nothing per-side to open." Those rows are
						### hidden now and this is the single term.
						###
						### THE CLICK GOES STRAIGHT TO VANILLA'S MATCHMAKER. No panel of
						### ours in between: no home-made candidate columns, no staging
						### strip, and no second pair list carrying its own grand-wedding
						### switch. The absolute TntPartner form is used deliberately -
						### it needs no datacontext, and a datacontext on a wrapper is
						### exactly what made the old launch button unreachable by the
						### mouse.
						###
						### V4 FIX 3: A BUTTON, NOT A CHECKBOX. The line used to be a
						### tnt_toggle_line whose `checked` merely echoed "is the couple
						### list non-empty" - so a ticked box could not be unticked, and
						### clicking it opened the screen again. Marriage is a screen you
						### open, so the control is now type tnt_action_line
						### (gui\tnt_panels.gui): icon, then one wide button that carries
						### the wording and the tooltip and is the only widget on the line
						### the mouse can hit.
						tnt_action_line = {
							name = "tnt_mutual_marriage"
							blockoverride "tnt_action_line_interest" {
								tnt_interest_badge = {
									name = "tnt_interest_marriage_p"
									blockoverride "tnt_interest_state" { visible = "[TntPos('tnt_interests_enabled_value')]" }
									blockoverride "tnt_interest_value" { fontcolor = "[TntInterestColor('tnt_interest_marriage_p_badge_percent_value')]" raw_text = "[TntSV('tnt_interest_marriage_p_badge_percent_value')|0]%" }
									blockoverride "tnt_interest_tooltip" {
										tooltipwidget = {
											tnt_interest_tooltip = {
												blockoverride "tnt_interest_heading" { text = "tnt_interest_receive" }
												blockoverride "tnt_interest_detail" { text = "tnt_item_marriage" }
												blockoverride "tnt_interest_empty_state" { visible = "[Not( TntPos('tnt_interest_marriage_p_selected_value') )]" text = "tnt_interest_preview_context" }
												blockoverride "tnt_interest_preview_breakdown" { visible = "[Not( TntPos('tnt_interest_marriage_p_selected_value') )]" datacontext = "[TntBreakdown('tnt_interest_marriage_p_preview_percent_value')]" }
												blockoverride "tnt_interest_breakdown" { visible = "[TntPos('tnt_interest_marriage_p_selected_value')]" datacontext = "[TntBreakdown('tnt_interest_marriage_p_percent_value')]" }
												blockoverride "tnt_interest_points" { visible = "[TntPos('tnt_interest_marriage_p_selected_value')]" }
												blockoverride "tnt_interest_points_effective" { raw_text = "[Localize('tnt_interest_effective_percent')]: [TntSV('tnt_interest_marriage_p_display_percent_value')|2]%" }
												blockoverride "tnt_interest_points_base" { raw_text = "[Localize('tnt_interest_base_points')]: [TntSV('tnt_interest_marriage_p_base_value')|3]" }
												blockoverride "tnt_interest_points_adjusted" { raw_text = "[Localize('tnt_interest_adjusted_points')]: [TntSV('tnt_interest_marriage_p_adjusted_value')|3]" }
											}
										}
									}
								}
								tnt_interest_badge = {
									name = "tnt_interest_marriage_r"
									blockoverride "tnt_interest_state" { visible = "[TntPos('tnt_interests_enabled_value')]" }
									blockoverride "tnt_interest_value" { fontcolor = "[TntInterestColor('tnt_interest_marriage_r_badge_percent_value')]" raw_text = "[TntSV('tnt_interest_marriage_r_badge_percent_value')|0]%" }
									blockoverride "tnt_interest_tooltip" {
										tooltipwidget = {
											tnt_interest_tooltip = {
												blockoverride "tnt_interest_heading" { text = "tnt_interest_surrender" }
												blockoverride "tnt_interest_detail" { text = "tnt_item_marriage" }
												blockoverride "tnt_interest_empty_state" { visible = "[Not( TntPos('tnt_interest_marriage_r_selected_value') )]" text = "tnt_interest_preview_context" }
												blockoverride "tnt_interest_preview_breakdown" { visible = "[Not( TntPos('tnt_interest_marriage_r_selected_value') )]" datacontext = "[TntBreakdown('tnt_interest_marriage_r_preview_percent_value')]" }
												blockoverride "tnt_interest_breakdown" { visible = "[TntPos('tnt_interest_marriage_r_selected_value')]" datacontext = "[TntBreakdown('tnt_interest_marriage_r_percent_value')]" }
												blockoverride "tnt_interest_points" { visible = "[TntPos('tnt_interest_marriage_r_selected_value')]" }
												blockoverride "tnt_interest_points_effective" { raw_text = "[Localize('tnt_interest_effective_percent')]: [TntSV('tnt_interest_marriage_r_display_percent_value')|2]%" }
												blockoverride "tnt_interest_points_base" { raw_text = "[Localize('tnt_interest_base_points')]: [TntSV('tnt_interest_marriage_r_base_value')|3]" }
												blockoverride "tnt_interest_points_adjusted" { raw_text = "[Localize('tnt_interest_adjusted_points')]: [TntSV('tnt_interest_marriage_r_adjusted_value')|3]" }
											}
										}
									}
								}
							}

							blockoverride "tnt_action_line_visible" { visible = "[And( TntRow('tnt_show_marriage_p'), TntOn('tnt_advanced') )]" }

							blockoverride "tnt_action_line_icon"
							{
								widget = {
									name = "tnt_mutual_icon_holder_marriage"
									size = { 26 100% }
									alwaystransparent = yes

									icon = {
										name = "tnt_mutual_icon_marriage"
										size = { 24 24 }
										parentanchor = center
										texture = "gfx/interface/icons/character_interactions/icon_marriage.dds"
										alwaystransparent = yes
									}
								}
							}

							blockoverride "tnt_action_line_text"    { text = "tnt_btn_stage_marriage" }
							blockoverride "tnt_action_line_tooltip" { tooltip = "tnt_btn_stage_marriage_full" }
							blockoverride "tnt_action_line_click"   { onclick = "[TntPartner.OpenPlayerInteraction( 'tnt_stage_marriage_interaction' )]" }
						}

						### THERE IS NO GRAND-WEDDING LINE HERE ANY MORE (V4 fix 2).
						###
						### It stood here for exactly one iteration. The user's ruling:
						### "there must be no separate treaty item 'promise a grand
						### wedding' - everything is stated in the pair-selection window."
						### And that is where the engine already offers it: vanilla's
						### matchmaker ships a grand-wedding toggle of its own
						### (GAME\gui\interaction_marriage.gui:332,
						### MARRIAGE_GRAND_WEDDING_TOGGLE), and our interaction declares the
						### matching send_option flag = grand_wedding_promise with every
						### host gate on it (tnt_12_marriage_picker.txt). Two switches for
						### one promise, in two windows, is how they end up disagreeing.
						###
						### So: the promise is made where the couple is chosen, and it is
						### PRICED there too - the preview line in that window includes it.
						### The treaty sheet still reports it (tnt_sheet_wed_grand,
						### gui\tnt_panels.gui) because it is a term of the deal; it is only
						### no longer something you can switch from here.
						###
						### tnt_wed_grand_toggle in tnt_22a_marriage.txt has no caller left.
						### It is kept, and its header says why: it holds the one copy of the
						### host gate written as custom_description rows, which is what the
						### interaction's own send_option tooltip mirrors.
					}
				}
			}

			################################################################
			### RIGHT COLUMN - THEY OFFER
			################################################################
			tnt_column = {
				name = "tnt_column_partner"
				datacontext = "[TntPartner]"

				blockoverride "tnt_column_header"
				{
					text = "tnt_col_partner"
				}

				blockoverride "tnt_column_rows"
				{
					### 1 - GOLD
					### Every row on this side is gated exactly like its _p twin -
					### see the long note above tnt_row_gold_p.
					### V3 ITERATION 3: the four currency rows on THIS side are
					### tnt_item_row_currency too, and their preset row keys end
					### in _r. The `_max` preset therefore means "everything HE
					### can afford" here, which is why type tnt_preset_menu keeps
					### the max label in a block - see the eight panels at the
					### bottom of this file.
					tnt_item_row_currency = {
						name = "tnt_row_gold_r"
						blockoverride "tnt_row_interest" {
							tnt_interest_badge = {
								blockoverride "tnt_interest_state" { visible = "[TntPos('tnt_interests_enabled_value')]" }
								blockoverride "tnt_interest_value" { fontcolor = "[TntInterestColor('tnt_interest_gold_r_badge_percent_value')]" raw_text = "[TntSV('tnt_interest_gold_r_badge_percent_value')|0]%" }
								blockoverride "tnt_interest_tooltip" {
									tooltipwidget = {
										tnt_interest_tooltip = {
											blockoverride "tnt_interest_heading" { text = "tnt_interest_surrender" }
											blockoverride "tnt_interest_detail" { raw_text = "[Localize('tnt_item_gold')]: [TntNum('tnt_gold_r')|2]" }
											blockoverride "tnt_interest_empty_state" { visible = "[Not( TntOn('tnt_gold_r') )]" text = "tnt_interest_preview_currency" }
											blockoverride "tnt_interest_preview_breakdown" { visible = "[Not( TntOn('tnt_gold_r') )]" datacontext = "[TntBreakdown('tnt_interest_gold_r_preview_percent_value')]" }
											blockoverride "tnt_interest_breakdown" { visible = "[TntOn('tnt_gold_r')]" datacontext = "[TntBreakdown('tnt_interest_gold_r_percent_value')]" }
											blockoverride "tnt_interest_points" { visible = "[TntOn('tnt_gold_r')]" }
											blockoverride "tnt_interest_points_effective" { raw_text = "[Localize('tnt_interest_effective_percent')]: [TntSV('tnt_interest_gold_r_display_percent_value')|2]%" }
											blockoverride "tnt_interest_points_base" { raw_text = "[Localize('tnt_interest_base_points')]: [TntSV('tnt_interest_gold_r_base_value')|3]" }
											blockoverride "tnt_interest_points_adjusted" { raw_text = "[Localize('tnt_interest_adjusted_points')]: [TntSV('tnt_interest_gold_r_adjusted_value')|3]" }
											blockoverride "tnt_interest_capacity_state" { visible = yes }
											blockoverride "tnt_interest_capacity_target" { raw_text = "[Localize('tnt_interest_capacity_target')]: [TntSV('tnt_interest_gold_capacity_value')|2]" }
											blockoverride "tnt_interest_capacity_stock" { raw_text = "[Localize('tnt_interest_current_stock')]: [TntSV('tnt_interest_gold_stock_value')|2]" }
											blockoverride "tnt_interest_capacity_breakdown" { datacontext = "[TntBreakdown('tnt_interest_gold_capacity_value')]" }
										}
									}
								}
							}
						}
						layoutpolicy_horizontal = expanding
						visible = "[TntRow('tnt_show_gold_r')]"

						blockoverride "tnt_row_icon"    { texture = "gfx/interface/icons/character_interactions/icon_gold.dds" }
						blockoverride "tnt_row_name"    { text = "tnt_item_gold" }
						blockoverride "tnt_row_tooltip" { tooltip = "tnt_item_gold_desc" }

						blockoverride "tnt_stepper_full_block"
						{
							tnt_stepper_full = {
								parentanchor = vcenter|right
								position = { -10 0 }

								blockoverride "tnt_stepper_huge_minus" { onclick = "[TntExec('tnt_gold_r_sub_huge')]" }
								blockoverride "tnt_stepper_minus"      { onclick = "[TntExec('tnt_gold_r_sub')]" }
								blockoverride "tnt_stepper_minus_big"  { onrightclick = "[TntExec('tnt_gold_r_sub_big')]" }
								blockoverride "tnt_stepper_plus"       { onclick = "[TntExec('tnt_gold_r_add')]" enabled = "[TntValid('tnt_gold_r_add')]" }
								blockoverride "tnt_stepper_plus_big"   { onrightclick = "[TntExec('tnt_gold_r_add_big')]" }
								blockoverride "tnt_stepper_huge_plus"  { onclick = "[TntExec('tnt_gold_r_add_huge')]" enabled = "[TntValid('tnt_gold_r_add_huge')]" }
								blockoverride "tnt_stepper_tt_huge_plus" { tooltip = "[Select_CString( TntValid('tnt_gold_r_add_huge'), Localize('tnt_tt_step_huge_add'), TntTip('tnt_gold_r_add_huge') )]" }
								blockoverride "tnt_stepper_text"       { text = "[TntNum('tnt_gold_r')|0]" }
								blockoverride "tnt_stepper_tt_minus"   { tooltip = "tnt_stepper_tt" }
