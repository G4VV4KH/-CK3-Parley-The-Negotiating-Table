					### 15 - INFLUENCE (item 2.4). NEW, and CONDITIONAL.
					### Influence only exists for a government carrying the
					### government_has_influence flag
					### (GAME\common\governments\00_government_types.txt:490).
					### The GUI cannot call government_has_flag, so the row is
					### gated on the script value tnt_influence_ok_value
					### (MOD\common\script_values\tnt_53_currency_values.txt:236),
					### which is 1 only when BOTH governments can hold influence.
					### It reads the two mirror variables tnt_infl_ok_p /
					### tnt_infl_ok_r that tnt_refresh_v2_mirrors_effect writes on
					### the player once per window open
					### (MOD\common\scripted_effects\tnt_30_effects.txt:178).
					###
					### BOTH sides, not one: tnt_exec_influence_effect requires the
					### flag on the giver AND the receiver
					### (tnt_33_currency_apply.txt:281-282), because
					### change_influence on a receiver with no influence pool is a
					### silent no-op - a term with a price and no effect. The same
					### value gates tnt_balance_value's influence rows and
					### tnt_items_count_value's influence slots, and
					### tnt_53_currency_values.txt:230 names this as the value the
					### GUI should bind the row's visible to.
					### If the mirrors are never written the rows simply stay
					### hidden, which is the correct and safe degradation.
					### NEVER bind this to government_has_flag.
					### Icon confirmed on disk:
					### GAME\gfx\interface\icons\character_interactions\icon_influence_01.dds
					tnt_item_row_currency = {
						name = "tnt_row_influence_p"
						blockoverride "tnt_row_interest" {
							tnt_interest_badge = {
								blockoverride "tnt_interest_state" { visible = "[TntPos('tnt_interests_enabled_value')]" }
								blockoverride "tnt_interest_value" { fontcolor = "[TntInterestColor('tnt_interest_influence_p_badge_percent_value')]" raw_text = "[TntSV('tnt_interest_influence_p_badge_percent_value')|0]%" }
								blockoverride "tnt_interest_tooltip" {
									tooltipwidget = {
										tnt_interest_tooltip = {
											blockoverride "tnt_interest_heading" { text = "tnt_interest_receive" }
											blockoverride "tnt_interest_detail" { raw_text = "[Localize('tnt_item_influence')]: [TntNum('tnt_influence_p')|2]" }
											blockoverride "tnt_interest_empty_state" { visible = "[Not( TntOn('tnt_influence_p') )]" text = "tnt_interest_preview_currency" }
											blockoverride "tnt_interest_preview_breakdown" { visible = "[Not( TntOn('tnt_influence_p') )]" datacontext = "[TntBreakdown('tnt_interest_influence_p_preview_percent_value')]" }
											blockoverride "tnt_interest_breakdown" { visible = "[TntOn('tnt_influence_p')]" datacontext = "[TntBreakdown('tnt_interest_influence_p_percent_value')]" }
											blockoverride "tnt_interest_points" { visible = "[TntOn('tnt_influence_p')]" }
											blockoverride "tnt_interest_points_effective" { raw_text = "[Localize('tnt_interest_effective_percent')]: [TntSV('tnt_interest_influence_p_display_percent_value')|2]%" }
											blockoverride "tnt_interest_points_base" { raw_text = "[Localize('tnt_interest_base_points')]: [TntSV('tnt_interest_influence_p_base_value')|3]" }
											blockoverride "tnt_interest_points_adjusted" { raw_text = "[Localize('tnt_interest_adjusted_points')]: [TntSV('tnt_interest_influence_p_adjusted_value')|3]" }
											blockoverride "tnt_interest_capacity_state" { visible = yes }
											blockoverride "tnt_interest_capacity_target" { raw_text = "[Localize('tnt_interest_capacity_target')]: [TntSV('tnt_interest_influence_capacity_value')|2]" }
											blockoverride "tnt_interest_capacity_stock" { raw_text = "[Localize('tnt_interest_current_stock')]: [TntSV('tnt_interest_influence_stock_value')|2]" }
											blockoverride "tnt_interest_capacity_breakdown" { datacontext = "[TntBreakdown('tnt_interest_influence_capacity_value')]" }
										}
									}
								}
							}
						}
						layoutpolicy_horizontal = expanding
						visible = "[TntPos('tnt_influence_ok_value')]"

						blockoverride "tnt_row_icon"    { texture = "gfx/interface/icons/character_interactions/icon_influence_01.dds" }
						blockoverride "tnt_row_name"    { text = "tnt_item_influence" }
						blockoverride "tnt_row_tooltip" { tooltip = "tnt_item_influence_desc" }

						### THE COARSE STEP ON THIS ROW IS 250, NOT 1000, and the
						### scripted gui name is the only place that says so -
						### tnt_influence_p_add_huge itself steps 250, because
						### influence caps at 1000 and a +1000 button would be a
						### jump to the ceiling, which is what the `_max` preset
						### already does in one click and labels honestly. 250 is
						### vanilla's own monumental_influence_value. The shared
						### tooltip key tnt_tt_step_huge_add names both amounts.
						blockoverride "tnt_stepper_full_block"
						{
							tnt_stepper_full = {
								parentanchor = vcenter|right
								position = { -10 0 }

								blockoverride "tnt_stepper_huge_minus" { onclick = "[TntExec('tnt_influence_p_sub_huge')]" }
								blockoverride "tnt_stepper_minus"      { onclick = "[TntExec('tnt_influence_p_sub')]" }
								blockoverride "tnt_stepper_minus_big"  { onrightclick = "[TntExec('tnt_influence_p_sub_big')]" }
								blockoverride "tnt_stepper_plus"       { onclick = "[TntExec('tnt_influence_p_add')]" }
								blockoverride "tnt_stepper_plus_big"   { onrightclick = "[TntExec('tnt_influence_p_add_big')]" }
								blockoverride "tnt_stepper_huge_plus"  { onclick = "[TntExec('tnt_influence_p_add_huge')]" }
								blockoverride "tnt_stepper_text"       { text = "[TntNum('tnt_influence_p')|0]" }
								blockoverride "tnt_stepper_tt_minus"   { tooltip = "tnt_stepper_influence_tt" }
								blockoverride "tnt_stepper_tt_plus"    { tooltip = "tnt_stepper_influence_tt" }
								blockoverride "tnt_stepper_preset_open" { onclick = "[GetVariableSystem.Set( 'tnt_preset_menu', 'influence_p' )]" }
							}
						}
					}

					### 3 / 4 - MILITARY ALLIANCE AND NON-AGGRESSION PACT
					###     ARE NOT IN THIS COLUMN ANY MORE (V3 ADDITION 4).
					###
					###     They used to appear TWICE, once per column, and the user
					###     found what that costs: an alliance is one pact between two
					###     rulers, so ticking it on the partner's side priced a second,
					###     non-existent alliance and SUBTRACTED points from a deal that
					###     had not changed. Two variables (tnt_alliance_p /
					###     tnt_alliance_r) for one fact is the defect; one row is the
					###     fix, not a cosmetic move.
					###     Both pacts are now single MUTUAL rows in the centre column,
					###     between the two parties, next to the balance that prices them
					###     - see blockoverride "tnt_balance_mutual" on tnt_balance_panel
					###     below. They keep the canonical variables tnt_alliance_p and
					###     tnt_truce_p, their gates tnt_show_alliance_p /
					###     tnt_show_truce_p, and the T14 / T16 enabled+tooltip pair.
					###     The full comment on the two-terms-one-row Select_CString
					###     rename (tnt_ally_inrealm: "Alliance" vs "Mutual defence
					###     pact") moved with them.
					###
					###     The two indices 3 and 4 are NOT reused and NOT renumbered -
					###     the row index table is frozen (10-CONTRACT R0.8) and the
					###     overlay's `visible` expressions test those numbers. Nothing
					###     opens a panel at 3 or 4 today, and both stay reserved.
					###
					###     V13 USER ITEM 1: BOTH PACTS ARE NOW RETIRED OUTRIGHT. The
					###     centre lines they moved to are commented out behind
					###     TOMBSTONE A and TOMBSTONE B (search this file for them), and
					###     the paragraph above is history: it explains why they left
					###     this column, not why they are gone. THE REASON THEY ARE GONE
					###     IS A DESIGN REFUSAL - vanilla gates both behind the Diplomacy
					###     perk defensive_negotiations_perk, so buying them here
					###     short-circuits a lifestyle investment. Indices 3 and 4 stay
					###     reserved on exactly the same terms as before, now as RETIRED
					###     rather than as free-but-unused.

					### 5 - MARRIAGE PACT (item 2.1, BUILD 2).
					###     The auto-picked child is gone: tnt_marriage_child_p/_r
					###     are deleted (30-V2-DESIGN 3.1) together with the effect
					###     tnt_pick_marriage_pair_effect that wrote them, and the
					###     player now chooses BOTH spouses and the line himself, in
					###     tnt_panel_marriage at overlay index 5.
					###     The grey line names this side's chosen spouse
					###     (tnt_spouse_p, written by tnt_pick_spouse_p_set), and the
					###     small round button in the toggle row's extra slot opens
					###     the editor. That slot already exists - the prisoners row
					###     was its first consumer, before user item 7 retired it - so
					###     no new row type is needed.
					tnt_item_row_toggle = {
						name = "tnt_row_marriage_p"
						layoutpolicy_horizontal = expanding
						### SUPERSEDED BY tnt_mutual_marriage IN THE CENTRE COLUMN.
						### Marriage is a mutual term and is now a single line there, so
						### this per-side row is switched off rather than duplicating it.
						### The markup is left in place for one release so the change is
						### easy to read and to revert; it should be deleted in a cleanup
						### pass, together with the right-hand twin and the tnt_panel_marriage
						### instantiation.
						visible = no

						blockoverride "tnt_row_icon"    { texture = "gfx/interface/icons/character_interactions/icon_marriage.dds" }
						blockoverride "tnt_row_name"    { text = "tnt_item_marriage" }
						blockoverride "tnt_row_tooltip" { tooltip = "tnt_item_marriage_desc" }
						### V3 ITERATION 4: the grey line counts the COUPLES, it no longer
						### names one spouse. tnt_spouse_p is a staging cursor now -
						### tnt_wed_add empties it on every commit - so the old read would
						### have gone blank exactly when the term became real. The count
						### comes from GetDataModelSize inside tnt_wed_count, over the same
						### list the sheet and the editor draw from.
						blockoverride "tnt_row_sub"
						{
							visible = "[TntAny('tnt_wed_list')]"
							text = "tnt_wed_count"
							default_format = "#high"
						}
						### Opens the pair editor. BOTH marriage rows call the SAME
						### opener, because index 5 is one panel holding both sides'
						### candidate lists - there is nothing per-side to open.
						blockoverride "tnt_toggle_extra"
						{
							widget = {
								name = "tnt_marriage_edit_holder_p"
								size = { 32 100% }

								button_round = {
									name = "tnt_marriage_edit_p"
									size = { 28 28 }
									parentanchor = center
									tooltip = "tnt_btn_edit_marriage"
									using = tooltip_es
									onclick = "[TntExec('tnt_pick_marriage_open')]"

									icon = {
										name = "tnt_marriage_edit_icon_p"
										size = { 20 20 }
										parentanchor = center
										texture = "gfx/interface/icons/character_interactions/icon_marriage.dds"
										alwaystransparent = yes
									}
								}
							}
						}
						blockoverride "tnt_toggle_sgui"    { onclick = "[TntExec('tnt_marriage_p_toggle')]" }
						blockoverride "tnt_toggle_var"     { checked = "[TntOn('tnt_marriage_p')]" }
						blockoverride "tnt_toggle_enabled" { enabled = "[TntValid('tnt_marriage_p_toggle')]" }
						blockoverride "tnt_toggle_tooltip" { tooltip = "[TntTip('tnt_marriage_p_toggle')]" }
					}

					### 5b - THE GRAND-WEDDING PROMISE   (V3 ITERATION 4)
					###
					###     IT IS A PROMISE, AND THE TEXT SAYS PROMISE. What the
					###     script author rides is vanilla's own
					###     set_grand_wedding_betrothal_variables: the honoured couple
					###     is BETROTHED rather than wed, the player becomes the
					###     promised host, a countdown runs and vanilla itself warns
					###     him (ep2_wedding.0001) before it lapses. THIS MOD CREATES
					###     NO ACTIVITY AND SCHEDULES NOTHING - the host still has to
					###     plan and pay for the wedding, and vanilla's own opinion
					###     penalty falls on him if he never does. tnt_wed_grand and
					###     tnt_wed_grand_desc are written to exactly that and must
					###     never be reworded into "a grand wedding will be held".
					###
					###     ONE ROW, NOT A PAIR OF ROWS, and no _r twin: vanilla
					###     allows ONE outstanding promise per HOST, the host is the
					###     player, and the honoured couple is one of the pairs -
					###     tnt_wed_principal. The row's grey line names that couple
					###     by reading the variable (tnt_wed_grand_couple), never by
					###     position, because a CK3 variable list has no index access
					###     and "the first pair" is not expressible.
					###
					###     V4 FIX 2 DELETED THE ROW. THIS IS THE "SEPARATE TREATY ITEM"
					###     THE USER MEANT: a tnt_item_row_toggle named
					###     tnt_row_wed_grand stood here in the LEFT column with its own
					###     checkbox, its own [TntTip('tnt_wed_grand_toggle')] and the
					###     honoured couple in its grey line. The ruling was "there must
					###     be no separate treaty item 'promise a grand wedding' -
					###     everything is stated in the pair-selection window", and it
					###     is right: vanilla's matchmaker already ships the toggle
					###     (GAME\gui\interaction_marriage.gui:332), our interaction
					###     already declares the matching send_option
					###     flag = grand_wedding_promise with the full host gate on it,
					###     and as of this fix the preview line in that window PRICES it
					###     (tnt_marriage_grand_value now reads the flag through
					###     tnt_grand_promised_trigger). Two switches for one promise, in
					###     two windows, is how they end up disagreeing.
					###
					###     WHAT STILL REPORTS IT: tnt_sheet_wed_grand in the deal sheet,
					###     because a promise IS a term of the treaty and the sheet's job
					###     is to list the terms. It is a read-out, not a switch.
					###
					###     The mirror line that briefly lived in the CENTRE mutual block
					###     is gone for the same reason - see the note there.

					### 6 - CEDE TITLES (item 2.2, MULTI-SELECT; game-rule gated)
					###
					###     This row changed shape more than any other in build 2.
					###     tnt_title_p is gone; the term is the variable LIST
					###     tnt_sel_title_p. The row's two mutually exclusive states
					###     are driven by TntAny / TntNone, which are
					###     Not(IsDataModelEmpty(MakeScope.GetList)) and its
					###     negation - no script value, no scripted gui, and the
					###     datafunction is already shipped and running in this mod
					###     in every picker panel's empty state.
					###
					###     The COUNT, on the other hand, comes from
					###     author:multiselect's tnt_count_sel_title_p_value and the
					###     loc key tnt_multi_count_title_p, not from a second
					###     mechanism of this file's own. That value is what prices
					###     the term and what the panel's own counter prints, so the
					###     row, the panel and the deal sheet all read one number
					###     from one place and cannot disagree.
					###
					###     ITEM 3.3 SURVIVES, in the form multi-select allows: the
					###     filled state is no longer one title's coat of arms
					###     (there may be five titles) but a COUNT BADGE,
					###     tnt_chosen_count, which clicks straight back into the
					###     panel. The full list of names is in the centre column's
					###     deal sheet, which is where item 3.4 asked for it.
					###
					###     The opener is UNCHANGED - tnt_pick_title_p_open still
					###     writes picker 6 / side 0, which is exactly what the new
					###     panel's `visible` tests. The CLEAR button moved to
					###     author:multiselect's tnt_sel_title_p_clear, the same gui
					###     that panel's own "clear all" button calls.
					tnt_item_row_picker = {
						name = "tnt_row_title_p"
						blockoverride "tnt_row_interest" {
							tnt_interest_badge = {
								blockoverride "tnt_interest_state" { visible = "[TntPos('tnt_interests_enabled_value')]" }
								blockoverride "tnt_interest_value" { fontcolor = "[TntInterestColor('tnt_interest_title_p_badge_percent_value')]" raw_text = "[TntSV('tnt_interest_title_p_badge_percent_value')|0]%" }
								blockoverride "tnt_interest_tooltip" {
									tooltipwidget = {
										tnt_interest_tooltip = {
											blockoverride "tnt_interest_heading" { text = "tnt_interest_receive" }
											blockoverride "tnt_interest_detail" { visible = "[TntPos('tnt_interest_title_p_selected_value')]" raw_text = "[Localize('tnt_item_title')]: [TntSV('tnt_count_sel_title_p_value')|0]" }
											blockoverride "tnt_interest_empty_state" { visible = "[Not( TntPos('tnt_interest_title_p_selected_value') )]" text = "tnt_interest_preview_context" }
											blockoverride "tnt_interest_preview_breakdown" { visible = "[Not( TntPos('tnt_interest_title_p_selected_value') )]" datacontext = "[TntBreakdown('tnt_interest_title_p_preview_percent_value')]" }
											blockoverride "tnt_interest_breakdown" { visible = "[TntPos('tnt_interest_title_p_selected_value')]" datacontext = "[TntBreakdown('tnt_interest_title_p_percent_value')]" }
											blockoverride "tnt_interest_points" { visible = "[TntPos('tnt_interest_title_p_selected_value')]" }
											blockoverride "tnt_interest_points_effective" { raw_text = "[Localize('tnt_interest_effective_percent')]: [TntSV('tnt_interest_title_p_display_percent_value')|2]%" }
											blockoverride "tnt_interest_points_base" { raw_text = "[Localize('tnt_interest_base_points')]: [TntSV('tnt_interest_title_p_base_value')|3]" }
											blockoverride "tnt_interest_points_adjusted" { raw_text = "[Localize('tnt_interest_adjusted_points')]: [TntSV('tnt_interest_title_p_adjusted_value')|3]" }
										}
									}
								}
							}
						}
						layoutpolicy_horizontal = expanding
						visible = "[And( TntRow('tnt_show_title_p'), TntOn('tnt_advanced') )]"

						blockoverride "tnt_row_icon"    { texture = "gfx/interface/icons/character_interactions/icon_transfer_county.dds" }
						blockoverride "tnt_row_name"    { text = "tnt_item_title" }
						blockoverride "tnt_row_tooltip" { tooltip = "tnt_item_title_desc" }
						blockoverride "tnt_picker_label"
						{
							visible = "[TntAny('tnt_sel_title_p')]"
							text = "tnt_multi_count_title_p"
						}

						blockoverride "tnt_picker_content"
						{
							tnt_chosen_count = {
								name = "tnt_chosen_title_p"

								blockoverride "tnt_chosen_visible"     { visible = "[TntAny('tnt_sel_title_p')]" }
								blockoverride "tnt_chosen_click"       { onclick = "[TntExec('tnt_multi_title_p_open')]" }
								blockoverride "tnt_chosen_tooltip"     { tooltip = "tnt_btn_change" }
								blockoverride "tnt_chosen_count_label" { text = "[TntSV('tnt_count_sel_title_p_value')|0]" }
							}
						}

						blockoverride "tnt_picker_open_state"    { visible = "[TntNone('tnt_sel_title_p')]" }
						blockoverride "tnt_picker_clear_state"   { visible = "[TntAny('tnt_sel_title_p')]" }
						blockoverride "tnt_picker_open_sgui"     { onclick = "[TntExec('tnt_multi_title_p_open')]" }
						blockoverride "tnt_picker_open_enabled"  { enabled = "[TntValid('tnt_multi_title_p_open')]" }
						blockoverride "tnt_picker_open_tooltip"  { tooltip = "[TntTip('tnt_multi_title_p_open')]" }
						blockoverride "tnt_picker_clear_sgui"    { onclick = "[TntExec('tnt_sel_title_p_clear')]" }
					}

					####################################################################
					### TOMBSTONE C - RETIRED: THE GRANTED CLAIM ("Peredat pretenziyu"),
					### BOTH GENERATIONS.  V13 USER ITEM 1.
					###
					### The mechanic was BUILT, SHIPPED AND PLAYED TWICE: first as a
					### single-object picker per column (tnt_claim_p/_r), then rebuilt as
					### an unlimited multi-select with two candidate lists, two selection
					### lists, two overlay panels at index 7, a per-tier price at half the
					### land ladder, a re-validating apply leg running add_unpressed_claim
					### per title, an AI archetype that sold paper claims (A11), and an
					### auto-balance rung that reached for a claim when the scales were 12
					### points out. It was CONSIDERED AND WITHDRAWN FOR AN INDEFINITE
					### PERIOD.
					###
					### THIS IS A DESIGN REFUSAL, NOT A BUG FIX. The user's ruling:
					### vanilla gates the MANUFACTURE of claims behind a LEARNING
					### investment. Claims are fabricated by the Court Chaplain's council
					### task - task_fabricate_claim,
					### GAME\common\council_tasks\00_court_chaplain_tasks.txt:1088 - and
					### what you get out of it is keyed to LEARNING: a duchy-tier claim
					### only above mediocre_skill_rating (:1120), vassal opinion and piety
					### penalties below high_skill_rating (:1126, :1132). You invest in
					### Learning, you staff a chaplain, you wait years, and you accept the
					### side effects. Buying a finished claim at this table
					### short-circuits all of it. THE MOD REFUSES THE TERM ON PURPOSE.
					###
					### THE PRICE WAS ALWAYS AN ADMISSION. common\script_values\
					### tnt_50_values.txt section 7 said it in its own words: "*** INVENTED
					### NUMBER, SAID PLAINLY. *** No vanilla interaction grants a title
					### claim through an ai_accept." There was no vanilla anchor because
					### vanilla has no such transaction - only a council task you invest in.
					###
					### NOTHING IS DELETED. DO NOT RE-ENABLE ONE HALF - this row's opener
					### and its clear both call scripted_guis that retire with it, and the
					### two overlay panels it opens are commented out with it (this file's
					### panel section, and the two types in
					### gui\tnt_panel_multiselect.gui).
					###
					### WHAT A REVIVAL MUST DO DIFFERENTLY: do not sell the claim. Sell the
					### CONSENT - put the partner's chaplain to work, or let the treaty
					### shorten a fabrication already running, so the Learning investment
					### is still the thing that produces the claim and the treaty only
					### unblocks it.
					###
					### ROW INDEX 7 AND OVERLAY INDEX 7 ARE RETIRED, not free: never
					### renumbered, never reused. ARCHETYPE INDEX 11 IS RETIRED.
					### Full tombstone: common\scripted_effects\tnt_32_apply.txt.
					####################################################################
#					### 7 - GRANT CLAIMS (item 2.2, MULTI-SELECT) over the giver's
#					###     OWN held titles. Same shape as row 6 above.
#					tnt_item_row_picker = {
#						name = "tnt_row_claim_p"
#						layoutpolicy_horizontal = expanding
#						visible = "[TntRow('tnt_show_claim_p')]"
#
