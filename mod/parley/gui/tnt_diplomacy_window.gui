						blockoverride "tnt_picker_clear_state"  { visible = "[TntVar('tnt_hostage_r').Char.IsValid]" }
						blockoverride "tnt_picker_open_sgui"    { onclick = "[TntExec('tnt_pick_hostage_r_open')]" }
						blockoverride "tnt_picker_open_enabled" { enabled = "[TntValid('tnt_pick_hostage_r_open')]" }
						blockoverride "tnt_picker_open_tooltip" { tooltip = "[TntTip('tnt_pick_hostage_r_open')]" }
						blockoverride "tnt_picker_clear_sgui"   { onclick = "[TntExec('tnt_pick_hostage_r_clear')]" }
