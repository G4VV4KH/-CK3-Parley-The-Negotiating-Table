			############################################################
			### 12 - THE VASSAL CONTRACT SHEET   (item 2.5)
			###
			### ONE panel, index-only `visible`, for the same structural reason as
			### the marriage editor: the nine tnt_ob_* variables carry NO side
			### suffix because T11 forbids both sides swearing fealty in one deal
			### (30-V2-DESIGN 1 row 2.5), so exactly one contract can ever be
			### edited and there is nothing per-side to open.
			###
			### `tnt_contract_rows` AND `tnt_contract_title` ARE BOTH LEFT AT THEIR
			### DEFAULTS, and that is a division of labour rather than an omission.
			### Filling the rows means naming eleven controls' worth of identifiers -
			### tnt_ob_tax / tnt_ob_levy as 0..4 levels, seven 0/1 rights, their
			### setters, their availability values and their level-name loc keys -
			### and only author:hooks-contracts knows them: 30-V2-DESIGN 1 row 2.5
			### names the two levels and then says "seven 0/1 rights" without listing
			### them. Guessing identifiers across an agent boundary is exactly how
			### build 1 shipped defect B-3, so the sheet is written in the file that
			### owns the variables, and this file only decides WHERE it appears.
			### That author built it out of THIS mod's own reserved shapes -
			### tnt_panel_contract derives from tnt_editor_panel, and the rows use
			### tnt_level_stepper and tnt_toggle_line - so build 1's five shells are
			### no longer merely a fallback set: three of them are load-bearing.
			###
			### `visible` IS SET HERE, and it tests the INDEX ONLY - no side clause,
			### the same shape as the marriage editor at index 5. The opener
			### tnt_pick_contract_open writes tnt_picker_side = 0 anyway, so a
			### two-key test would work too; index-only is chosen because it cannot
			### be broken by a future second opener that writes side 1, and because
			### there is nothing per-side to select - index 12 edits the single
			### contract T11 guarantees can only exist on one side.
			############################################################
			tnt_panel_contract = {
				name = "tnt_panel_contract_sheet"
				visible = "[EqualTo_CFixedPoint( TntNum('tnt_picker'), '(CFixedPoint)12' )]"
			}

			############################################################
			### 16 / 17 / 18 - THE SIX PEOPLE PANELS   (item 19)
			###
			### SIX LINES, AND THAT IS THE WHOLE INTEGRATION - the same deal the
			### six multi-select panels above are instantiated under. Each type in
			### gui/tnt_panel_people.gui carries its own two-key `visible` (the
			### frozen index 16 / 17 / 18 plus the side), its own
			### `parentanchor = center` and every contract block already filled, so
			### nothing is overridden from here. The rule THIS file wrote down for
			### the marriage editor applies unchanged: when a panel author ships
			### working defaults, the window instantiates and overrides nothing -
			### guessing block bodies across an agent boundary is how build 1
			### shipped defect B-3.
			###
			### EVERY INSTANCE OVERRIDES `name`, and it is not cosmetic: each type
			### sets a name in its own body, and a same-named direct sibling of this
			### block makes the engine log "Duplicate children with the same name
			### override previous widgets" - a line carrying tnt_, which the
			### acceptance bar forbids in error.log.
			###
			### NO CAP OVERRIDE ON ANY PANEL ANY MORE - the cap warning is silenced
			### at the source since the artifact-picker fix (see the amended V3 note
			### above the title/claim instantiations): no derived type fills
			### block "tnt_multi_cap_visible", and its type default is hidden. The
			### two courtier types never wired it anyway (the contract registers no
			### tnt_cap_hit_courtier_<side>_value, and a warning bound to a value
			### that does not exist logs on every evaluation). The three-courtier
			### limit is enforced in script.
			############################################################
			tnt_panel_hostage_p = {
				name = "tnt_panel_hostage_p_inst"
			}

			tnt_panel_hostage_r = {
				name = "tnt_panel_hostage_r_inst"
			}

			### RETIRED V16, USER ITEM 5 - the two ward panel instantiations.
			### ATOMIC PAIR with `type tnt_panel_ward_p` / `_r` in
			### gui/tnt_panel_people.gui section 2, which are commented out in the
			### same edit: instantiating a type that is not declared is a .gui LOAD
			### error, so neither half may be revived alone. Same pairing the mod
			### already did for the retired claim panels (:2930, :2969 here against
			### gui/tnt_panel_multiselect.gui:1274, :1355).
#			tnt_panel_ward_p = {
#				name = "tnt_panel_ward_p_inst"
#			}
#
#			tnt_panel_ward_r = {
#				name = "tnt_panel_ward_r_inst"
#			}

			tnt_panel_courtier_p = {
				name = "tnt_panel_courtier_p_inst"
			}

			tnt_panel_courtier_r = {
				name = "tnt_panel_courtier_r_inst"
			}

			### 19 - THE TWO TRANSFERRED-VASSAL PANELS (V26). Declared as
			### `type tnt_panel_subject_p` / `_r` in gui/tnt_panel_people.gui
			### section 4; ATOMIC PAIR with those declarations, exactly as the
			### retired ward pair above - instantiating a type that is not
			### declared is a .gui LOAD error, so neither half may move alone.
			### They override nothing, like the six above them: each type carries
			### its own two-key `visible` (index 19 plus the side), its own
			### `parentanchor = center` and every contract block already filled.
			tnt_panel_subject_p = {
				name = "tnt_panel_subject_p_inst"
			}

			tnt_panel_subject_r = {
				name = "tnt_panel_subject_r_inst"
			}
		}
	}

	####################################################################
	### THE PRESET OVERLAY - EIGHT COMPACT MENUS  (V3 iteration 3, addition 2)
	###
	### The user's request was "avoid many clicks to move a lot of gold". The
	### coarse +/-1000 buttons in the rows answer half of it; these menus answer
	### the other half, because "a year's income" and "everything I can pay" are
	### ONE click each and no amount of stepping gets there reliably.
	###
	### 4 currencies x 2 sides = 8 panels, 4 amounts each = the 32 preset scripted
	### guis author:script shipped. They are NOT in the rows: the brief's own
	### counterweight was "the row itself must stay readable", and 32 more controls
	### in eight 56 px rows is not readable at any width. One opener per row, one
	### modal, four named choices.
	###
	### THE OVERLAY IS DRIVEN BY GetVariableSystem, NOT BY tnt_picker. Every
	### tnt_picker index is written by a scripted gui in tnt_21_pickers.txt and
	### there is no scripted gui that opens a preset menu, so reusing an index
	### would have required inventing an identifier (R2). The GUI variable is also
	### the correct home for this state on the merits - whether a menu is open is
	### not part of the offer, so it must not become a character variable that the
	### save carries and that tnt_close_window_effect has to clean up. The full
	### citation trail is on type tnt_preset_overlay in gui/tnt_types.gui.
	###
	### THE STORED VALUE IS THE ROW KEY - 'gold_p' ... 'influence_r' - so one flag
	### both raises the overlay (Exists) and picks the single visible panel
	### (HasValue). Same two-datafunction pairing as
	### GAME\gui\frontend_mp_game_setup.gui:216-233.
	###
	### EVERY PANEL OVERRIDES `name`: type tnt_preset_menu sets its own
	### name = "tnt_preset_menu", and eight same-named direct siblings of one
	### block make the engine log "Duplicate children with the same name override
	### previous widgets" eight times - and that line would carry a tnt_ path,
	### which the acceptance bar forbids in error.log.
	###
	### WHAT EACH PANEL OVERRIDES, and why the list is short: the shared labels
	### (_half, _none), the shared tooltips and the Clear-on-click that dismisses
	### the modal all live in the type. A panel names only what is genuinely its
	### own - its four scripted guis, its two identifying lines, and the two
	### labels that MUST differ:
	###   tnt_preset_lbl_std / tnt_preset_tt_std  the two GOLD rows only, because
	###       `_std` is a year of income for gold and one customary gift for the
	###       other three - CK3 has no prestige, piety or influence income, so a
	###       shared "a year's" label would make three buttons out of four lie;
	###   tnt_preset_lbl_max                      the four _r rows, because "all I
	###       can" and "all he can" are different people's purses.
	####################################################################
	tnt_preset_overlay = {
		blockoverride "tnt_preset_panels"
		{
			############################################################
			### GOLD - the only currency whose `_std` is a year's income.
			############################################################
			tnt_preset_menu = {
				name = "tnt_preset_gold_p"
				visible = "[GetVariableSystem.HasValue( 'tnt_preset_menu', 'gold_p' )]"

				blockoverride "tnt_preset_menu_currency" { text = "tnt_item_gold" }
				blockoverride "tnt_preset_menu_whose"    { text = "tnt_col_actor" }

				blockoverride "tnt_preset_lbl_std"  { text = "tnt_preset_std_gold" }
				blockoverride "tnt_preset_tt_std" { tooltip = "[Select_CString( TntValid('tnt_gold_p_std'), Localize('tnt_tt_preset_std_gold'), TntTip('tnt_gold_p_std') )]" }
				blockoverride "tnt_preset_tt_half" { tooltip = "[Select_CString( TntValid('tnt_gold_p_half'), Localize('tnt_tt_preset_half'), TntTip('tnt_gold_p_half') )]" }
				blockoverride "tnt_preset_tt_max" { tooltip = "[Select_CString( TntValid('tnt_gold_p_max'), Localize('tnt_tt_preset_max'), TntTip('tnt_gold_p_max') )]" }

				blockoverride "tnt_preset_sgui_std"  { onclick = "[TntExec('tnt_gold_p_std')]" enabled = "[TntValid('tnt_gold_p_std')]" }
				blockoverride "tnt_preset_sgui_half" { onclick = "[TntExec('tnt_gold_p_half')]" enabled = "[TntValid('tnt_gold_p_half')]" }
				blockoverride "tnt_preset_sgui_max"  { onclick = "[TntExec('tnt_gold_p_max')]" enabled = "[TntValid('tnt_gold_p_max')]" }
				blockoverride "tnt_preset_sgui_none" { onclick = "[TntExec('tnt_gold_p_none')]" }
			}

			tnt_preset_menu = {
				name = "tnt_preset_gold_r"
				visible = "[GetVariableSystem.HasValue( 'tnt_preset_menu', 'gold_r' )]"

				blockoverride "tnt_preset_menu_currency" { text = "tnt_item_gold" }
				blockoverride "tnt_preset_menu_whose"    { text = "tnt_col_partner" }

				blockoverride "tnt_preset_lbl_std"  { text = "tnt_preset_std_gold" }
				blockoverride "tnt_preset_tt_std" { tooltip = "[Select_CString( TntValid('tnt_gold_r_std'), Localize('tnt_tt_preset_std_gold'), TntTip('tnt_gold_r_std') )]" }
				blockoverride "tnt_preset_tt_half" { tooltip = "[Select_CString( TntValid('tnt_gold_r_half'), Localize('tnt_tt_preset_half'), TntTip('tnt_gold_r_half') )]" }
				blockoverride "tnt_preset_tt_max" { tooltip = "[Select_CString( TntValid('tnt_gold_r_max'), Localize('tnt_tt_preset_max'), TntTip('tnt_gold_r_max') )]" }
				blockoverride "tnt_preset_lbl_max"  { text = "tnt_preset_max_r" }

				blockoverride "tnt_preset_sgui_std"  { onclick = "[TntExec('tnt_gold_r_std')]" enabled = "[TntValid('tnt_gold_r_std')]" }
				blockoverride "tnt_preset_sgui_half" { onclick = "[TntExec('tnt_gold_r_half')]" enabled = "[TntValid('tnt_gold_r_half')]" }
				blockoverride "tnt_preset_sgui_max"  { onclick = "[TntExec('tnt_gold_r_max')]" enabled = "[TntValid('tnt_gold_r_max')]" }
				blockoverride "tnt_preset_sgui_none" { onclick = "[TntExec('tnt_gold_r_none')]" }
			}

			############################################################
			### PRESTIGE / PIETY / INFLUENCE - `_std` is one customary gift,
			### i.e. one full vanilla bribe, and the label says so. Do NOT
			### override it back to the gold pair on these six panels.
			############################################################
			tnt_preset_menu = {
				name = "tnt_preset_prestige_p"
				visible = "[GetVariableSystem.HasValue( 'tnt_preset_menu', 'prestige_p' )]"

				blockoverride "tnt_preset_menu_currency" { text = "tnt_item_prestige" }
				blockoverride "tnt_preset_menu_whose"    { text = "tnt_col_actor" }

				blockoverride "tnt_preset_tt_std" { tooltip = "[Select_CString( TntValid('tnt_prestige_p_add'), Localize('tnt_tt_preset_std_gift'), TntTip('tnt_prestige_p_add') )]" }
				blockoverride "tnt_preset_tt_half" { tooltip = "[Select_CString( TntValid('tnt_prestige_p_add'), Localize('tnt_tt_preset_half'), TntTip('tnt_prestige_p_add') )]" }
				blockoverride "tnt_preset_tt_max" { tooltip = "[Select_CString( TntValid('tnt_prestige_p_add'), Localize('tnt_tt_preset_max'), TntTip('tnt_prestige_p_add') )]" }

				blockoverride "tnt_preset_sgui_std"  { onclick = "[TntExec('tnt_prestige_p_std')]" enabled = "[TntValid('tnt_prestige_p_std')]" }
				blockoverride "tnt_preset_sgui_half" { onclick = "[TntExec('tnt_prestige_p_half')]" enabled = "[TntValid('tnt_prestige_p_half')]" }
				blockoverride "tnt_preset_sgui_max"  { onclick = "[TntExec('tnt_prestige_p_max')]" enabled = "[TntValid('tnt_prestige_p_max')]" }
				blockoverride "tnt_preset_sgui_none" { onclick = "[TntExec('tnt_prestige_p_none')]" }
			}

			tnt_preset_menu = {
				name = "tnt_preset_prestige_r"
				visible = "[GetVariableSystem.HasValue( 'tnt_preset_menu', 'prestige_r' )]"

				blockoverride "tnt_preset_menu_currency" { text = "tnt_item_prestige" }
				blockoverride "tnt_preset_menu_whose"    { text = "tnt_col_partner" }
				blockoverride "tnt_preset_lbl_max"       { text = "tnt_preset_max_r" }

				blockoverride "tnt_preset_tt_std" { tooltip = "[Select_CString( TntValid('tnt_prestige_r_add'), Localize('tnt_tt_preset_std_gift'), TntTip('tnt_prestige_r_add') )]" }
				blockoverride "tnt_preset_tt_half" { tooltip = "[Select_CString( TntValid('tnt_prestige_r_add'), Localize('tnt_tt_preset_half'), TntTip('tnt_prestige_r_add') )]" }
				blockoverride "tnt_preset_tt_max" { tooltip = "[Select_CString( TntValid('tnt_prestige_r_add'), Localize('tnt_tt_preset_max'), TntTip('tnt_prestige_r_add') )]" }

				blockoverride "tnt_preset_sgui_std"  { onclick = "[TntExec('tnt_prestige_r_std')]" enabled = "[TntValid('tnt_prestige_r_std')]" }
				blockoverride "tnt_preset_sgui_half" { onclick = "[TntExec('tnt_prestige_r_half')]" enabled = "[TntValid('tnt_prestige_r_half')]" }
				blockoverride "tnt_preset_sgui_max"  { onclick = "[TntExec('tnt_prestige_r_max')]" enabled = "[TntValid('tnt_prestige_r_max')]" }
				blockoverride "tnt_preset_sgui_none" { onclick = "[TntExec('tnt_prestige_r_none')]" }
			}

			tnt_preset_menu = {
				name = "tnt_preset_piety_p"
				visible = "[GetVariableSystem.HasValue( 'tnt_preset_menu', 'piety_p' )]"

				blockoverride "tnt_preset_menu_currency" { text = "tnt_item_piety" }
				blockoverride "tnt_preset_menu_whose"    { text = "tnt_col_actor" }

				blockoverride "tnt_preset_tt_std" { tooltip = "[Select_CString( TntValid('tnt_piety_p_add'), Localize('tnt_tt_preset_std_gift'), TntTip('tnt_piety_p_add') )]" }
				blockoverride "tnt_preset_tt_half" { tooltip = "[Select_CString( TntValid('tnt_piety_p_add'), Localize('tnt_tt_preset_half'), TntTip('tnt_piety_p_add') )]" }
				blockoverride "tnt_preset_tt_max" { tooltip = "[Select_CString( TntValid('tnt_piety_p_add'), Localize('tnt_tt_preset_max'), TntTip('tnt_piety_p_add') )]" }

				blockoverride "tnt_preset_sgui_std"  { onclick = "[TntExec('tnt_piety_p_std')]" enabled = "[TntValid('tnt_piety_p_std')]" }
				blockoverride "tnt_preset_sgui_half" { onclick = "[TntExec('tnt_piety_p_half')]" enabled = "[TntValid('tnt_piety_p_half')]" }
				blockoverride "tnt_preset_sgui_max"  { onclick = "[TntExec('tnt_piety_p_max')]" enabled = "[TntValid('tnt_piety_p_max')]" }
				blockoverride "tnt_preset_sgui_none" { onclick = "[TntExec('tnt_piety_p_none')]" }
			}

			tnt_preset_menu = {
				name = "tnt_preset_piety_r"
				visible = "[GetVariableSystem.HasValue( 'tnt_preset_menu', 'piety_r' )]"

				blockoverride "tnt_preset_menu_currency" { text = "tnt_item_piety" }
				blockoverride "tnt_preset_menu_whose"    { text = "tnt_col_partner" }
				blockoverride "tnt_preset_lbl_max"       { text = "tnt_preset_max_r" }

				blockoverride "tnt_preset_tt_std" { tooltip = "[Select_CString( TntValid('tnt_piety_r_add'), Localize('tnt_tt_preset_std_gift'), TntTip('tnt_piety_r_add') )]" }
				blockoverride "tnt_preset_tt_half" { tooltip = "[Select_CString( TntValid('tnt_piety_r_add'), Localize('tnt_tt_preset_half'), TntTip('tnt_piety_r_add') )]" }
				blockoverride "tnt_preset_tt_max" { tooltip = "[Select_CString( TntValid('tnt_piety_r_add'), Localize('tnt_tt_preset_max'), TntTip('tnt_piety_r_add') )]" }

				blockoverride "tnt_preset_sgui_std"  { onclick = "[TntExec('tnt_piety_r_std')]" enabled = "[TntValid('tnt_piety_r_std')]" }
				blockoverride "tnt_preset_sgui_half" { onclick = "[TntExec('tnt_piety_r_half')]" enabled = "[TntValid('tnt_piety_r_half')]" }
				blockoverride "tnt_preset_sgui_max"  { onclick = "[TntExec('tnt_piety_r_max')]" enabled = "[TntValid('tnt_piety_r_max')]" }
				blockoverride "tnt_preset_sgui_none" { onclick = "[TntExec('tnt_piety_r_none')]" }
			}

			### The two influence panels are reachable only when the influence
			### rows themselves are - both rows are gated on
			### TntPos('tnt_influence_ok_value'), and a hidden row's opener
			### cannot be clicked, so these two need no gate of their own.
			tnt_preset_menu = {
				name = "tnt_preset_influence_p"
				visible = "[GetVariableSystem.HasValue( 'tnt_preset_menu', 'influence_p' )]"

				blockoverride "tnt_preset_menu_currency" { text = "tnt_item_influence" }
				blockoverride "tnt_preset_menu_whose"    { text = "tnt_col_actor" }

				blockoverride "tnt_preset_sgui_std"  { onclick = "[TntExec('tnt_influence_p_std')]" }
				blockoverride "tnt_preset_sgui_half" { onclick = "[TntExec('tnt_influence_p_half')]" }
				blockoverride "tnt_preset_sgui_max"  { onclick = "[TntExec('tnt_influence_p_max')]" }
				blockoverride "tnt_preset_sgui_none" { onclick = "[TntExec('tnt_influence_p_none')]" }
			}

			tnt_preset_menu = {
				name = "tnt_preset_influence_r"
				visible = "[GetVariableSystem.HasValue( 'tnt_preset_menu', 'influence_r' )]"

				blockoverride "tnt_preset_menu_currency" { text = "tnt_item_influence" }
				blockoverride "tnt_preset_menu_whose"    { text = "tnt_col_partner" }
				blockoverride "tnt_preset_lbl_max"       { text = "tnt_preset_max_r" }

				blockoverride "tnt_preset_sgui_std"  { onclick = "[TntExec('tnt_influence_r_std')]" }
				blockoverride "tnt_preset_sgui_half" { onclick = "[TntExec('tnt_influence_r_half')]" }
				blockoverride "tnt_preset_sgui_max"  { onclick = "[TntExec('tnt_influence_r_max')]" }
				blockoverride "tnt_preset_sgui_none" { onclick = "[TntExec('tnt_influence_r_none')]" }
			}
		}
	}


	####################################################################
	### RESULT BANNER - accepted / refused, dismissed by tnt_clear_result
	####################################################################
	tnt_result_banner = {}
}
