																blockoverride "tnt_interest_heading" { text = "[Select_CString( Or( TntPos('tnt_interest_ob_council_base_value'), Not( TntPos('tnt_interest_ob_council_selected_value') ) ), Localize('tnt_interest_receive'), Localize('tnt_interest_surrender') )]" }
																blockoverride "tnt_interest_detail" { text = "tnt_ob_council_label" }
																blockoverride "tnt_interest_empty_state" { visible = "[Not( TntPos('tnt_interest_ob_council_selected_value') )]" text = "tnt_interest_preview_contract" }
																blockoverride "tnt_interest_preview_breakdown" { visible = "[Not( TntPos('tnt_interest_ob_council_selected_value') )]" datacontext = "[TntBreakdown('tnt_interest_ob_council_preview_percent_value')]" }
																blockoverride "tnt_interest_breakdown" { visible = "[TntPos('tnt_interest_ob_council_selected_value')]" datacontext = "[TntBreakdown('tnt_interest_ob_council_percent_value')]" }
																blockoverride "tnt_interest_points" { visible = "[TntPos('tnt_interest_ob_council_selected_value')]" }
																blockoverride "tnt_interest_points_effective" { raw_text = "[Localize('tnt_interest_effective_percent')]: [TntSV('tnt_interest_ob_council_display_percent_value')|2]%" }
																blockoverride "tnt_interest_points_base" { raw_text = "[Localize('tnt_interest_base_points')]: [TntSV('tnt_interest_ob_council_base_value')|3]" }
