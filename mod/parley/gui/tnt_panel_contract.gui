																blockoverride "tnt_interest_preview_breakdown" { visible = "[Not( TntPos('tnt_interest_ob_succ_selected_value') )]" datacontext = "[TntBreakdown('tnt_interest_ob_succ_preview_percent_value')]" }
																blockoverride "tnt_interest_breakdown" { visible = "[TntPos('tnt_interest_ob_succ_selected_value')]" datacontext = "[TntBreakdown('tnt_interest_ob_succ_percent_value')]" }
																blockoverride "tnt_interest_points" { visible = "[TntPos('tnt_interest_ob_succ_selected_value')]" }
																blockoverride "tnt_interest_points_effective" { raw_text = "[Localize('tnt_interest_effective_percent')]: [TntSV('tnt_interest_ob_succ_display_percent_value')|2]%" }
																blockoverride "tnt_interest_points_base" { raw_text = "[Localize('tnt_interest_base_points')]: [TntSV('tnt_interest_ob_succ_base_value')|3]" }
																blockoverride "tnt_interest_points_adjusted" { raw_text = "[Localize('tnt_interest_adjusted_points')]: [TntSV('tnt_interest_ob_succ_adjusted_value')|3]" }
															}
														}
													}
												}
											}
											visible = "[TntPos('tnt_ob_feudal_value')]"

											blockoverride "tnt_contract_right_icon" { texture = "gfx/interface/icons/flat_icons/succession.dds" }

											blockoverride "tnt_contract_right_seal" { visible = "[TntOn('tnt_ob_succ')]" }

											blockoverride "tnt_toggle_line_label"   { text = "tnt_ob_succ_label" }
											blockoverride "tnt_toggle_line_tooltip" { tooltip = "tnt_ob_succ_desc" }
											blockoverride "tnt_toggle_line_sgui"    { onclick = "[TntExec('tnt_ob_succ_toggle')]" }
											blockoverride "tnt_toggle_line_var"     { checked = "[TntOn('tnt_ob_succ')]" }
											blockoverride "tnt_toggle_line_enabled" { enabled = "[TntPos('tnt_ob_succ_ok_value')]" }
											blockoverride "tnt_toggle_line_box_tooltip" { tooltip = "tnt_ob_succ_desc" }
										}
									}
								}
							}
						}
					}
				}

				divider_light = {
					layoutpolicy_horizontal = expanding
				}

				############################################################
				### FOOTER - how to undo it, whether anything is done at all,
				###          and what the sheet is worth
				###
				### THE MIDDLE OF THESE THREE IS NEW IN v3 ITERATION 5, and it is
				### the brief's "make an untouched sheet visibly mean vanilla
				### default terms rather than all zero". tnt_ob_changed_value
				### counts the terms that differ from vanilla's own defaults -
				### level 2 on both ladders, none of the seven rights - and its
				### author's header asks for exactly this widget:
				### "a '3 terms changed' readout on the panel footer or the centre
				### card. Nobody has pointed a widget at it yet."
				### (tnt_55_hc_values.txt:1082-1093). Now something does.
				### Two mutually exclusive text_single children of one vbox under
				### `ignoreinvisible = yes`, each `visible` a single script-value
				### test - the shape tnt_ab_tooltip already uses three times over
				### (tnt_types.gui:1352-1386). The "N altered" wording gets its
				### number from the loc key itself, exactly as tnt_ctx_contract
				### already does (tnt_l_english.yml:1267).
				###
				### THE FIGURE is tnt_ob_sheet_total_value, ALREADY SIGNED FROM
				### THE PARTNER'S POINT OF VIEW like every number in this window
				### (tnt_55_hc_values.txt §0.3), so a positive figure means the
				### terms push the partner towards yes. `|+=0` prints the sign,
				### the same token the headline uses.
				###
				### The total label drops from 200 px to 190 to buy the status
				### line its 204 - see the width budget in the file header.
				############################################################
				hbox = {
					name = "tnt_contract_footer"
					layoutpolicy_horizontal = expanding
					### USER ITEM 8: 40 -> 42, the multi-select panels' own footer
					### band (tnt_panel_multiselect.gui, tnt_multi_footer), so the
					### two 760 px panels close on the same line. The vertical
					### budget in the file header carries the 2 px.
					size = { 0 42 }
					maximumsize = { -1 42 }
					spacing = 8
					margin = { 6 0 }

					### R5: a plain widget host, so the button may centre.
					widget = {
						name = "tnt_contract_reset_holder"
						size = { 180 100% }

						button_standard = {
							name = "tnt_contract_reset"
							size = { 176 30 }
							parentanchor = vcenter|left
							text = "tnt_ob_reset_btn"
							tooltip = "tnt_ob_reset_tt"
							using = tooltip_es
							onclick = "[TntExec('tnt_ob_reset')]"
						}
					}

					### R6: a vbox is a legal child of an hbox - the rule that
					### bans it bans an hbox/vbox inside a (flow)container, and
					### there is no container on this sheet. R5: neither of the
					### two lines anchors, they stack from the top of the box,
					### which is where a 40 px footer wants a single 18 px line.
					vbox = {
						name = "tnt_contract_status"
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding
						spacing = 0
						ignoreinvisible = yes
						alwaystransparent = yes

						expand = {
							name = "tnt_contract_status_pad_top"
						}

						### R-SPILL in full: this line prints a translated
						### sentence with a number in it, so `autoresize = no`,
						### expanding, and the inherited `elide = right` is never
						### overridden.
						text_single = {
							name = "tnt_contract_status_default"
							layoutpolicy_horizontal = expanding
							autoresize = no
							text = "tnt_ob_status_default"
							visible = "[Not( TntPos('tnt_ob_changed_value') )]"
							align = nobaseline|left
							default_format = "#weak"
							alwaystransparent = yes
							fontsize_min = 11
							using = Font_Size_Small
						}

						text_single = {
							name = "tnt_contract_status_changed"
							layoutpolicy_horizontal = expanding
							autoresize = no
							text = "tnt_ob_status_changed"
							visible = "[TntPos('tnt_ob_changed_value')]"
							align = nobaseline|left
							default_format = "#medium"
							alwaystransparent = yes
							fontsize_min = 11
							using = Font_Size_Small
						}

						expand = {
							name = "tnt_contract_status_pad_bottom"
						}
					}

					text_single = {
						name = "tnt_contract_total_label"
						min_width = 190
						max_width = 190
						autoresize = no
						text = "tnt_ob_total_label"
						align = nobaseline|right
						default_format = "#weak"
						alwaystransparent = yes
						fontsize_min = 12
						using = Font_Size_Small
					}

					text_single = {
						name = "tnt_contract_total_value"
						min_width = 70
						max_width = 70
						autoresize = no
						text = "[TntSV('tnt_ob_sheet_total_value')|+=0]"
						align = nobaseline|right
						default_format = "#high"
						alwaystransparent = yes
						fontsize_min = 12
						using = Font_Size_Medium
					}
				}
			}
		}
	}

}
