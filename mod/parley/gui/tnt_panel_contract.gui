										################################
										### 9 - FORCED PARTITION
										###     succession_rights ->
										###     …_forced_partition
										###
										### THE ONE ROW ON THE SHEET THAT FAVOURS
										### THE LIEGE (score -1, subject_opinion
										### -5, flag locked_to_partition,
										### :433-466), so ticking it moves the
										### balance the other way. Its own loc
										### says so in its first sentence, and it
										### is LAST in the clause for the same
										### reason: a term you take does not
										### belong among the six you give.
										################################
										tnt_contract_right_row = {
											name = "tnt_contract_row_succ"
											blockoverride "tnt_contract_interest" {
												tnt_interest_badge = {
