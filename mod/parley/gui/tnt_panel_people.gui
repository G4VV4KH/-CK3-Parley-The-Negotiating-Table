	####################################################################
	### 3. COURTIER TRANSFER - overlay index 18, MULTI-SELECT
	###
	### Up to three people move court, so this is the two-list shape and not a
	### single-object picker: a click MOVES a row between tnt_list_courtier_*
	### (available) and tnt_sel_courtier_* (chosen), and the COLUMN a row is in
	### IS its selection state. That is why there is no `down` anywhere below -
	### the engine has no membership datafunction, which is the whole reason the
	### two-list shape exists (gui/tnt_panel_multiselect.gui, section header).
	###
	### THE ROWS ARE tnt_multi_row_char, author:multiselect's own character row -
	### portrait, name, primary title, and a glyph block the chosen column swaps
	### from plus to minus. A courtier is a Character, so the title and artifact
	### rows would unwrap the wrong thing.
	###
	### THE CAP WARNING IS SWITCHED OFF, and the cap is real. The contract caps
	### the selection at three, but it enforces that in SCRIPT
	### (tnt_can_courtier_trigger / the add gui), and there is no
	### tnt_cap_hit_courtier_<side>_value in the register for this panel to read.
	### Printing tnt_err_too_many off a value that does not exist would log on
	### every evaluation, so the line stays hidden. Since the artifact-picker fix
	### NO derived type wires the warning any more (the base default is hidden;
	### see gui\tnt_panel_multiselect.gui section 2) - the explicit `visible = no`
	### below is kept as the documented wiring point should a cap flag ever land,
	### and it is the DERIVED-TYPE level, which is the only level that can still
	### fill the block (an instance-level blockoverride matches nothing once a
	### derived type has consumed the slot).
	###
	### THE POINTS FIGURE READS tnt_val_courtier_multi_<side>_value DIRECTLY.
	### The _p panels of the older terms pass a SCALED wrapper
	### (tnt_shown_title_multi_p_value) so the number matches the scales; no such
	### wrapper is registered for courtiers, and inventing one here would be a
	### second price for one term. The figure is therefore the raw term price on
	### both sides, which is the number that enters the totals.
	###
	### THE RULE LINE LIVES IN block "tnt_multi_domain". That block is EMPTY by
	### default since user item 17(b) made the domain counter title-panel-only,
	### it sits between the two columns and the footer, and a panel-wide note is
	### precisely what a free full-width slot there is good for. Nothing about
	### domains is printed by these two panels - moving courtiers moves no land.
	####################################################################

	### 18 / side 0 - courtiers the PLAYER hands over.
	type tnt_panel_courtier_p = tnt_panel_multi
	{
		name = "tnt_panel_courtier_p"
		visible = "[And( EqualTo_CFixedPoint( TntNum('tnt_picker'), '(CFixedPoint)18' ), EqualTo_CFixedPoint( TntNum('tnt_picker_side'), '(CFixedPoint)0' ) )]"

		blockoverride "tnt_multi_title"        { text = "tnt_picker_title_courtier_p" }
		blockoverride "tnt_multi_counter"      { text = "tnt_sel_count_courtier_p" }
		# THE SCALED WRAPPER, NEVER THE BASE. Every other _p picker quotes its
		# tnt_shown_* name; this one quoted the raw price, so the number under the
		# courtier list disagreed with the headline whenever the deal multiplier
		# was not exactly 1. The wrapper's own header states the rule
		# (tnt_58_person_values.txt:516-527).
		blockoverride "tnt_multi_points_value" { text = "[TntSV('tnt_interest_courtier_p_display_value')|+=0]" }
		blockoverride "tnt_multi_cap_visible"  { visible = no }
		blockoverride "tnt_multi_clear_click"  { onclick = "[TntExec('tnt_sel_courtier_p_clear')]"  tooltip = "tnt_btn_none" }

		blockoverride "tnt_multi_available_empty"
		{
			text = "tnt_picker_empty"
			visible = "[IsDataModelEmpty( TntList('tnt_list_courtier_p') )]"
		}
		blockoverride "tnt_multi_chosen_empty"
		{
			text = "tnt_picker_chosen_empty"
			visible = "[IsDataModelEmpty( TntList('tnt_sel_courtier_p') )]"
		}

		blockoverride "tnt_multi_available_list"
		{
			vbox = {
				name = "tnt_multi_rows_avail_courtier_p"
				layoutpolicy_horizontal = expanding
				spacing = 3
				datamodel = "[TntList('tnt_list_courtier_p')]"

				item = {
					tnt_multi_row_char = {
						name = "tnt_multi_avail_courtier_p_row"
						datacontext = "[Scope.Char]"
						size = { 0 45 }

						blockoverride "tnt_multi_row_click"   { onclick = "[TntPickChar('tnt_sel_courtier_p_add')]" }
						blockoverride "tnt_multi_row_tooltip" { tooltip = "tnt_btn_add_term" }
					}
				}
			}
		}

		blockoverride "tnt_multi_chosen_list"
		{
			vbox = {
				name = "tnt_multi_rows_chosen_courtier_p"
				layoutpolicy_horizontal = expanding
				spacing = 3
				datamodel = "[TntList('tnt_sel_courtier_p')]"

				item = {
					tnt_multi_row_char = {
						name = "tnt_multi_chosen_courtier_p_row"
						datacontext = "[Scope.Char]"
						size = { 0 45 }

						blockoverride "tnt_multi_row_click"   { onclick = "[TntPickChar('tnt_sel_courtier_p_remove')]" }
						blockoverride "tnt_multi_row_tooltip" { tooltip = "tnt_btn_remove_term" }
						blockoverride "tnt_multi_row_glyph"
						{
							button_minus_small = {
								name = "tnt_multi_row_glyph_icon"
								parentanchor = center
								alwaystransparent = yes
							}
						}
					}
				}
			}
		}

		blockoverride "tnt_multi_domain"
		{
			text_multi = {
				name = "tnt_rule_courtier_p"
				layoutpolicy_horizontal = expanding
				text = "tnt_picker_rule_courtier"
				autoresize = yes
				max_width = 700
				default_format = "#weak"
				alwaystransparent = yes
				fontsize_min = 12
				using = Font_Size_Small
			}
		}
	}


	### 18 / side 1 - courtiers the PARTNER hands over.
	type tnt_panel_courtier_r = tnt_panel_multi
	{
		name = "tnt_panel_courtier_r"
		visible = "[And( EqualTo_CFixedPoint( TntNum('tnt_picker'), '(CFixedPoint)18' ), EqualTo_CFixedPoint( TntNum('tnt_picker_side'), '(CFixedPoint)1' ) )]"

		blockoverride "tnt_multi_title"        { text = "tnt_picker_title_courtier_r" }
		blockoverride "tnt_multi_counter"      { text = "tnt_sel_count_courtier_r" }
		blockoverride "tnt_multi_points_value" { text = "[TntSV('tnt_interest_courtier_r_display_value')|+=0]" }
		blockoverride "tnt_multi_cap_visible"  { visible = no }
		blockoverride "tnt_multi_clear_click"  { onclick = "[TntExec('tnt_sel_courtier_r_clear')]"  tooltip = "tnt_btn_none" }

		blockoverride "tnt_multi_available_empty"
		{
			text = "tnt_picker_empty"
			visible = "[IsDataModelEmpty( TntList('tnt_list_courtier_r') )]"
		}
		blockoverride "tnt_multi_chosen_empty"
		{
			text = "tnt_picker_chosen_empty"
			visible = "[IsDataModelEmpty( TntList('tnt_sel_courtier_r') )]"
		}

		blockoverride "tnt_multi_available_list"
		{
			vbox = {
				name = "tnt_multi_rows_avail_courtier_r"
				layoutpolicy_horizontal = expanding
				spacing = 3
				datamodel = "[TntList('tnt_list_courtier_r')]"

				item = {
					tnt_multi_row_char = {
						name = "tnt_multi_avail_courtier_r_row"
						datacontext = "[Scope.Char]"
						size = { 0 45 }

						blockoverride "tnt_multi_row_click"   { onclick = "[TntPickChar('tnt_sel_courtier_r_add')]" }
						blockoverride "tnt_multi_row_tooltip" { tooltip = "tnt_btn_add_term" }
					}
				}
			}
		}

		blockoverride "tnt_multi_chosen_list"
		{
			vbox = {
				name = "tnt_multi_rows_chosen_courtier_r"
				layoutpolicy_horizontal = expanding
				spacing = 3
				datamodel = "[TntList('tnt_sel_courtier_r')]"

				item = {
					tnt_multi_row_char = {
						name = "tnt_multi_chosen_courtier_r_row"
						datacontext = "[Scope.Char]"
						size = { 0 45 }

						blockoverride "tnt_multi_row_click"   { onclick = "[TntPickChar('tnt_sel_courtier_r_remove')]" }
						blockoverride "tnt_multi_row_tooltip" { tooltip = "tnt_btn_remove_term" }
						blockoverride "tnt_multi_row_glyph"
						{
							button_minus_small = {
								name = "tnt_multi_row_glyph_icon"
								parentanchor = center
								alwaystransparent = yes
							}
						}
					}
				}
			}
		}

		blockoverride "tnt_multi_domain"
		{
			text_multi = {
				name = "tnt_rule_courtier_r"
				layoutpolicy_horizontal = expanding
				text = "tnt_picker_rule_courtier"
				autoresize = yes
				max_width = 700
				default_format = "#weak"
				alwaystransparent = yes
				fontsize_min = 12
				using = Font_Size_Small
			}
		}
	}


	####################################################################
	### 4. TRANSFER A VASSAL - overlay index 19, MULTI-SELECT   (V26)
	###
	### THE THIRD PEOPLE TERM, and the second one with a selection list. A click
	### MOVES a row between tnt_list_subject_* (available) and tnt_sel_subject_*
	### (chosen), and the COLUMN a row is in IS its selection state - which is
	### why there is no `down` anywhere below (the engine has no membership
	### datafunction; gui/tnt_panel_multiselect.gui, section header).
	###
	### INDEX 19 WAS THE FIRST STILL-FREE ENTRY of this file's frozen table. The
	### table now reads: in use 5, 6, 10, 12, 16, 18, 19; still free 1, 9, 14,
	### 15, 20+; RETIRED, not free 2, 3, 4, 7, 8, 11, 13, 17.
	###
	### THE ROWS ARE tnt_multi_row_char, the same character row the courtier
	### panels use: a transferred vassal is a Character, so the title and
	### artifact rows would unwrap the wrong thing. The row prints his primary
	### title, which is exactly the information this term is bought for.
	###
	### THE CAP WARNING IS SWITCHED OFF AT THE DERIVED-TYPE LEVEL, and it must
	### be: this term has NO cap and therefore no tnt_cap_hit_subject_<side>_value
	### for the warning to read, and a widget bound to a script value that does
	### not exist logs on EVERY evaluation (gui\tnt_diplomacy_window.gui, the
	### instantiation block's note). An instance-level blockoverride would match
	### nothing once a derived type has consumed the slot, so it is written here.
	###
	### THE POINTS FIGURE: the _p panel quotes the SCALED WRAPPER
	### tnt_shown_subject_multi_p_value and never the base, because the base is a
	### member of tnt_gain_total_value, which the headline multiplies by
	### tnt_deal_mult_value - quoting the base is defect D4, the one the courtier
	### _p panel carried until it was found (tnt_58_person_values.txt). The _r
	### side deliberately has no wrapper: demands are unscaled (I5), so the raw
	### _r value is already in the right currency.
	###
	### THE RULE LINE LIVES IN block "tnt_multi_domain", empty by default since
	### user item 17(b) made the domain counter title-panel-only. Nothing about
	### domains is printed here - moving a vassal moves no HOLDING into anyone's
	### personal demesne, it moves a subject; the receiver's vassal limit is a
	### different ledger and is deliberately NOT priced (user item 13's ruling
	### against limit discounts, restated for this term in tnt_58_person_values.txt).
	####################################################################

	### 19 / side 0 - the vassals the PLAYER hands over.
	type tnt_panel_subject_p = tnt_panel_multi
	{
		name = "tnt_panel_subject_p"
		visible = "[And( EqualTo_CFixedPoint( TntNum('tnt_picker'), '(CFixedPoint)19' ), EqualTo_CFixedPoint( TntNum('tnt_picker_side'), '(CFixedPoint)0' ) )]"

		blockoverride "tnt_multi_title"        { text = "tnt_picker_title_subject_p" }
		blockoverride "tnt_multi_counter"      { text = "tnt_sel_count_subject_p" }
		blockoverride "tnt_multi_points_value" { text = "[TntSV('tnt_interest_subject_p_display_value')|+=0]" }
		blockoverride "tnt_multi_cap_visible"  { visible = no }
		blockoverride "tnt_multi_clear_click"  { onclick = "[TntExec('tnt_sel_subject_p_clear')]"  tooltip = "tnt_btn_none" }

		blockoverride "tnt_multi_available_empty"
		{
			text = "tnt_picker_empty"
			visible = "[IsDataModelEmpty( TntList('tnt_list_subject_p') )]"
		}
		blockoverride "tnt_multi_chosen_empty"
		{
			text = "tnt_picker_chosen_empty"
			visible = "[IsDataModelEmpty( TntList('tnt_sel_subject_p') )]"
		}

		blockoverride "tnt_multi_available_list"
		{
			vbox = {
				name = "tnt_multi_rows_avail_subject_p"
				layoutpolicy_horizontal = expanding
				spacing = 3
				datamodel = "[TntList('tnt_list_subject_p')]"

				item = {
					tnt_multi_row_char = {
						name = "tnt_multi_avail_subject_p_row"
						datacontext = "[Scope.Char]"
						size = { 0 45 }

						blockoverride "tnt_multi_row_click"   { onclick = "[TntPickChar('tnt_sel_subject_p_add')]" }
						blockoverride "tnt_multi_row_tooltip" { tooltip = "tnt_btn_add_term" }
					}
				}
			}
		}

		blockoverride "tnt_multi_chosen_list"
		{
			vbox = {
				name = "tnt_multi_rows_chosen_subject_p"
				layoutpolicy_horizontal = expanding
				spacing = 3
				datamodel = "[TntList('tnt_sel_subject_p')]"

				item = {
					tnt_multi_row_char = {
						name = "tnt_multi_chosen_subject_p_row"
						datacontext = "[Scope.Char]"
						size = { 0 45 }

						blockoverride "tnt_multi_row_click"   { onclick = "[TntPickChar('tnt_sel_subject_p_remove')]" }
						blockoverride "tnt_multi_row_tooltip" { tooltip = "tnt_btn_remove_term" }
						blockoverride "tnt_multi_row_glyph"
						{
							button_minus_small = {
								name = "tnt_multi_row_glyph_icon"
								parentanchor = center
								alwaystransparent = yes
							}
						}
					}
				}
			}
		}

		blockoverride "tnt_multi_domain"
		{
			text_multi = {
				name = "tnt_rule_subject_p"
				layoutpolicy_horizontal = expanding
				text = "tnt_picker_rule_subject"
				autoresize = yes
				max_width = 700
				default_format = "#weak"
				alwaystransparent = yes
				fontsize_min = 12
				using = Font_Size_Small
			}
		}
	}


	### 19 / side 1 - the vassals the PARTNER hands over.
	type tnt_panel_subject_r = tnt_panel_multi
	{
		name = "tnt_panel_subject_r"
		visible = "[And( EqualTo_CFixedPoint( TntNum('tnt_picker'), '(CFixedPoint)19' ), EqualTo_CFixedPoint( TntNum('tnt_picker_side'), '(CFixedPoint)1' ) )]"

