		########################################################
		### ITEM 19 - THE PEOPLE TERMS, GIVING SIDE. THREE OF THE FOUR SURVIVE:
		### the ward / fosterage pair is RETIRED, V16 user item 5.
		###
		### Order matches the negotiation column exactly - independence beside the
		### fealty row it inverts, then hostage, (ward, retired), courtier - so a
		### term is still tracked from the column it was set in down to this sheet.
		###
		### ALL OF THEM CARRY AN X, each wired to a GATE-FREE clear — a removal must
		### never be refusable. Hostage, ward and courtier had clears from the
		### start (tnt_pick_hostage_<side>_clear, tnt_pick_ward_<side>_clear which is
		### retired with its row, tnt_sel_courtier_<side>_clear); independence gained
		### tnt_indep_<side>_clear in V7 (tnt_20_scripted_guis.txt, GROUP X) —
		### until then its rows were deliberately X-less rather than wired to the
		### gated toggle, whose is_valid is the release legality and can refuse.
		###
		### The four prices come from the contract's own value names; the sheet
		### reads the same tnt_val_* the totals are built from, so the sheet and the
		### breakdown tooltip cannot disagree (user item 1.2).
		########################################################
		tnt_sheet_row = {
			name = "tnt_sheet_indep_p"
			blockoverride "tnt_sheet_visible" { visible = "[TntOn('tnt_indep_p')]" }
			blockoverride "tnt_sheet_icon"    { texture = "gfx/interface/icons/character_interactions/independence.dds" }
			blockoverride "tnt_sheet_name"    { text = "tnt_item_indep" }
			### A flag term: the detail column is emptied with `text = ""` and NEVER
			### hidden - it is the row's only expanding child, and hiding it would
			### pull the points column 170 px left of every other row.
			blockoverride "tnt_sheet_detail"  { text = "" }
			blockoverride "tnt_sheet_points"  { text = "[TntSV('tnt_val_indep_p_value')|0]" }
			blockoverride "tnt_sheet_remove"
			{
				button_cancel_small = {
					size = { 20 20 }
					parentanchor = center
					tooltip = "tnt_sheet_remove_tip"
					onclick = "[TntExec('tnt_indep_p_clear')]"
				}
			}
		}

		tnt_sheet_row = {
			name = "tnt_sheet_hostage_p"
			blockoverride "tnt_sheet_visible" { visible = "[TntVar('tnt_hostage_p').Char.IsValid]" }
			blockoverride "tnt_sheet_icon"    { texture = "gfx/interface/icons/character_interactions/icon_hostage.dds" }
			blockoverride "tnt_sheet_name"    { text = "tnt_item_hostage" }
			### USER ITEM 2: THE LINKED NAME. This note used to live on
			### tnt_sheet_nonwar_p and MOVED HERE when user item 1 retired that row;
			### this is now the first surviving singular-character row in the sheet.
			###
			### GetUIName is the tooltipped twin of the shipped GetUINameNoTooltip,
			### so hovering the name opens the character's own tooltip -
			### [Character.GetUIName|U] in an ordinary text at
			### GAME\gui\window_legends.gui:481 is the call site. The cell flips its
			### type-default alwaystransparent INSIDE the override or the hover could
			### never land (the ROW went opaque in V5 already, so only the cell was
			### still hover-through); nothing sits under the detail column, so no
			### click is stolen. Applied to the SINGULAR character rows only
			### (hostage, both sides - ward x2 were the other two until V16 user
			### item 5 retired them, and nonwar x2 before that):
			### the marriage pairs print a LOC key, the list rows
			### print counts (their names live in the panels), and the guards inside
			### tooltips keep NoTooltip because a tooltip inside a tooltip is the one
			### place the link must not fire.
			blockoverride "tnt_sheet_detail"  { text = "[TntVar('tnt_hostage_p').Char.GetUIName]"  alwaystransparent = no }
			blockoverride "tnt_sheet_points"  { text = "[TntSV('tnt_val_hostage_p_value')|0]" }
			blockoverride "tnt_sheet_remove"
			{
				button_cancel_small = {
					size = { 20 20 }
					parentanchor = center
					tooltip = "tnt_sheet_remove_tip"
					onclick = "[TntExec('tnt_pick_hostage_p_clear')]"
				}
			}
		}

