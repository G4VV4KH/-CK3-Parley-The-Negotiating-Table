		### The courtiers are a LIST, so this row follows the same rule as the
		### artifact group above (user item 15a): the detail is the count and the X
		### clears the whole selection, because naming three people in a 470 px
		### column is what the marriage pair rows already proved unreadable.
		### Removing ONE courtier stays in the panel at overlay index 18, where the
		### names are. (The picked-captives row was the other list-shaped row that
		### stated this rule, until user item 7 retired it.)
		tnt_sheet_row = {
			name = "tnt_sheet_courtier_p"
			blockoverride "tnt_sheet_visible" { visible = "[TntAny('tnt_sel_courtier_p')]" }
			blockoverride "tnt_sheet_icon"    { texture = "gfx/interface/icons/character_interactions/courtier_interaction.dds" }
			blockoverride "tnt_sheet_name"    { text = "tnt_item_courtier" }
			blockoverride "tnt_sheet_detail"  { text = "tnt_sel_count_courtier_p" }
			# Scaled wrapper, not the base price - same rule as the picker panel
			# (tnt_58_person_values.txt:516-527).
			blockoverride "tnt_sheet_points"  { text = "[TntSV('tnt_shown_courtier_multi_p_value')|0]" }
			blockoverride "tnt_sheet_remove"
			{
				button_cancel_small = {
					size = { 20 20 }
					parentanchor = center
					tooltip = "tnt_sheet_remove_tip"
					onclick = "[TntExec('tnt_sel_courtier_p_clear')]"
				}
			}
		}

		### THE TRANSFERRED VASSALS (V26). A LIST, so it follows the courtier
		### rule above: the detail is the count and the X clears the whole
		### selection, because naming three rulers with their titles in a 470 px
		### column is what the marriage pair rows already proved unreadable.
		### Removing ONE vassal stays in the panel at overlay index 19, where the
		### names and their primary titles are.
		### THE ROW IS NOT SEPARATELY RULE-GATED, and it does not need to be: the
		### only thing that can make it visible is a non-empty tnt_sel_subject_p,
		### and the only control that can fill that list is the window row, which
		### carries the tnt_advanced conjunct. A game rule cannot change
		### mid-campaign, so with the rule off the list is never non-empty - the
		### same safety-by-unreachability the apply legs rely on (CLAUDE.md 6.13,
		### position C).
		tnt_sheet_row = {
			name = "tnt_sheet_subject_p"
			blockoverride "tnt_sheet_visible" { visible = "[TntAny('tnt_sel_subject_p')]" }
			blockoverride "tnt_sheet_icon"    { texture = "gfx/interface/icons/character_interactions/icon_vassal.dds" }
			blockoverride "tnt_sheet_name"    { text = "tnt_item_subject" }
			blockoverride "tnt_sheet_detail"  { text = "tnt_sel_count_subject_p" }
			# Scaled wrapper, not the base price - same rule as the picker panel
			# and the same defect (D4) it was written to prevent.
			blockoverride "tnt_sheet_points"  { text = "[TntSV('tnt_shown_subject_multi_p_value')|0]" }
			blockoverride "tnt_sheet_remove"
			{
				button_cancel_small = {
					size = { 20 20 }
					parentanchor = center
					tooltip = "tnt_sheet_remove_tip"
					onclick = "[TntExec('tnt_sel_subject_p_clear')]"
				}
			}
		}

		### THE THREAT (V4 expansion 1). It is listed on this side because it is the
		### player's act, but its detail says what it IS rather than what it gives:
		### tnt_threat_sub names the army, the fear and the standing that make it
		### worth anything. The points are read from tnt_val_threat_p_value, the same
		### value the fifth balance figure prints - the threat is the one term that
		### is not inside either column total, so this row and that figure are the
		### only two places it appears, and they read one value.
		### A HOOK SPENT (V4 item 2). Its detail names the strength, because "you used
		### a hook" and "you burned your one favour" are different sentences and the
		### player is entitled to know which he agreed to.
		### V4 item A2: the debt the partner called in. Negative points - it is what he
		### wants over and above the terms - so the sheet shows it with its sign.
		tnt_sheet_row = {
			name = "tnt_sheet_usehook_r"
			blockoverride "tnt_sheet_visible" { visible = "[TntOn('tnt_usehook_r')]" }
			blockoverride "tnt_sheet_icon"    { texture = "gfx/interface/icons/character_interactions/hook_strong.dds" }
			blockoverride "tnt_sheet_name"    { text = "tnt_item_usehook_r" }
			blockoverride "tnt_sheet_detail"  { text = "tnt_usehook_r_sub" }
			blockoverride "tnt_sheet_points"  { text = "[TntSV('tnt_val_usehook_r_value')|+=0]" }
			### Prose detail in an elidable cell - same reason as the threat row.
			blockoverride "tnt_sheet_tooltip" { tooltip = "tnt_item_usehook_r_desc" }
			### NO X (user item 15a): the AI's OWN demand, written by the letter
			### path - read-only by design, like the disabled checkbox on the
			### left-column row tnt_row_usehook_r. The player answers it with a
			### counter-offer or a rejection, not by deleting the AI's line.
		}

		tnt_sheet_row = {
			name = "tnt_sheet_usehook_p"
			blockoverride "tnt_sheet_visible" { visible = "[TntOn('tnt_usehook_p')]" }
			blockoverride "tnt_sheet_icon"    { texture = "gfx/interface/icons/character_interactions/hook_strong.dds" }
			blockoverride "tnt_sheet_name"    { text = "tnt_item_usehook" }
			blockoverride "tnt_sheet_detail"  { text = "tnt_usehook_sub" }
			blockoverride "tnt_sheet_points"  { text = "[TntSV('tnt_val_usehook_p_value')|+=0]" }
			### Prose detail in an elidable cell - same reason as the threat row.
			blockoverride "tnt_sheet_tooltip" { tooltip = "tnt_item_usehook_desc" }
			### The spend-a-hook row's own gated toggle - 2b header's rebind note.
			blockoverride "tnt_sheet_remove"
			{
				button_cancel_small = {
					size = { 20 20 }
					parentanchor = center
					tooltip = "tnt_sheet_remove_tip"
					onclick = "[TntExec('tnt_usehook_p_off')]"
				}
			}
		}

		tnt_sheet_row = {
			name = "tnt_sheet_threat_p"
			blockoverride "tnt_sheet_visible" { visible = "[TntOn('tnt_threat_p')]" }
			blockoverride "tnt_sheet_icon"    { texture = "gfx/interface/icons/icon_dread.dds" }
			blockoverride "tnt_sheet_name"    { text = "tnt_item_threat" }
			blockoverride "tnt_sheet_detail"  { text = "tnt_threat_sub" }
			blockoverride "tnt_sheet_points"  { text = "[TntSV('tnt_val_threat_p_value')|+=0]" }
			### The detail above is prose in a 170 px elidable cell, so the row
			### hands over the same full description the window row gives.
			blockoverride "tnt_sheet_tooltip" { tooltip = "tnt_item_threat_desc" }
			### The threat row's own gated toggle - 2b header's rebind note.
			blockoverride "tnt_sheet_remove"
			{
				button_cancel_small = {
					size = { 20 20 }
					parentanchor = center
					tooltip = "tnt_sheet_remove_tip"
					onclick = "[TntExec('tnt_threat_p_off')]"
				}
			}
		}

		### THE ALLIANCE THE COUPLES BRING - A ROW AT LAST, 2026-08-24.
		###
		### UNTIL THIS ROW THE SHEET PRINTED NOTHING FOR IT AT ALL, and that is a
		### coverage hole rather than a polish complaint: tnt_val_alliance_p_value is
		### a live summand of tnt_gain_total_value (tnt_50_values.txt:2326) worth up
		### to 150 points, and on the very deal the user reported it fired - that
		### run's ALLY row carries yield=1, pre=0. So up to 150 points moved the
		### centre number with no line anywhere on screen naming them. That is the
		### "two numbers that must agree" defect class this sheet keeps being told
		### not to ship, in its worst form: one number and no second number at all.
		###
		### THE RECORDED REFUSAL IS ABOUT A DIFFERENT WIDGET AND MUST NOT BE READ AS
		### IF IT COVERED THIS ONE. It sits inside tnt_balance_value
		### (tnt_50_values.txt:2799-2801) and says a row of its own "would need a
		### SIXTH figure" - the five figures it protects are the BALANCE PANEL's, in
		### gui\tnt_types.gui. A tnt_sheet_row costs no figure whatever: this sheet
		### already carries two derived non-term rows for exactly that reason, the
		### volume discount and the dread row inside the marriage block.
		###
		### WHY IT STANDS LAST ON THIS SIDE INSTEAD OF BESIDE THE COUPLES, and the
		### reason is a property of the row rather than an apology. 2a's ordering
		### rule is "each row sits in the position its term occupies in the
		### negotiation column, or the sheet stops being readable top-to-bottom
		### against the column it mirrors" - and THIS ROW MIRRORS NOTHING. The
		### alliance TERM is retired (the tombstone far above), so there is no
		### window row for it to line up with, which makes it the one row in the
		### side with no column position to keep. It therefore joins the tail, where
		### the other figures that are not terms the player ticked already live.
		### The itemised breakdown orders it the other way, immediately BEFORE the
		### marriage row (tnt_50_values.txt:2807-2813); both orders are deliberate
		### and neither is the other's mistake.
		### THE SECOND REASON IS HOUSE LAW 7 AND IT IS WORTH WRITING DOWN: an insert
		### beside the couples moves every line below it in this file, and two
		### citations into this file that a parallel lane owns anchor at :1445 and
		### :1467, inside the two rows immediately above this one. Appending here
		### moves neither.
		###
		### THE GATE IS THE BRIDGE VARIABLE AND NOTHING ELSE - the same row the
		### price's own limit carries, so the row and the charge appear and vanish
		### together. tnt_wed_reprice_all_effect writes it (tnt_34_marriage.txt:972)
		### when vanilla's own yields_alliance says a committed couple opens a pact,
		### and clears it unconditionally at the top of that same effect (:834).
		### A script value may not ask yields_alliance - zero vanilla call sites in
		### GAME\common\script_values - so the flag an EFFECT wrote is the only legal
		### reading of it here. TntOn reads an unset variable as 0, so no exists
		### guard is needed or possible: R13 is about OBJECT variables, and this one
		### is numeric.
		###
		### PERFORMANCE (house law 6) IS UNCHANGED, MEASURED RATHER THAN HOPED.
		### tnt_val_alliance_p_value already runs on this window's per-frame path
		### inside tnt_ai_accept_value, which gui\tnt_types.gui binds to a `text` at
		### :1660 and to two `visible` at :1422 and :1433. This row adds a second
		### evaluation of a value the window computes every frame regardless.
		###
		### NO X: like the volume discount and the dread row this is a derived
		### consequence of the couples on the table and not a term of its own - it
		### is removed by removing the pair that opened it. The RETIRED alliance
		### TERM's row is the commented-out block far above; it had an X because it
		### was something the player bought. Do not confuse the two and do not
		### revive that one.
		###
		### ZERO NEW LOCALIZATION: tnt_item_alliance and tnt_bd_alliance_p both
		### already ship in all nine languages and neither carries a [..] token.
		### `|0` and not `|+=0` because the value is clamped to 0..150 and every
		### other tnt_val_* row in this column prints unsigned; the marriage rows
		### sign themselves only because their nets can go negative.
		tnt_sheet_row = {
			name = "tnt_sheet_wed_ally"
			blockoverride "tnt_sheet_visible" { visible = "[TntOn('tnt_wed_ally_any')]" }
			blockoverride "tnt_sheet_icon"    { texture = "gfx/interface/icons/character_interactions/alliance.dds" }
			blockoverride "tnt_sheet_name"    { text = "tnt_item_alliance" }
			blockoverride "tnt_sheet_detail"  { text = "tnt_bd_alliance_p" }
			blockoverride "tnt_sheet_points"  { text = "[TntSV('tnt_val_alliance_p_value')|0]" }
		}

		### BUILD 1 reserved this block for "the three multi-select datamodels of
		### the player's side", and author:multiselect's own header points the gui
		### owner at it. BUILD 2 put the three groups INLINE above instead, and the
		### reason is a design point rather than laziness: each group has to sit in
		### the position its term occupies in the negotiation column - title after
		### marriage, claim after title, artifact after hook - or the sheet stops
		### being readable top-to-bottom against the column it mirrors. A single
		### block at the bottom of the side would stack all three below the other
		### twelve terms. Same three type instances either way; only their position
		### differs, and position is what the block cannot express.
		### The block stays declared and empty: it costs nothing and it is the
		### natural home for a per-side extension (an AI counter-offer marker, a
		### subtotal row). The example this note used to give - a prisoner sub-list
		### - is retired with the prisoner terms, user item 7.
		block "tnt_sheet_multi_p" {}

		spacer = {
			size = { 0 6 }
		}

