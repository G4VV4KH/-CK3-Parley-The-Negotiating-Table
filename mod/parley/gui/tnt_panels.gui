		tnt_sheet_row = {
			name = "tnt_sheet_indep_r"
			blockoverride "tnt_sheet_visible" { visible = "[TntOn('tnt_indep_r')]" }
			blockoverride "tnt_sheet_icon"    { texture = "gfx/interface/icons/character_interactions/independence.dds" }
			blockoverride "tnt_sheet_name"    { text = "tnt_item_indep" }
			blockoverride "tnt_sheet_detail"  { text = "" }
			blockoverride "tnt_sheet_points"  { text = "[TntSV('tnt_val_indep_r_value')|0]" }
			blockoverride "tnt_sheet_remove"
			{
				button_cancel_small = {
					size = { 20 20 }
					parentanchor = center
					tooltip = "tnt_sheet_remove_tip"
					onclick = "[TntExec('tnt_indep_r_clear')]"
				}
			}
		}

		tnt_sheet_row = {
			name = "tnt_sheet_hostage_r"
			blockoverride "tnt_sheet_visible" { visible = "[TntVar('tnt_hostage_r').Char.IsValid]" }
			blockoverride "tnt_sheet_icon"    { texture = "gfx/interface/icons/character_interactions/icon_hostage.dds" }
			blockoverride "tnt_sheet_name"    { text = "tnt_item_hostage" }
			### User item 2: linked name - the full note is on tnt_sheet_hostage_p.
			blockoverride "tnt_sheet_detail"  { text = "[TntVar('tnt_hostage_r').Char.GetUIName]"  alwaystransparent = no }
			blockoverride "tnt_sheet_points"  { text = "[TntSV('tnt_val_hostage_r_value')|0]" }
			blockoverride "tnt_sheet_remove"
			{
				button_cancel_small = {
					size = { 20 20 }
					parentanchor = center
					tooltip = "tnt_sheet_remove_tip"
					onclick = "[TntExec('tnt_pick_hostage_r_clear')]"
				}
			}
		}

		### RETIRED V16, USER ITEM 5 - the _r twin of the retired ward sheet row in
		### the _p block above, where the tombstone is.
#		tnt_sheet_row = {
#			name = "tnt_sheet_ward_r"
#			blockoverride "tnt_sheet_visible" { visible = "[TntVar('tnt_ward_r').Char.IsValid]" }
#			blockoverride "tnt_sheet_icon"    { texture = "gfx/interface/icons/character_interactions/child.dds" }
#			blockoverride "tnt_sheet_name"    { text = "tnt_item_ward" }
#			### User item 2: linked name - the full note is on tnt_sheet_hostage_p.
#			blockoverride "tnt_sheet_detail"  { text = "[TntVar('tnt_ward_r').Char.GetUIName]"  alwaystransparent = no }
#			blockoverride "tnt_sheet_points"  { text = "[TntSV('tnt_val_ward_r_value')|0]" }
#			blockoverride "tnt_sheet_remove"
#			{
#				button_cancel_small = {
#					size = { 20 20 }
#					parentanchor = center
#					tooltip = "tnt_sheet_remove_tip"
#					onclick = "[TntExec('tnt_pick_ward_r_clear')]"
#				}
#			}
#		}

		tnt_sheet_row = {
			name = "tnt_sheet_courtier_r"
			blockoverride "tnt_sheet_visible" { visible = "[TntAny('tnt_sel_courtier_r')]" }
			blockoverride "tnt_sheet_icon"    { texture = "gfx/interface/icons/character_interactions/courtier_interaction.dds" }
			blockoverride "tnt_sheet_name"    { text = "tnt_item_courtier" }
			blockoverride "tnt_sheet_detail"  { text = "tnt_sel_count_courtier_r" }
			blockoverride "tnt_sheet_points"  { text = "[TntSV('tnt_val_courtier_multi_r_value')|0]" }
			blockoverride "tnt_sheet_remove"
			{
				button_cancel_small = {
					size = { 20 20 }
					parentanchor = center
					tooltip = "tnt_sheet_remove_tip"
					onclick = "[TntExec('tnt_sel_courtier_r_clear')]"
				}
			}
		}

		### THE TRANSFERRED VASSALS, partner's side (V26). The mirror of
		### tnt_sheet_subject_p; the points read the RAW _r value because demands
		### are unscaled (I5) and no tnt_shown_* wrapper is registered for them.
		tnt_sheet_row = {
			name = "tnt_sheet_subject_r"
			blockoverride "tnt_sheet_visible" { visible = "[TntAny('tnt_sel_subject_r')]" }
			blockoverride "tnt_sheet_icon"    { texture = "gfx/interface/icons/character_interactions/icon_vassal.dds" }
			blockoverride "tnt_sheet_name"    { text = "tnt_item_subject" }
			blockoverride "tnt_sheet_detail"  { text = "tnt_sel_count_subject_r" }
			blockoverride "tnt_sheet_points"  { text = "[TntSV('tnt_val_subject_multi_r_value')|0]" }
			blockoverride "tnt_sheet_remove"
			{
				button_cancel_small = {
					size = { 20 20 }
					parentanchor = center
					tooltip = "tnt_sheet_remove_tip"
					onclick = "[TntExec('tnt_sel_subject_r_clear')]"
				}
			}
		}

		### Same as tnt_sheet_multi_p above: still declared, still empty, and the
		### partner's three groups are inline in the positions their terms occupy.
		block "tnt_sheet_multi_r" {}
	}


	####################################################################
	### 3. THE CONTEXTUAL CARD  (bottom of the centre column)
	###
	### Up to seven lines, each independently `visible`-gated, with
	### `ignoreinvisible = yes` on the card so the hidden ones cost no height.
	### Build 1 used only values that already existed in tnt_50_values.txt:
	###   tnt_gold_shortfall_value          (:182)  > 0 means the PLAYER cannot pay
	###   tnt_partner_gold_shortfall_value  (:191)  > 0 means the PARTNER cannot pay
	###   tnt_items_count_value             (:1340) how many terms are on the table
	###
	### BUILD 2 adds four more lines - the two domain counters (idea U1(a)), the
	### marriage pair summary (item 2.1) and the vassal contract summary (item
	### 2.5). Build 1's note said they were "deliberately absent" because
	### referencing an undefined script value logs on EVERY evaluation; that
	### objection is answered rather than ignored:
	###   * the two domain counters are instances of author:multiselect's own
	###     tnt_multi_domain_line, so every identifier in them - the two
	###     tnt_domain_over_*_value flags, the two tnt_domain_line_* loc keys -
	###     is that author's, already used by their own title panels;
	###   * their `visible` is the gate TntPos('tnt_domain_shown_value') - see
	###     the two instances in tnt_context_card below - so nothing renders a
	###     domain number until titles are actually moving; that value is
	###     author:multiselect's own, already evaluated by their title panels;
	###   * the marriage and contract summaries read no script value whatsoever -
	###     they are loc keys that print variables.
	### block "tnt_context_extra" therefore stays free for the next author.
	####################################################################
	type tnt_context_line = hbox
	{
		name = "tnt_context_line"
		layoutpolicy_horizontal = expanding
		size = { 0 28 }
		maximumsize = { -1 28 }
		spacing = 6
		### 4 px vertical margin: 28 - 8 = 20 px of content, which is the 20 px
		### icon and one 18 px line of Font_Size_Small.
		margin = { 4 4 }
		alwaystransparent = yes
		ignoreinvisible = yes

		block "tnt_context_visible"
		{
			visible = no
		}

		widget = {
			name = "tnt_context_icon_holder"
			size = { 22 100% }
			alwaystransparent = yes

			icon = {
				name = "tnt_context_icon"
				size = { 20 20 }
				parentanchor = center
				alwaystransparent = yes

				block "tnt_context_icon"
				{
					texture = "gfx/interface/icons/character_interactions/icon_gold.dds"
				}
			}
		}

		### text_single, not text_multi: the row has a FIXED height, and a
		### text_multi with autoresize = yes would silently wrap to two lines and
		### be clipped by maximumsize. Card lines are written as one-liners and
		### elide, which is R-SPILL applied to our own loc rather than game text.
		text_single = {
			name = "tnt_context_text"
			layoutpolicy_horizontal = expanding
			autoresize = no
			align = nobaseline|left
			alwaystransparent = yes
			fontsize_min = 12
			using = Font_Size_Small

			block "tnt_context_text"
			{
				text = "tnt_ctx_terms"
			}
		}
	}


	####################################################################
	### 3b. THE DOMAIN-LIMIT COUNTER   (idea U1(a), BUILD 2 - MANDATORY)
	###
	### 30-V2-DESIGN section 1 row U1 is blunt about why this exists: the vanilla
	### grant-titles screen itself cannot be reused (it is 100 % C++), but two of
	### its ideas are worth stealing, and the domain counter "becomes MANDATORY
	### once 2.2 lets a player dump five counties on someone".
	###
	### THERE IS NO tnt_domain_counter TYPE IN THIS FILE. One was written - a
	### plain widget with a Status_Bad wash, an icon_domain.dds icon and a
	### "[resulting]/[limit]" text built from FixedPointToInt( ScriptValue ) and
	### Character.GetDomainLimit, copied from GAME\gui\hud.gui:7087-7109 - and it
	### was deleted when gui\tnt_panel_multiselect.gui landed with
	### `type tnt_multi_domain_line`, which is the same widget written by the
	### author who owns the numbers.
	###
	### The two centre-column counters are therefore two INSTANCES of that type,
	### in the contextual card below. Three things came free with the swap, and
	### each of them was a guess this file would otherwise have had to make:
	###   * the over-limit flags are real and named - tnt_domain_over_p_value /
	###     tnt_domain_over_r_value - so the comparison happens in script rather
	###     than being re-derived in the GUI from Character.GetDomainLimit;
	###   * the numbers live inside the loc keys tnt_domain_line_p / _r, which
	###     print tnt_domain_after_p/_r_value and tnt_domain_limit_p/_r_value
	###     themselves, so no loc key of this file has to be invented and the
	###     "N / M" wording is identical in the panel and in the centre column;
	###   * one geometry, so the line cannot look like two different widgets
	###     depending on where the player is looking at it.
	###
	### The panel shows its copy only while the title picker is open; the centre
	### column shows these two whenever a title is on the table, which is what the
	### build-2 task list asked for - the counter belongs where the deal is read,
	### not only where it is edited.
	####################################################################


	### BUILD 2 raised the cap from 96 (three 28 px lines) to 180. BUILD 3 raised it
	### again to 208, because 180 was 24 px short of this card's own maximum content
	### and silently CLIPPED the last child. Do the sum before changing it:
	###     5 x tnt_context_line       @ size = { 0 28 }  (:841)  = 140
	###     2 x tnt_multi_domain_line  @ size = { 0 26 }
	###                        (tnt_panel_multiselect.gui:398)    =  52
	###     6 inter-child gaps         @ spacing = 2              =  12
	###                                                     TOTAL = 204
	### The seven children are afford_p, afford_r, the two domain counters, the
	### marriage pair summary, the contract summary and the neutral term count, and
	### their seven `visible` conditions are INDEPENDENT - a deal that moves a county
	### each way, marries a pair, swears fealty and over-promises gold on both sides
	### satisfies all seven at once, which is a normal ambitious offer and not a
	### contrived one. At 180 the seventh line (tnt_context_terms) was cut off.
	### `ignoreinvisible = yes` removes hidden children and is why one or two lines
	### is the usual case, but it does nothing once all seven are visible.
	### THE VERTICAL BUDGET STILL WORKS. The centre column's fixed content was ~462
	### of ~786 px at the 180 cap, so 208 makes it ~490 and left ~296 for the deal
	### sheet. V5 (user item 15b) folded the verdict row into the headline's
	### tooltip, so the same worst case now reads ~435 fixed and ~351 for the
	### sheet, comfortably above its raised minimumsize = { 0 200 } (scrollbox
	### tnt_deal_sheet_scroll in tnt_types.gui - cited by name, the old line
	### number here had already drifted once).
	type tnt_context_card = vbox
	{
		name = "tnt_context_card"
		layoutpolicy_horizontal = expanding
		minimumsize = { 0 34 }
		maximumsize = { -1 208 }
		spacing = 2
		ignoreinvisible = yes

		background = {
			using = Background_Area_Dark
		}

		########################################################
		### IDEA U1(a) - THE TWO DOMAIN COUNTERS, AND AS OF V3 THEY ARE THE FIRST
		### TWO LINES OF THE CARD.
		###
		### They used to sit third and fourth, under the two gold-shortfall lines.
		### V3 removed the three-object selection cap, so nothing stops a player
		### putting nine counties on the table, and these two lines are now the ONLY
		### signal that a big gift is a bad idea - the panels' cap warning is
		### silenced at the source (no derived type wires it any more, see
		### gui\tnt_panel_multiselect.gui section 2).
		### Being read first is the cheapest prominence there is, and it costs no
		### height: `ignoreinvisible = yes` means the order only matters when a line
		### is actually shown.
		###
		### Both are shown as soon as ANY title is on the table on EITHER side,
		### because a title trade moves both realms' domain size at once: what the
		### player cedes leaves his domain and enters the partner's, and vice
		### versa. Gating each side on only its own list would hide the counter of
		### whichever ruler is RECEIVING, which is precisely the ruler about to
		### break his limit.
		###
		### THE TWO BLOCKOVERRIDES AND THE `visible` ARE EXACTLY WHAT THE TITLE
		### PANELS PASS (gui\tnt_panel_multiselect.gui, blockoverride
		### "tnt_multi_domain"), on purpose: one line, one wording, one pair of
		### flags, whether the player is reading the deal or editing it.
		###
		### `visible` is set DIRECTLY on the instance rather than through a block,
		### because tnt_multi_domain_line has no visibility block of its own - inside
		### the panel each line is wrapped in something already gated. The gate used
		### here is author:multiselect's own tnt_domain_shown_value, "titles are
		### actually moving", which is the SAME test their panel wraps its two copies
		### in - so the centre column and the panel appear and disappear together
		### instead of on two similar-but-different conditions. Setting a plain
		### property on a type instance is what every other instance in this mod
		### does, and `visible` is neither a position nor an anchor, so R4 is not in
		### play.
		###
		### NOT tnt_domain_over_value, which is the flag 30-V2-DESIGN section 4.4
		### names for this card and which author:multiselect offers as a one-line
		### alternative. That flag says only "somebody WILL be over" - it is a
		### warning, not a readout, and the task list asks for the numbers:
		### "resulting-size slash limit, turning red above the limit, as
		### interaction_grant_titles.gui:105 and :125 do". Those two vanilla lines are
		### a Status_Bad background gated on
		### GreaterThan_int32( GetResultingDomainSize, GetActor.GetDomainLimit ) plus a
		### "[resulting]/[limit]" text, and tnt_multi_domain_line is that shape with
		### the comparison done in script instead of the GUI - the red half is
		### tnt_domain_over_p/_r_value, passed below, so the warning is included
		### rather than replaced.
		tnt_multi_domain_line = {
			name = "tnt_domain_after_p"
			visible = "[TntPos('tnt_domain_shown_value')]"

			blockoverride "tnt_multi_domain_label" { text = "tnt_domain_line_p" }
			blockoverride "tnt_multi_domain_over"  { visible = "[TntPos('tnt_domain_over_p_value')]" }
		}

		tnt_multi_domain_line = {
			name = "tnt_domain_after_r"
			visible = "[TntPos('tnt_domain_shown_value')]"

			blockoverride "tnt_multi_domain_label" { text = "tnt_domain_line_r" }
			blockoverride "tnt_multi_domain_over"  { visible = "[TntPos('tnt_domain_over_r_value')]" }
		}

		### The player cannot pay what he just promised.
		tnt_context_line = {
			name = "tnt_context_afford_p"
			blockoverride "tnt_context_visible" { visible = "[GreaterThan_CFixedPoint( TntSV('tnt_gold_shortfall_value'), '(CFixedPoint)0' )]" }
			blockoverride "tnt_context_icon"    { texture = "gfx/interface/icons/character_interactions/icon_gold.dds" }
			blockoverride "tnt_context_text"    { text = "tnt_ctx_afford_p"  default_format = "#N" }
		}

		### The partner cannot pay what he is being asked for.
		tnt_context_line = {
			name = "tnt_context_afford_r"
			blockoverride "tnt_context_visible" { visible = "[GreaterThan_CFixedPoint( TntSV('tnt_partner_gold_shortfall_value'), '(CFixedPoint)0' )]" }
			blockoverride "tnt_context_icon"    { texture = "gfx/interface/icons/character_interactions/icon_gold.dds" }
			blockoverride "tnt_context_text"    { text = "tnt_ctx_afford_r"  default_format = "#N" }
		}

		########################################################
		### THE TWO DOMAIN COUNTERS USED TO STAND HERE, third and fourth in the card.
		### V3 moved them to the TOP of the card - see the long note there. Nothing
		### else about them changed: same type, same two flags, same gate, same loc
		### keys, and `ignoreinvisible = yes` means the move costs no height either way.
		###
		### ITEM 2.1 - the marriage pair, summarised.
		###
		### The two names live in the LOC KEY, not here. A .gui `text =` is one
		### expression and the pair needs two names plus a separator, and Law R14
		### forbids a hard-coded separator string in this file. Loc CAN print
		### variables and script values - proven at
		### GAME\localization\english\activities\survey_activity_l_english.yml:697
		### and coronation_activity_l_english.yml:634 - so tnt_ctx_marriage prints
		### both tnt_spouse_p and tnt_spouse_r itself. One key, one line, zero
		### English in the .gui.
		###
		### The `visible` is the guard: the line only appears once BOTH spouses are
		### chosen, so the loc key never has to print an invalid handle.
		###
		### V3 ITERATION 4. The deal holds a LIST of couples, so this card cannot
		### name two people any more - tnt_ctx_marriage now prints how many
		### marriages are on the table (and the honoured couple, when one is), and
		### the gate is "does the list hold anything", TntAny, which is
		### Not(IsDataModelEmpty(GetList)) and already runs in every picker panel.
		### The old gate tested tnt_spouse_p / _r, which are now a STAGING cursor
		### that tnt_wed_add empties on every commit: this line would have vanished
		### the instant the player actually agreed a couple.
		tnt_context_line = {
			name = "tnt_context_marriage"
			blockoverride "tnt_context_visible" { visible = "[TntAny('tnt_wed_list')]" }
			blockoverride "tnt_context_icon"    { texture = "gfx/interface/icons/character_interactions/icon_marriage.dds" }
			blockoverride "tnt_context_text"    { text = "tnt_ctx_marriage"  default_format = "#high" }
		}

		########################################################
		### ITEM 2.5 - the vassal contract, summarised.
		###
		### Same technique and the same reason: the nine tnt_ob_* variables belong
		### to author:hooks-contracts and their values are levels, not names, so
		### tnt_ctx_contract prints them from loc. Only ONE contract can ever
		### exist in a deal (T11 forbids both sides swearing fealty), which is why
		### the nine variables carry no side suffix and why one summary line is
		### enough for both columns.
		tnt_context_line = {
			name = "tnt_context_contract"
			blockoverride "tnt_context_visible" { visible = "[Or( TntOn('tnt_vassal_p'), TntOn('tnt_vassal_r') )]" }
			blockoverride "tnt_context_icon"    { texture = "gfx/interface/icons/character_interactions/icon_vassal.dds" }
			blockoverride "tnt_context_text"    { text = "tnt_ctx_contract"  default_format = "#high" }
		}

		### The neutral state: how many terms are on the table.
		tnt_context_line = {
			name = "tnt_context_terms"
			blockoverride "tnt_context_visible" { visible = "[GreaterThan_CFixedPoint( TntSV('tnt_items_count_value'), '(CFixedPoint)0' )]" }
			blockoverride "tnt_context_icon"    { texture = "gfx/interface/icons/character_interactions/scroll_scales.dds" }
			blockoverride "tnt_context_text"    { text = "tnt_ctx_terms"  default_format = "#weak" }
		}

		### Still free. Build 2's four new lines are inline above, because none of
		### them is instance-specific and the card is instantiated exactly once.
		block "tnt_context_extra" {}
	}


	####################################################################
	####################################################################
	### RETIRED - THE PRISONER PANEL ROW (defect D3's redesign).  USER ITEM 7.
	###
	### This type existed only to draw one captive inside the two read-only dungeon
	### panels at overlay index 8, and both of those panels are retired with the
	### prisoner terms (gui\tnt_diplomacy_window.gui). It has no other consumer, so
	### it is commented out rather than left as dead-but-live code.
	###
	### KEPT READABLE ON PURPOSE: a revival that leans on the vanilla prisoner system
	### - which is what the FAMILY B tombstone says a revival must do - still needs a
	### row shape for a captive, and this one was already through the D3 composition
	### fix. Nothing is deleted; do not re-enable one half.
	### Full tombstone: common\scripted_effects\tnt_32_apply.txt.
	####################################################################
#	### 4. PRISONER PANEL ROW   (defect D3's redesign)
#	###
#	### v1 hung the prisoner list off a `tooltipwidget` inside a
#	### `blockoverride`, and the container it used had a vbox as a direct child -
#	### that is defect D3, "A (flow)container can't have an hbox/vbox as a direct
#	### child", logged at tnt_diplomacy_window.gui:272 and :515.
#	### 50-RUNTIME-LOG-FINDINGS:71 and 30-V2-DESIGN section 1 row 3.3 both say the
#	### item should become a NORMAL panel like every other pickable item, so the
#	### list now lives in a tnt_picker_panel at picker index 8 and this is its row.
#	###
#	### The datamodel is the ENGINE's own: `datamodel = "[Character.GetPrisoners]"`
#	### yields Character-scoped items directly, with no Scope.Char unwrap - verbatim
#	### vanilla at GAME\gui\window_ledger.gui:6098-6106, where the item body reads
#	### the ambient Character. The panel supplies the jailer as its datacontext.
#	###
#	### Read-only on purpose: releasing SOME prisoners needs the wave-3c
#	### multi-select machinery (a tnt_sel_prisoner_p/_r list); the term itself
#	### stays the shipped all-or-nothing toggle, whose scripted gui already exists.
#	####################################################################
#	type tnt_prisoner_row = hbox
#	{
#		name = "tnt_prisoner_row"
#		layoutpolicy_horizontal = expanding
#		size = { 0 42 }
#		maximumsize = { -1 42 }
#		spacing = 8
#		margin = { 8 0 }
#		alwaystransparent = yes
#
#		background = {
#			using = Background_Area_Dark
#		}
#
#		widget = {
#			name = "tnt_prisoner_portrait_holder"
#			size = { 38 100% }
#			alwaystransparent = yes
#
#			portrait_head_tiny = {
#				name = "tnt_prisoner_portrait"
#				size = { 36 36 }
#				parentanchor = center
#			}
#		}
#
#		### The two texts sit inside a vbox between two `expand = {}`, which is the
#		### R-LAYOUT way to centre on the cross axis when the row is much taller
#		### than the text (here 42 vs 20). A vbox as a child of an hbox is legal -
#		### only a (flow)container rejects hbox/vbox children (defect D3) - and an
#		### hbox nested back inside that vbox is legal for the same reason.
#		###
#		### Both expands carry an explicit unique name: `type expand` hard-codes
#		### `name = "expander"` (GAME\gui\shared\windows.gui:598), and two
#		### same-named direct siblings make the engine log a duplicate-child line
#		### naming this file - which the acceptance bar forbids for tnt_ paths.
#		### Same treatment as tnt_row_text in tnt_types.gui.
#		vbox = {
#			name = "tnt_prisoner_text"
#			layoutpolicy_horizontal = expanding
#			layoutpolicy_vertical = expanding
#			alwaystransparent = yes
#
#			expand = {
#				name = "tnt_prisoner_text_pad_top"
#			}
#
#			hbox = {
#				name = "tnt_prisoner_text_row"
#				layoutpolicy_horizontal = expanding
#				spacing = 8
#
#				text_single = {
#					name = "tnt_prisoner_name"
#					layoutpolicy_horizontal = expanding
#					autoresize = no
#					text = "[Character.GetUINameNoTooltip]"
#					align = nobaseline|left
#					default_format = "#high"
#					alwaystransparent = yes
#					fontsize_min = 12
#					using = Font_Size_Medium
#				}
#
#				### Who the prisoner actually is, which is what decides whether
#				### releasing him is worth anything. GetPrimaryTitle.GetNameNoTooltip|U
#				### is verbatim vanilla - GAME\gui\multiplayer_lobby.gui:679,
#				### GAME\gui\window_barbershop.gui:1286. A landless prisoner prints
#				### nothing, which is the correct answer and needs no loc key.
#				### `Character.GetImprisonmentTypeText` was considered and REJECTED:
#				### it does not exist - zero hits in GAME\gui and zero in the engine
#				### string table, only GetImprisonmentWarScore /
#				### GetImprisonmentReasons do.
#				text_single = {
#					name = "tnt_prisoner_title"
#					min_width = 130
#					max_width = 130
#					autoresize = no
#					text = "[Character.GetPrimaryTitle.GetNameNoTooltip|U]"
#					align = nobaseline|right
#					default_format = "#weak"
#					alwaystransparent = yes
#					fontsize_min = 12
#					using = Font_Size_Small
#				}
#			}
#
#			expand = {
#				name = "tnt_prisoner_text_pad_bottom"
#			}
#		}
#	}


	####################################################################
	### 5. THE FIVE BUILD-1 SHELLS - THREE OF THEM ARE NOW LOAD-BEARING.
	###
	### Build 1 wrote these five shapes for the three panels build 2 would need,
	### and recorded them as "defined, never instantiated". Build 2's panels came
	### from three other authors, and TWO OF THOSE AUTHORS BUILT THEIRS OUT OF
	### THESE - so three of the five are now parents or children of shipped,
	### instantiated widgets and MUST NOT be deleted as dead code:
	###
	###   tnt_editor_panel        USED. `type tnt_panel_contract = tnt_editor_panel`
	###                           (gui\tnt_panel_contract.gui). The contract sheet
	###                           at overlay index 12 IS this chrome - its header,
	###                           its Window_Background, its tnt_picker_close.
	###   tnt_level_stepper       USED. The tax and levy rows of that same sheet
	###                           instantiate it, which is exactly the job build 1
	###                           wrote it for ("the shape the tax / levy
	###                           obligation levels and the hook tier both need").
	###   tnt_toggle_line         USED. The seven obligation rights of that sheet
	###                           are seven instances of it.
	###   tnt_multiselect_columns unused. gui\tnt_panel_multiselect.gui builds its
	###                           own two-column body. Kept as the drop-in body if
	###                           tnt_panel_multi ever has to be rebuilt here: its
	###                           blocks tnt_multiselect_available_list /
	###                           _chosen_list take exactly the two datamodels the
	###                           contract names.
	###   tnt_pair_slot           unused. gui\tnt_panel_marriage.gui ships its own
	###                           tnt_marriage_pair_slot, deliberately - that file
	###                           refuses to derive from this one because
	###                           "tnt_panels.gui" sorts AFTER
	###                           "tnt_panel_marriage.gui" and it did not want to
	###                           rest on the loader resolving a parent type from a
	###                           later file. Note that tnt_panel_contract DOES
	###                           take that risk and it is worth watching in the
	###                           first launch: "tnt_panels.gui" >
	###                           "tnt_panel_contract.gui" for the same reason
	###                           ('_' sorts before 's'), so if the engine cannot
	###                           resolve tnt_editor_panel as a parent, the
	###                           contract sheet is the symptom.
	###
	### Note the ONE identifier they may already use: tnt_picker_close, the
	### shipped scripted gui that clears tnt_picker / tnt_picker_side.
	####################################################################

	### A wider panel than tnt_picker_panel (540x640), because a marriage pair
	### editor and a 9-row contract sheet both need two columns.
	### Chrome copied from tnt_picker_panel, including the reason it does NOT use
	### Window_Decoration_Spike: that template injects icon CHILDREN, which a vbox
	### would lay out in its flow. Window_Background contributes only a
	### background = { } block, which is not a flow child - proven at
	### GAME\gui\activity_window_widgets\funeral_deceased_selection_widget.gui:85-90.
	type tnt_editor_panel = vbox
	{
		name = "tnt_editor_panel"
		parentanchor = center
		### V4 item 4: height follows content, 700 becomes the ceiling. Same fix as
		### tnt_picker_panel and tnt_panel_multi; the body block's own scrollbox carries
		### the cap, so a nine-row contract sheet no longer opens a 700 px window.
		size = { 760 0 }
		maximumsize = { 760 700 }
		alwaystransparent = no

		using = Window_Background

		vbox = {
			using = Window_Margins
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			spacing = 6

			header_pattern = {
				layoutpolicy_horizontal = expanding

				blockoverride "header_text"
				{
					block "tnt_editor_panel_title"
					{
						text = "tnt_window_title"
					}
				}

				blockoverride "button_close_tooltip"
				{
					tooltip = "tnt_btn_close"
				}

				blockoverride "button_close"
				{
					onclick = "[TntExec('tnt_picker_close')]"
				}
			}

			block "tnt_editor_panel_body"
			{
				spacer = {}
			}
		}
	}


	### Two side-by-side lists: "available" on the left, "chosen" on the right.
	### This is the whole of item 2.2's mechanism - a row click MOVES the object
	### between two script variable lists, so no membership datafunction is ever
	### needed. Both halves are plain vboxes the consumer fills with a datamodel.
	type tnt_multiselect_columns = hbox
	{
		name = "tnt_multiselect_columns"
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = expanding
		spacing = 10

		vbox = {
			name = "tnt_multiselect_available"
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			spacing = 4

			text_single = {
				name = "tnt_multiselect_available_head"
				layoutpolicy_horizontal = expanding
				autoresize = no
				align = nobaseline|left
				default_format = "#high"
				alwaystransparent = yes
				fontsize_min = 12
				using = Font_Size_Medium

				block "tnt_multiselect_available_label"
				{
					text = "tnt_picker_available"
				}
			}

			divider_light = {
				layoutpolicy_horizontal = expanding
			}

			block "tnt_multiselect_available_list"
			{
				spacer = {}
			}
		}

		vbox = {
			name = "tnt_multiselect_chosen"
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			spacing = 4

			text_single = {
				name = "tnt_multiselect_chosen_head"
				layoutpolicy_horizontal = expanding
				autoresize = no
				align = nobaseline|left
				default_format = "#high"
				alwaystransparent = yes
				fontsize_min = 12
				using = Font_Size_Medium

				block "tnt_multiselect_chosen_label"
				{
					text = "tnt_picker_chosen"
				}
			}

			divider_light = {
				layoutpolicy_horizontal = expanding
			}

			block "tnt_multiselect_chosen_list"
			{
				spacer = {}
			}
		}
	}


	### One labelled checkbox line: the shape the nine-row vassal contract sheet
	### (item 2.5) and the matrilineal switch (item 2.1) both need.
	### R-LAYOUT: the checkbox lives inside a plain widget so it may centre.
	###
	### TWO TOOLTIP BLOCKS, ON PURPOSE - added in build 3, and read this before
	### "simplifying" them into one.
	###   block "tnt_toggle_line_tooltip"     is on THIS hbox. It is what the player
	###     sees when the cursor is over the row's label, which is where the eye
	###     goes. The label text_single is alwaystransparent = yes, so its hover
	###     falls through to here.
	###   block "tnt_toggle_line_box_tooltip" is on the button_checkbox, BESIDE
	###     block "tnt_toggle_line_enabled". A checkbox is NOT transparent, so it
	###     eats its own hover; with the tooltip only on the parent, hovering the
	###     one widget that greys out produced no tooltip at all. `enabled` and the
	###     explanation of why a control is unavailable must sit on the SAME widget
	###     (GAME\gui\window_faith.gui:900-902), which is also the shape this mod
	###     already uses correctly in type tnt_item_row_toggle (tnt_types.gui:310,
	###     :312, both children of one button_checkbox).
	### The innermost non-transparent widget under the cursor wins, so the two never
	### fight: over the box you get the box's, anywhere else on the row you get the
	### row's. Both default to empty, so an existing consumer that sets only the
	### first keeps working exactly as before.
	type tnt_toggle_line = hbox
	{
		name = "tnt_toggle_line"
		layoutpolicy_horizontal = expanding
		### TIER 3 of the height convention (file header): a one-line labelled
		### control row stays FIXED and its label elides. Long RU term names may
		### elide here - accepted; the full name lives in the tooltip.
		size = { 0 34 }
		maximumsize = { -1 34 }
		spacing = 6
		margin = { 6 0 }
		alwaystransparent = no
		ignoreinvisible = yes

		using = tooltip_es

		block "tnt_toggle_line_visible" {}

		block "tnt_toggle_line_tooltip" {}

		### V3 ADDITION 4 - AN OPTIONAL LEADING ICON, empty by default.
		### The two mutual pact lines in the centre column (alliance, non-aggression)
		### need the same icon the columns' rows carry, or a term that moved out of a
		### column would arrive in the centre unrecognisable. Every existing consumer
		### - the seven obligation rights of gui\tnt_panel_contract.gui - leaves it
		### unwritten, and an unwritten block contributes no child at all, so their
		### geometry is bit-for-bit what it was.
		### V13 USER ITEM 1: THE TWO PACT LINES ARE RETIRED and the block's only
		### fillers are commented out with them, so it is once again empty at every
		### live call site. THE BLOCK STAYS DECLARED - the reasoning above is why it
		### was added and the type's sibling tnt_action_line uses the same shape for
		### the marriage line that survives in that centre section.
		### R4: whatever lands here is a direct child of THIS hbox, so it must not
		### carry `position` or `parentanchor` itself. The filler passes a plain
		### `widget` and anchors the icon INSIDE it, which is the mechanism
		### tnt_item_frame's own icon holder uses (tnt_types.gui, "tnt_row_icon_holder").
		block "tnt_toggle_line_icon" {}

		text_single = {
			name = "tnt_toggle_line_text"
			layoutpolicy_horizontal = expanding
			autoresize = no
			align = nobaseline|left
			default_format = "#medium"
			alwaystransparent = yes
			fontsize_min = 12
			using = Font_Size_Medium

			block "tnt_toggle_line_label"
			{
				text = "tnt_item_vassal"
			}
		}

		widget = {
			name = "tnt_toggle_line_box_holder"
			size = { 40 100% }

			button_checkbox = {
				name = "tnt_toggle_line_box"
				parentanchor = center

				using = tooltip_es

				block "tnt_toggle_line_sgui" {}

				block "tnt_toggle_line_var" {}

				block "tnt_toggle_line_enabled" {}

				### Co-located with the block above. See the type header.
				block "tnt_toggle_line_box_tooltip" {}
			}
		}
	}


	####################################################################
	### V4 FIX 3 - AN ACTION LINE. The same 34 px line as tnt_toggle_line above,
	### except the control on it is a BUTTON and not a checkbox.
	###
	### WHY IT EXISTS. Marriage is not a flag the player raises, it is a SCREEN he
	### opens: vanilla's matchmaker does the picking and what comes back is a list
	### of couples. A checkbox said the wrong thing twice - it looked like a term
	### that could be ticked off, and its `checked` state was only a read-only echo
	### of whether the list happened to be non-empty, so clicking a TICKED box
	### opened the screen again rather than removing anything. The user asked for a
	### proper button; this is that button, in the same geometry so the centre
	### column's rows still line up.
	###
	### THE MOUSE LESSON IS OBEYED HERE - _docs\README.md item 4, and it cost a
	### day. The button is the ONLY non-transparent widget on this line: the icon
	### holder and the icon carry alwaystransparent = yes, and there is NO label
	### text_single at all. The button itself is the expanding child and holds the
	### wording, so there is nothing that could come to lie on top of it.
	###
	### The hbox is alwaystransparent = no, like tnt_level_stepper above, which is
	### the type in this file already proven to deliver clicks to its buttons.
	####################################################################
	type tnt_action_line = hbox
	{
		name = "tnt_action_line"
		layoutpolicy_horizontal = expanding
		size = { 0 34 }
		maximumsize = { -1 34 }
		spacing = 6
		margin = { 4 4 }
		alwaystransparent = no

		block "tnt_action_line_visible" {}

		### R-LAYOUT: whatever lands here is a direct child of this hbox, so it
		### passes a plain `widget` and anchors the icon INSIDE it - same contract
		### as block "tnt_toggle_line_icon".
		block "tnt_action_line_icon" {}

		button_standard = {
			name = "tnt_action_line_button"
			layoutpolicy_horizontal = expanding
			size = { 0 26 }
			using = tooltip_es

			block "tnt_action_line_text"    { text = "tnt_btn_stage_marriage" }
			block "tnt_action_line_tooltip" { tooltip = "tnt_btn_stage_marriage_full" }
			block "tnt_action_line_click"   {}
		}
	}


	### A 0..N level stepper with a NAMED level rather than a number: the shape
	### the tax / levy obligation levels (item 2.5) and the hook tier (item 2.3)
	### both need. R12: left click steps by one, right click jumps to the end,
	### and `button_ignore = none` is mandatory or onrightclick never fires
	### (vanilla's own stepper, GAME\gui\window_knights.gui:716-759).
	### R-LAYOUT: neither button_round carries parentanchor - the hbox's height is
	### its tallest child, so there is nothing to centre against.
	type tnt_level_stepper = hbox
	{
		name = "tnt_level_stepper"
		spacing = 4
		alwaystransparent = no

		button_round = {
			name = "tnt_level_minus_button"
			size = { 26 26 }
			button_ignore = none
			using = tooltip_es
			tooltip_offset = { 0 26 }

			block "tnt_level_minus" {}

			block "tnt_level_minus_big" {}

			block "tnt_level_tt_minus" {}

			button_minus_small = {
				name = "tnt_level_dec"
				parentanchor = center
				alwaystransparent = yes
			}
		}

		text_single = {
			name = "tnt_level_text"
			min_width = 118
			max_width = 118
			autoresize = no
			align = nobaseline|center
			default_format = "#high"
			alwaystransparent = yes
			fontsize_min = 12
			using = Font_Size_Small

			block "tnt_level_label" {}
		}

		button_round = {
			name = "tnt_level_plus_button"
			size = { 26 26 }
			button_ignore = none
			using = tooltip_es
			tooltip_offset = { 0 26 }

			block "tnt_level_plus" {}

			block "tnt_level_plus_big" {}

			block "tnt_level_tt_plus" {}

			button_plus_small = {
				name = "tnt_level_inc"
				parentanchor = center
				alwaystransparent = yes
			}
		}
	}


	### One half of the marriage pair editor: a big portrait over a name, the
	### whole thing clickable to open that side's spouse list.
	type tnt_pair_slot = widget
	{
		name = "tnt_pair_slot"
		size = { 180 190 }
		alwaystransparent = no

		using = tooltip_es

		block "tnt_pair_slot_context" {}

		block "tnt_pair_slot_click" {}

		block "tnt_pair_slot_tooltip" {}

		vbox = {
			size = { 100% 100% }
			spacing = 6
			alwaystransparent = yes

			widget = {
				name = "tnt_pair_portrait_holder"
				layoutpolicy_horizontal = expanding
				size = { 0 130 }
				alwaystransparent = yes

				portrait_head_small = {
					name = "tnt_pair_portrait"
					parentanchor = center
				}
			}

			text_single = {
				name = "tnt_pair_name"
				layoutpolicy_horizontal = expanding
				autoresize = no
				align = nobaseline|center
				default_format = "#high"
				alwaystransparent = yes
				fontsize_min = 12
				using = Font_Size_Medium

				block "tnt_pair_slot_name" {}
			}

			text_single = {
				name = "tnt_pair_sub"
				layoutpolicy_horizontal = expanding
				autoresize = no
				align = nobaseline|center
				default_format = "#weak"
				alwaystransparent = yes
				fontsize_min = 12
				using = Font_Size_Small

				block "tnt_pair_slot_sub" {}
			}
		}
	}

}
