			blockoverride "tnt_sheet_detail"  { text = "[TntNum('tnt_piety_r')|0]" }
			blockoverride "tnt_sheet_points"  { text = "[TntSV('tnt_val_piety_r_value')|0]" }
			blockoverride "tnt_sheet_remove"
