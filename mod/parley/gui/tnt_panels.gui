			blockoverride "tnt_sheet_name"    { text = "tnt_item_influence" }
			blockoverride "tnt_sheet_detail"  { text = "[TntNum('tnt_influence_r')|0]" }
			blockoverride "tnt_sheet_points"  { text = "[TntSV('tnt_val_influence_r_value')|0]" }
