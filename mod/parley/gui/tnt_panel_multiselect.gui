	type tnt_sheet_sel_artifact_p = vbox
	{
		name = "tnt_sheet_sel_artifact_p"
		layoutpolicy_horizontal = expanding
		spacing = 2
		ignoreinvisible = yes

		tnt_multi_sheet_row = {
			name = "tnt_sheet_sel_artifact_p_head"
			### V6 (user item 7): opaque head, X below - see the type's note.
			alwaystransparent = no
			blockoverride "tnt_multi_sheet_visible" { visible = "[TntPos('tnt_count_sel_artifact_p_value')]" }
			blockoverride "tnt_multi_sheet_icon"    { texture = "gfx/interface/icons/character_interactions/artifact.dds" }
			blockoverride "tnt_multi_sheet_name"    { text = "tnt_item_artifact" }
			blockoverride "tnt_multi_sheet_detail"  { text = "tnt_sel_count_artifact_p" }
			blockoverride "tnt_multi_sheet_points"  { text = "[TntSV('tnt_shown_artifact_multi_p_value')|0]" }
			### Gate-free whole-group clear (tnt_22b_multiselect.txt:634).
			blockoverride "tnt_multi_sheet_remove"
			{
				button_cancel_small = {
					size = { 20 20 }
					parentanchor = center
					tooltip = "tnt_sheet_remove_tip"
					onclick = "[TntExec('tnt_sel_artifact_p_clear')]"
				}
			}
		}

		vbox = {
			name = "tnt_sheet_sel_artifact_p_rows"
			layoutpolicy_horizontal = expanding
			spacing = 2
			datamodel = "[TntList('tnt_sel_artifact_p')]"

			item = {
				tnt_multi_sheet_row = {
					name = "tnt_sheet_sel_artifact_p_row"
					datacontext = "[Scope.Artifact]"
					size = { 0 26 }

					### User item 2: linked name + hoverable row - full note on
					### tnt_sheet_sel_title_p_row. The artifact form's own call site:
					### [Artifact.GetName] at GAME\gui\interaction_confirmation.gui:110.
					alwaystransparent = no

					blockoverride "tnt_multi_sheet_visible" { visible = yes }
					blockoverride "tnt_multi_sheet_icon"    { texture = "gfx/interface/icons/character_interactions/artifact.dds" }
					blockoverride "tnt_multi_sheet_name"    { text = "" }
					blockoverride "tnt_multi_sheet_detail"  { text = "[Artifact.GetName]"  alwaystransparent = no }
				}
			}
		}
	}

