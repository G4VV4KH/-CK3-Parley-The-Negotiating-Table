	####################################################################
	### 6. THE DEAL-SHEET GROUPS   (user item 3.4, "in the centre, in full")
	###
	### tnt_panels.gui's tnt_deal_sheet reserves two blocks for exactly
	### this - `block "tnt_sheet_multi_p"` at :539 and
	### `block "tnt_sheet_multi_r"` at :693, both commented "BUILD 2: the
	### three multi-select datamodels ... go here". The gui owner fills them
	### with three lines each:
	###     blockoverride "tnt_sheet_multi_p"
	###     {
	###         tnt_sheet_sel_title_p = {}
	###         tnt_sheet_sel_claim_p = {}      <- RETIRED, V13 user item 1
	###         tnt_sheet_sel_artifact_p = {}
	###     }
	### TWO LINES EACH SINCE V13 USER ITEM 1: the claim group is commented out
	### below and so is its instantiation in gui\tnt_panels.gui. A design refusal,
	### not a bug fix - vanilla gates claim fabrication behind a LEARNING
	### investment. See the tombstone on the two retired types.
	###
	### GEOMETRY IS COPIED FROM tnt_sheet_row (tnt_panels.gui) TO THE
	### PIXEL: 26 px high, spacing 6, margin { 4 3 }, name column 118 px,
	### a 24 px remove cell (V6, user item 7 - the same cell tnt_sheet_row
	### grew in V5), points column 52 px, the middle column the only
	### expanding one. The two row families are siblings in one scrollbox
	### and must line up.
	###
	### WHY A GROUP HEAD PLUS A DATAMODEL, AND NOT ONE ROW PER OBJECT WITH
	### ITS OWN POINTS. A script value sees ROOT ONLY
	### (GetScriptValueBreakdown supplies root, 00-ARCHITECTURE section 2.7,
	### and Law R9), so there is no way to ask "what is THIS row's title
	### worth" - the value would need the row object as a scope. The head
	### therefore prints the GROUP's points, which is the number that
	### actually enters the balance (tnt_val_title_multi_p_value), and the
	### per-object rows below it print names only. Nothing can disagree with
	### anything, which is the property item 1.2 is about.
	###
	### The head is hidden when the list is empty (one script value per
	### group), and the datamodel below it renders nothing when the list is
	### empty, so an unused group costs one map lookup and no pixels -
	### tnt_deal_sheet carries `ignoreinvisible = yes`.
	####################################################################
	type tnt_multi_sheet_row = hbox
	{
		name = "tnt_multi_sheet_row"
		layoutpolicy_horizontal = expanding
		size = { 0 26 }
		maximumsize = { -1 26 }
		spacing = 6
		margin = { 4 3 }
		### Default for the name-only per-object rows, which are pure
		### read-outs. The six group HEAD instances override this to `no`
		### because they carry the remove X below, and an alwaystransparent
		### ANCESTOR makes its whole subtree click-through (the doctrine
		### tnt_sheet_row cites at tnt_panels.gui, V5 note).
		alwaystransparent = yes
		ignoreinvisible = yes

		block "tnt_multi_sheet_visible"
		{
			visible = no
		}

		widget = {
			name = "tnt_multi_sheet_icon_holder"
			size = { 20 100% }
			alwaystransparent = yes

			icon = {
				name = "tnt_multi_sheet_icon"
				size = { 18 18 }
				parentanchor = center
				alwaystransparent = yes

				block "tnt_multi_sheet_icon"
				{
					texture = "gfx/interface/icons/character_interactions/icon_transfer_county.dds"
				}
			}
		}

		text_single = {
			name = "tnt_multi_sheet_name"
			min_width = 118
			max_width = 118
			autoresize = no
			align = nobaseline|left
			default_format = "#medium"
			alwaystransparent = yes
			fontsize_min = 12
			using = Font_Size_Small

			block "tnt_multi_sheet_name"
			{
				text = "tnt_item_title"
			}
		}

		### The only expanding child, so it is overridden with `text = ""`
		### and NEVER with `visible = no` - hiding it would collapse the
		### slack and pull the points column ~200 px left, the failure mode
		### tnt_panels.gui:325-334 documents. An empty string is
		### vanilla-proven (GAME\gui\interaction_templates.gui:1321).
		### THIS is the widget that prints GAME text, so R-SPILL applies in
		### full: autoresize = no, elide inherited, fontsize_min 12.
		text_single = {
			name = "tnt_multi_sheet_detail"
			layoutpolicy_horizontal = expanding
			autoresize = no
			align = nobaseline|left
			default_format = "#weak"
			alwaystransparent = yes
			fontsize_min = 12
			using = Font_Size_Small

			block "tnt_multi_sheet_detail"
			{
				text = ""
			}
		}

		### V6 (user item 7) - THE REMOVE SLOT: the same 24 px cell
		### tnt_sheet_row grew in V5 (tnt_panels.gui), in the same place -
		### BETWEEN detail and points. The cell is paid for by the expanding
		### detail column and points stays the LAST child of BOTH families,
		### so the to-the-pixel alignment promise in this type's header
		### survives. Empty by default; only the six group HEAD instances
		### fill it, wired to their gate-free tnt_sel_<item>_<side>_clear
		### (tnt_22b_multiselect.txt) - a per-object X would need a
		### per-object sgui that does not exist. Deliberately NOT
		### alwaystransparent: a transparent ancestor kills the X's click.
		widget = {
			name = "tnt_multi_sheet_x_holder"
			size = { 24 100% }

			block "tnt_multi_sheet_remove" {}
		}

		text_single = {
			name = "tnt_multi_sheet_points"
			min_width = 52
			max_width = 52
			align = nobaseline|right
			default_format = "#high"
			alwaystransparent = yes
			fontsize_min = 12
			using = Font_Size_Small

			block "tnt_multi_sheet_points"
			{
				text = ""
			}
		}
	}


	### One group = a head row carrying the count and the group's points,
	### then one name-only row per chosen object.
	### The datamodel vbox is a plain child, not a block: these six types
	### are the finished article and the gui owner only instantiates them.
	type tnt_sheet_sel_title_p = vbox
	{
		name = "tnt_sheet_sel_title_p"
		layoutpolicy_horizontal = expanding
		spacing = 2
		ignoreinvisible = yes

		tnt_multi_sheet_row = {
			name = "tnt_sheet_sel_title_p_head"
			### V6 (user item 7): the head carries the X, so it must be opaque
			### to the hit test - see the type's alwaystransparent note.
			alwaystransparent = no
			blockoverride "tnt_multi_sheet_visible" { visible = "[TntPos('tnt_count_sel_title_p_value')]" }
			blockoverride "tnt_multi_sheet_icon"    { texture = "gfx/interface/icons/character_interactions/icon_transfer_county.dds" }
			blockoverride "tnt_multi_sheet_name"    { text = "tnt_item_title" }
			blockoverride "tnt_multi_sheet_detail"  { text = "tnt_sel_count_title_p" }
			blockoverride "tnt_multi_sheet_points"  { text = "[TntSV('tnt_shown_title_multi_p_value')|0]" }
			### Gate-free whole-group clear (tnt_22b_multiselect.txt:580).
			blockoverride "tnt_multi_sheet_remove"
			{
				button_cancel_small = {
					size = { 20 20 }
					parentanchor = center
					tooltip = "tnt_sheet_remove_tip"
					onclick = "[TntExec('tnt_sel_title_p_clear')]"
				}
			}
		}

		vbox = {
			name = "tnt_sheet_sel_title_p_rows"
			layoutpolicy_horizontal = expanding
			spacing = 2
			datamodel = "[TntList('tnt_sel_title_p')]"

			item = {
				tnt_multi_sheet_row = {
					name = "tnt_sheet_sel_title_p_row"
					datacontext = "[Scope.Title]"
					size = { 0 26 }

					### USER ITEM 2 - THE NAME IS A LIVE LINK. Title.GetName is the
					### tooltipped twin of the GetNameNoTooltip this cell shipped
					### with: the full form hangs the title's own hover tooltip on
					### the name, and its call sites in ordinary text widgets are
					### GAME\gui\window_epidemics.gui:553 ([Title.GetName] on a
					### hoverable text_single) and GAME\gui\window_migration.gui:1656
					### (the |U form). Two flips make the hover actually LAND: the
					### row drops the type's default alwaystransparent = yes (a
					### transparent ANCESTOR is hover-through - this mod's doctrine),
					### and the detail cell does the same inside its override. Safe
					### on a per-object row precisely because it hosts no control -
					### its X holder is empty - so there is no click for the hover to
					### steal. The PICKER rows deliberately keep NoTooltip: each sits
					### on a button_standard_list that owns both the click and a
					### row-level tooltipwidget, and a second tooltip inside it would
					### fight the row's own. The five sibling groups below carry the
					### same two flips and point here.
					alwaystransparent = no

					blockoverride "tnt_multi_sheet_visible" { visible = yes }
					blockoverride "tnt_multi_sheet_icon"    { texture = "gfx/interface/icons/character_interactions/icon_transfer_county.dds" }
					blockoverride "tnt_multi_sheet_name"    { text = "" }
					blockoverride "tnt_multi_sheet_detail"  { text = "[Title.GetName|U]"  alwaystransparent = no }
				}
			}
		}
	}

	type tnt_sheet_sel_title_r = vbox
	{
		name = "tnt_sheet_sel_title_r"
