	### 10 / side 0 - artifacts the PLAYER gives.
	type tnt_panel_multi_artifact_p = tnt_panel_multi
	{
		name = "tnt_panel_multi_artifact_p"
		visible = "[And( EqualTo_CFixedPoint( TntNum('tnt_picker'), '(CFixedPoint)10' ), EqualTo_CFixedPoint( TntNum('tnt_picker_side'), '(CFixedPoint)0' ) )]"

		blockoverride "tnt_multi_title" { text = "tnt_picker_title_artifact" }
		blockoverride "tnt_multi_counter" { text = "tnt_sel_count_artifact_p" }
		blockoverride "tnt_multi_points_value" { text = "[TntSV('tnt_shown_artifact_multi_p_value')|+=0]" }
		blockoverride "tnt_multi_clear_click" { onclick = "[TntExec('tnt_sel_artifact_p_clear')]"  tooltip = "tnt_btn_none" }

		blockoverride "tnt_multi_available_empty"
		{
			text = "tnt_picker_empty_artifact"
			visible = "[IsDataModelEmpty( TntList('tnt_list_artifact_p') )]"
		}
		blockoverride "tnt_multi_chosen_empty"
		{
			text = "tnt_picker_chosen_empty"
			visible = "[IsDataModelEmpty( TntList('tnt_sel_artifact_p') )]"
		}

		blockoverride "tnt_multi_available_list"
		{
			vbox = {
				name = "tnt_multi_rows_avail_artifact_p"
				layoutpolicy_horizontal = expanding
				spacing = 3
				datamodel = "[TntList('tnt_list_artifact_p')]"

				item = {
					tnt_multi_row_artifact = {
						name = "tnt_multi_avail_artifact_p_row"
						datacontext = "[Scope.Artifact]"
						size = { 0 45 }

						blockoverride "tnt_multi_row_click" { onclick = "[TntPickArtifact('tnt_sel_artifact_p_add')]" }
					}
				}
			}
		}

		blockoverride "tnt_multi_chosen_list"
		{
			vbox = {
				name = "tnt_multi_rows_chosen_artifact_p"
				layoutpolicy_horizontal = expanding
				spacing = 3
				datamodel = "[TntList('tnt_sel_artifact_p')]"

				item = {
					tnt_multi_row_artifact = {
						name = "tnt_multi_chosen_artifact_p_row"
						datacontext = "[Scope.Artifact]"
						size = { 0 45 }

						blockoverride "tnt_multi_row_click" { onclick = "[TntPickArtifact('tnt_sel_artifact_p_remove')]" }
						blockoverride "tnt_multi_row_glyph"
						{
							button_minus_small = {
								name = "tnt_multi_row_glyph_icon"
								parentanchor = center
								alwaystransparent = yes
							}
						}
					}
				}
			}
		}
	}


